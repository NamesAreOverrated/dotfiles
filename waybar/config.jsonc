{
  "layer": "top",
  "position": "top",
  "height": 20,
  "spacing": 6,
  "margin-top": 4,
  "margin-left": 8,
  "margin-right": 8,
  "modules-left": ["sway/workspaces",  "mpris", "custom/lyric"],
  "modules-center": ["privacy"],
  "modules-right": [ "tray", "group/resources" ,  "group/audio","bluetooth", "network",  "clock", "group/power-actions"],
  "mpris": {
    "format": "󰎈  {dynamic}",
    "format-paused": "󰏤  {dynamic}",
    "tooltip-format": "󰎈  {title}\n󰻋  {artist}\n󰉊  {album}\n⏱  {position}/{length}\n  {player}",
    "dynamic-order": ["title", "artist", "position", "length"],
    "interval": 1
  },
  "custom/lyric": {
    "interval":2,
    "exec": "printf '%s' '{\"cmd\":\"query\",\"args\":{\"operation\":\"lyric\"}}' | socat - UNIX-CONNECT:$XDG_RUNTIME_DIR/ncm-socket | jq -r .line",
    "format": "󰍰 {text}",
    // "min-length": 160,
    // "max-length": 200,
  },
  // "niri/workspaces": {
  //   "format": "{icon}",
  //   "on-click": "activate",
  //   "format-icons": {
  //           "active": "󰮯",
  //           "persistent": "",
  //           "empty": "󰊠",
  //           "urgent": "󰵙",
  //           "default": ""
  //   },
  // },
"sway/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "format-icons": {
            "focused": "󰮯",
            "persistent": "",
            "empty": "󰊠",
            "urgent": "󰵙",
            "default": ""
    },
  },

  "tray": {
    "icon-size": 14,
    "spacing": 8,
    "show-passive-items": true
  },
  "network": {
    "format-wifi": "󰖩  {essid} {bandwidthTotalBytes}",
    "format-ethernet": "󰌘  {ifname} {bandwidthTotalBytes}",
    "format-disconnected": "  offline",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)  {ipaddr}\n{ifname}",
    "tooltip-format-ethernet": "{ipaddr}  {ifname}",
    "on-click": "~/.local/bin/cm-network",
    "on-click-right":"~/.local/bin/cm-network",
    "interval": 5
  },
  "bluetooth": {
	"format": "  {status}",
  "format-no-controller":"󰂲",
  "format-off":"󰂲  {status}",
	"format-connected": "  {device_alias}",
	"on-click": "~/.local/bin/cm-bluetooth",
	"on-click-right": "~/.local/bin/cm-bluetooth",
	"format-connected-battery": "  {device_alias} {device_battery_percentage}%",
	"tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
	"tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
	"tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
	"tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%"
},
  "group/resources": {
    "orientation": "horizontal",
    "modules": [
      "custom/containers",
      "disk",
      "memory",
      "cpu"
    ]
  },
  "disk": {
    "format": "󰋊  {percentage_used}%",
    "path": "/",
    "interval": 30,
    "tooltip-format": "{used} / {total} ({percentage_used}%)"
  },
  "cpu": {
    "format": "  {usage}%",
    "interval": 5,
  },
  "memory": {
    "format": "  {percentage}%",
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G ({percentage}%)",
    "interval": 10
  },
  "clock": {
    "format": "󰥔  {:%H:%M}",
    "format-alt": "󰃭  {:%a %d %b}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#cba6f7'><b>{}</b></span>",
        "days": "<span color='#cdd6f4'>{}</span>",
        "weeks": "<span color='#94e2d5'>W{}</span>",
        "weekdays": "<span color='#fab387'><b>{}</b></span>",
        "today": "<span color='#a6e3a1'><b><u>{}</u></b></span>"
      }
    },
    "interval": 60
  },
  "group/audio": {
    "orientation": "horizontal",
    "modules": [
      "group/volume",
      "pulseaudio#input",
    ]
  },
  "group/volume": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 600,
      "transition-left-to-right": true,
      "reveal-delay": 450
    },
    "modules": [
      "pulseaudio#output",
      "pulseaudio/slider"
    ]
  },
  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "cursor": true,
  },
  "pulseaudio#output": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰸈  {volume}%",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "~/.local/bin/cm-volmixer",
    "scroll-step": 5
  },
  "pulseaudio#input": {
    "format": "{format_source}",
    "format-source": "󰍬",
    "format-source-muted": "󰍭",
    "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
    "on-click-right": "~/.local/bin/cm-volmixer",
  },
  "custom/containers": {
  "format": "  {}",
  "interval": 10,
  "exec": "sh -c 'containers=$( (podman ps --format {{.Names}} 2>/dev/null; docker ps --format {{.Names}} 2>/dev/null) | sed \"/^$/d\" ); count=$(printf \"%s\\n\" \"$containers\" | sed \"/^$/d\" | wc -l | tr -d \" \"); names=$(printf \"%s\\n\" \"$containers\" | sed \"/^$/d\" | paste -sd \", \" -); printf \"%s\\n%s\" \"$count\" \"$names\"'",
  "tooltip": true
  },
  
"group/power-actions": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 500,
      "transition-left-to-right":true,
    },
    "modules": [
      "custom/shutdown",
      "custom/reboot",
      "custom/lock",
    ]
  },
  "custom/lock": {
    "format": "󰌾",
    "on-click": "powerctl lock",
    "tooltip-format": "Lock screen"
  },
  "custom/reboot": {
    "format": "󰑐",
    "on-click": "powerctl reboot",
    "tooltip-format": "Reboot"
  },
  "custom/shutdown": {
    "format": "󰐥",
    "on-click": "powerctl poweroff",
    "tooltip-format": "Shutdown"
  },
  "privacy": {
	"icon-spacing": 4,
	"icon-size": 14,
	"transition-duration": 250,
	"modules": [
		{
			"type": "screenshare",
			"tooltip": true,
			"tooltip-icon-size": 14
		},
		{
			"type": "audio-out",
			"tooltip": true,
			"tooltip-icon-size": 14
		},
		{
			"type": "audio-in",
			"tooltip": true,
			"tooltip-icon-size": 14
		}
	],
	"ignore-monitor": true,
	"ignore": [
		{
			"type": "audio-in",
			"name": "cava"
		},
		{
			"type": "screenshare",
			"name": "obs"
		}
	]
},
}
