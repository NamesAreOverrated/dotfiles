* {
    rosewater: #f5e0dc;
    flamingo: #f2cdcd;
    pink: #f5c2e7;
    mauve: #cba6f7;
    red: #f38ba8;
    maroon: #eba0ac;
    peach: #fab387;
    yellow: #f9e2af;
    green: #a6e3a1;
    teal: #94e2d5;
    sky: #89dceb;
    sapphire: #74c7ec;
    blue: #89b4fa;
    lavender: #b4befe;
    text: #cdd6f4;
    subtext1: #bac2de;
    subtext0: #a6adc8;
    overlay2: #9399b2;
    overlay1: #7f849c;
    overlay0: #6c7086;
    surface2: #585b70;
    surface1: #45475a;
    surface0: #313244;
    base: #1e1e2e;
    mantle: #181825;
    crust: #11111b;

    font: "Iosevka Custom 11";
    background-color: transparent;
    text-color: @text;
}

window {
    background-color: rgba(30, 30, 46, 0.9);
    border: 2px;
    border-color: @surface1;
    border-radius: 12px;
    padding: 8px;
    width: 600;
    location: center;
    anchor: center;
}

mainbox {
    background-color: transparent;
    padding: 0;
    spacing: 0;
    children: [inputbar, listview];
}

inputbar {
    background-color: rgba(24, 24, 37, 0.85);
    border-radius: 8px;
    padding: 12px 16px;
    spacing: 8px;
    margin: 0 0 4px 0;
    children: [prompt, entry, case-indicator];
}

prompt {
    text-color: @blue;
    font: "Iosevka Custom 11";
}

entry {
    text-color: @text;
    font: "Iosevka Custom 11";
    placeholder: "Search...";
    placeholder-color: @overlay0;
    cursor-color: @blue;
    cursor-width: 2px;
}

case-indicator {
    text-color: @surface2;
    font: "Iosevka Custom 10";
}

listview {
    background-color: transparent;
    padding: 4px 0 0 0;
    lines: 10;
    spacing: 2px;
    scrollbar: false;
    dynamic: true;
    cycle: true;
}

element {
    background-color: transparent;
    padding: 10px 12px;
    border-radius: 8px;
    text-color: @text;
}

element normal.normal {
    background-color: transparent;
}

element normal.urgent {
    background-color: @red;
    text-color: @crust;
}

element normal.active {
    background-color: @blue;
    text-color: @crust;
}

element selected.normal {
    background-color: @surface0;
    text-color: @text;
}

element selected.urgent {
    background-color: @red;
    text-color: @crust;
}

element selected.active {
    background-color: @blue;
    text-color: @crust;
}

element alternate.normal {
    background-color: transparent;
}

element-icon {
    size: 1.2em;
    vertical-align: 0.5;
}

element-text {
    background-color: inherit;
    text-color: inherit;
    vertical-align: 0.5;
    highlight: bold;
}


