#!/usr/bin/env bash
set -euo pipefail

# ── Icons (single source of truth) ──
_V="󰕾"; _M="󰝟"; _X="󰅖"; _N="󰍬"; _A="󰘔"; _P="󰏫"; _S="󰓡"; _B="󰑐"

# ── Helpers ──

list_sinks() {
  pactl list sinks 2>/dev/null | awk '
    BEGIN { RS=""; FS="\n" }
    /Sink #[0-9]+/ {
      id=""; desc=""
      for (i=1; i<=NF; i++) {
        if ($i ~ /Sink #[0-9]+/) {
          gsub(/.*#/, "", $i); gsub(/[^0-9].*/, "", $i); id=$i
        }
        if ($i ~ /^[[:space:]]*Description:[[:space:]]/) {
          gsub(/^[[:space:]]*Description:[[:space:]]*/, "", $i); desc=$i
        }
      }
      if (id != "" && desc != "")
        print id " " desc
    }
  '
}

list_sources() {
  pactl list sources 2>/dev/null | awk '
    BEGIN { RS=""; FS="\n" }
    /Source #[0-9]+/ {
      id=""; desc=""
      for (i=1; i<=NF; i++) {
        if ($i ~ /Source #[0-9]+/) {
          gsub(/.*#/, "", $i); gsub(/[^0-9].*/, "", $i); id=$i
        }
        if ($i ~ /^[[:space:]]*Description:[[:space:]]/) {
          gsub(/^[[:space:]]*Description:[[:space:]]*/, "", $i); desc=$i
        }
      }
      if (id != "" && desc != "" && desc !~ /Monitor/)
        print id " " desc
    }
  '
}

pick_sink() {
  local prompt="${1:-Select output}"
  local sinks
  sinks=$(list_sinks)
  [[ -z "$sinks" ]] && { rofi -e "No sinks found"; exit 1; }
  local default_name
  default_name=$(pactl get-default-sink 2>/dev/null)
  local marked
  marked=$(echo "$sinks" | while IFS='' read -r line; do
    local id desc
    id=$(echo "$line" | awk '{print $1}')
    desc=$(echo "$line" | awk '{$1=""; print $0}' | sed 's/^ //')
    if pactl list sinks 2>/dev/null | grep -A20 "^Sink #$id" | grep -q "Name: $default_name"; then
      echo "* $id $desc"
    else
      echo "  $id $desc"
    fi
  done)
  selected=$(echo "$marked" | rofi -dmenu -p "$prompt" -i -format i)
  [[ -z "$selected" ]] && return 1
  echo "$marked" | sed -n "$((selected+1))p" | sed 's/^..//' | awk '{print $1}'
}

pick_source() {
  local prompt="${1:-Select mic}"
  local sources
  sources=$(list_sources)
  [[ -z "$sources" ]] && { rofi -e "No mics found"; exit 1; }
  local default_name
  default_name=$(pactl get-default-source 2>/dev/null)
  local marked
  marked=$(echo "$sources" | while IFS='' read -r line; do
    local id desc
    id=$(echo "$line" | awk '{print $1}')
    desc=$(echo "$line" | awk '{$1=""; print $0}' | sed 's/^ //')
    if pactl list sources 2>/dev/null | grep -A20 "^Source #$id" | grep -q "Name: $default_name"; then
      echo "* $id $desc"
    else
      echo "  $id $desc"
    fi
  done)
  selected=$(echo "$marked" | rofi -dmenu -p "$prompt" -i -format i)
  [[ -z "$selected" ]] && return 1
  echo "$marked" | sed -n "$((selected+1))p" | sed 's/^..//' | awk '{print $1}'
}

shorten_name() {
  local name="$1"
  local short
  short=$(echo "$name" | grep -oP '/ \K[^/]+?(?= \()' | head -1)
  [[ -z "$short" ]] && short="$name"
  echo "$short" | sed 's/^ *//;s/ *$//'
}

get_sink_status() {
  local name="$1"
  pactl list sinks 2>/dev/null | awk -v n="$name" '
    BEGIN { RS=""; FS="\n" }
    $0 ~ "Name: " n {
      desc=""; vol=""; mute="no"
      for (i=1; i<=NF; i++) {
        if ($i ~ /^[[:space:]]*Description:[[:space:]]/) {
          gsub(/^[[:space:]]*Description:[[:space:]]*/, "", $i); desc=$i
        }
        if ($i ~ /^[[:space:]]*Volume:/) {
          match($i, /[0-9]+%/); vol = substr($i, RSTART, RLENGTH - 1)
        }
        if ($i ~ /^[[:space:]]*Mute:/) {
          gsub(/^[[:space:]]*Mute:[[:space:]]*/, "", $i); mute=$i
        }
      }
      m = (mute ~ /^yes$/) ? "MUTED" : ""
      print desc "|" vol "|" m
    }'
}

get_source_status() {
  local name="$1"
  pactl list sources 2>/dev/null | awk -v n="$name" '
    BEGIN { RS=""; FS="\n" }
    $0 ~ "Name: " n {
      desc=""; vol=""; mute="no"
      for (i=1; i<=NF; i++) {
        if ($i ~ /^[[:space:]]*Description:[[:space:]]/) {
          gsub(/^[[:space:]]*Description:[[:space:]]*/, "", $i); desc=$i
        }
        if ($i ~ /^[[:space:]]*Volume:/) {
          match($i, /[0-9]+%/); vol = substr($i, RSTART, RLENGTH - 1)
        }
        if ($i ~ /^[[:space:]]*Mute:/) {
          gsub(/^[[:space:]]*Mute:[[:space:]]*/, "", $i); mute=$i
        }
      }
      if (desc !~ /Monitor/) {
        m = (mute ~ /^yes$/) ? "MUTED" : ""
        print desc "|" vol "|" m
      }
    }'
}

parse_stat() {
  local v="$1" m="$2"
  if [[ "$m" == "MUTED" ]]; then
    printf "%s|${_P}  [%s]  ${_X}" "$v" "$v"
  else
    printf "%s|${_P}  [%s]" "$v" "$v"
  fi
}

# ── Submenus ──

sink_menu() {
  local name desc vol mute short cur_val header edit_label mute_label
  name=$(pactl get-default-sink 2>/dev/null)
  IFS='|' read -r desc vol mute <<< "$(get_sink_status "$name")"
  short=$(shorten_name "$desc")
  IFS='|' read -r cur_val edit_label <<< "$(parse_stat "$vol" "$mute")"
  header="${_V}  ${short} [${vol}]${mute:+  ${_X}}"
  mute_label="${mute:+${_V}  Unmute}"; mute_label="${mute_label:-${_M}  Mute}"

  local sel
  sel=$(printf '%s\n' \
    "${_S}  Switch device" \
    "${mute_label}" \
    "25%" \
    "50%" \
    "75%" \
    "100%" \
    "${edit_label}" \
    "${_B}  Back" \
    | rofi -dmenu -p "${header}" -i)
  [[ -z "$sel" ]] && exec "$0"

  case "$sel" in
    "${_S}  Switch device")
      local id
      id=$(pick_sink "Switch output") || true
      [[ -n "$id" ]] && pactl set-default-sink "$id"
      ;;
    "${_M}  Mute"|"${_V}  Unmute")       pactl set-sink-mute @DEFAULT_SINK@ toggle  ;;
    "25%")            pactl set-sink-volume @DEFAULT_SINK@ 25%   ;;
    "50%")            pactl set-sink-volume @DEFAULT_SINK@ 50%   ;;
    "75%")            pactl set-sink-volume @DEFAULT_SINK@ 75%   ;;
    "100%")           pactl set-sink-volume @DEFAULT_SINK@ 100%  ;;
    "${_P}"*)
      local v
      v=$(rofi -dmenu -p "Volume % (0-100)${cur_val:+ [${cur_val}]}" -filter "${cur_val:-}" -l 0) || true
      [[ -n "$v" && "$v" -ge 0 && "$v" -le 100 ]] 2>/dev/null && pactl set-sink-volume @DEFAULT_SINK@ "${v}%"
      ;;
    "${_B}  Back")        ;;
  esac
  exec "$0"
}

source_menu() {
  local name desc vol mute short cur_val header edit_label mute_label
  name=$(pactl get-default-source 2>/dev/null)
  IFS='|' read -r desc vol mute <<< "$(get_source_status "$name")"
  short=$(shorten_name "$desc")
  IFS='|' read -r cur_val edit_label <<< "$(parse_stat "$vol" "$mute")"
  header="${_N}  ${short} [${vol}]${mute:+  ${_X}}"
  mute_label="${mute:+${_V}  Unmute}"; mute_label="${mute_label:-${_M}  Mute}"

  local sel
  sel=$(printf '%s\n' \
    "${_S}  Switch device" \
    "${mute_label}" \
    "25%" \
    "50%" \
    "75%" \
    "100%" \
    "${edit_label}" \
    "${_B}  Back" \
    | rofi -dmenu -p "${header}" -i)
  [[ -z "$sel" ]] && exec "$0"

  case "$sel" in
    "${_S}  Switch device")
      local id
      id=$(pick_source "Switch mic") || true
      [[ -n "$id" ]] && pactl set-default-source "$id"
      ;;
    "${_M}  Mute"|"${_V}  Unmute")       pactl set-source-mute @DEFAULT_SOURCE@ toggle  ;;
    "25%")            pactl set-source-volume @DEFAULT_SOURCE@ 25%   ;;
    "50%")            pactl set-source-volume @DEFAULT_SOURCE@ 50%   ;;
    "75%")            pactl set-source-volume @DEFAULT_SOURCE@ 75%   ;;
    "100%")           pactl set-source-volume @DEFAULT_SOURCE@ 100%  ;;
    "${_P}"*)
      local v
      v=$(rofi -dmenu -p "Volume % (0-100)${cur_val:+ [${cur_val}]}" -filter "${cur_val:-}" -l 0) || true
      [[ -n "$v" && "$v" -ge 0 && "$v" -le 100 ]] 2>/dev/null && pactl set-source-volume @DEFAULT_SOURCE@ "${v}%"
      ;;
    "${_B}  Back")        ;;
  esac
  exec "$0"
}

app_menu() {
  local id="$1"
  local app_info app_name app_sink app_vol app_mute sname cur_val edit_label mute_label
  app_info=$(pactl list sink-inputs 2>/dev/null | awk -v i="$id" '
    BEGIN { RS=""; FS="\n" }
    /Sink Input #[0-9]+/ {
      cur=""; n=""; s=""; v=""; m="no"
      for (j=1; j<=NF; j++) {
        if ($j ~ /Sink Input #/) {
          gsub(/.*#/, "", $j); gsub(/[^0-9].*/, "", $j); cur=$j
        }
        if ($j ~ /application.name = ".*"/) {
          gsub(/.*application.name = "|".*/, "", $j); n=$j
          gsub(/^PipeWire ALSA \[|\]$/, "", n)
        }
        if ($j ~ /Sink:/) { gsub(/^.*Sink: */, "", $j); s=$j }
        if ($j ~ /Volume:/) { match($j, /[0-9]+%/); v=substr($j,RSTART,RLENGTH-1) }
        if ($j ~ /Mute:/) { gsub(/^.*Mute: */, "", $j); m=$j }
      }
      if (cur == i) {
        mu = (m ~ /^yes$/) ? "MUTED" : ""
        print n "|" s "|" v "|" mu
      }
    }')
  IFS='|' read -r app_name app_sink app_vol app_mute <<< "$app_info"
  sname="${sink_map[$app_sink]:-$app_sink}"
  IFS='|' read -r cur_val edit_label <<< "$(parse_stat "$app_vol" "$app_mute")"
  local header="${_A}  ${app_name} [${app_vol}] ${app_mute:+ ${_X} }→ ${sname}"
  mute_label="${app_mute:+${_V}  Unmute}"; mute_label="${mute_label:-${_M}  Mute}"

  local sel
  sel=$(printf '%s\n' \
    "${_S}  Switch device" \
    "${mute_label}" \
    "25%" \
    "50%" \
    "75%" \
    "100%" \
    "${edit_label}" \
    "${_B}  Back" \
    | rofi -dmenu -p "${header}" -i)
  [[ -z "$sel" ]] && exec "$0"

  case "$sel" in
    "${_S}  Switch device")
      local target
      target=$(pick_sink "Move to") || true
      [[ -n "$target" ]] && pactl move-sink-input "$id" "$target"
      ;;
    "${_M}  Mute"|"${_V}  Unmute")         pactl set-sink-input-mute "$id" toggle  ;;
    "25%")              pactl set-sink-input-volume "$id" 25%   ;;
    "50%")              pactl set-sink-input-volume "$id" 50%   ;;
    "75%")              pactl set-sink-input-volume "$id" 75%   ;;
    "100%")             pactl set-sink-input-volume "$id" 100%  ;;
    "${_P}"*)
      local v
      v=$(rofi -dmenu -p "Volume % (0-100)${cur_val:+ [${cur_val}]}" -filter "${cur_val:-}" -l 0) || true
      [[ -n "$v" && "$v" -ge 0 && "$v" -le 100 ]] 2>/dev/null && pactl set-sink-input-volume "$id" "${v}%"
      ;;
    "${_B}  Back")          ;;
  esac
  exec "$0"
}

# ── Build main menu ──

declare -a ids=() labels=()

# Default sink
def_sink_name=$(pactl get-default-sink 2>/dev/null)
def_sink_desc=""; def_sink_vol=""; def_sink_mute=""
IFS='|' read -r def_sink_desc def_sink_vol def_sink_mute <<< "$(get_sink_status "$def_sink_name")"
short=$(shorten_name "$def_sink_desc")
ids+=("__sink_menu__"); labels+=("${_V}  ${short} [${def_sink_vol}]${def_sink_mute:+  ${_X}}  ▶")

# Default source
def_src_name=$(pactl get-default-source 2>/dev/null)
def_src_desc=""; def_src_vol=""; def_src_mute=""
IFS='|' read -r def_src_desc def_src_vol def_src_mute <<< "$(get_source_status "$def_src_name")"
short=$(shorten_name "$def_src_desc")
ids+=("__source_menu__"); labels+=("${_N}  ${short} [${def_src_vol}]${def_src_mute:+  ${_X}}  ▶")

# Sink name map (used by app lines)
declare -A sink_map
while IFS='' read -r line; do
  sid=$(echo "$line" | awk '{print $1}')
  sdesc=$(echo "$line" | awk '{$1=""; print $0}' | sed 's/^ //')
  sink_map[$sid]=$(shorten_name "$sdesc")
done < <(list_sinks)

# App streams
app_entries=$(pactl list sink-inputs 2>/dev/null | awk '
  BEGIN { RS=""; FS="\n" }
  /Sink Input #[0-9]+/ {
    id=""; sink=""; name=""; vol=""; mute="no"
    for (i=1; i<=NF; i++) {
      if ($i ~ /Sink Input #/) {
        gsub(/.*#/, "", $i); gsub(/[^0-9].*/, "", $i); id=$i
      }
      if ($i ~ /Sink:/) { gsub(/^.*Sink: */, "", $i); sink=$i }
      if ($i ~ /application.name = ".*"/) {
        gsub(/.*application.name = "|".*/, "", $i); name=$i
        gsub(/^PipeWire ALSA \[|\]$/, "", name)
      }
      if ($i ~ /Volume:/) { match($i, /[0-9]+%/); vol=substr($i,RSTART,RLENGTH-1) }
      if ($i ~ /Mute:/) { gsub(/^.*Mute: */, "", $i); mute=$i }
    }
    if (id != "" && name != "") {
      m = (mute ~ /^yes$/) ? "MUTED" : ""
      print id "|" sink "|" name "|" vol "|" m
    }
  }')
if [[ -n "$app_entries" ]]; then
  while IFS='|' read -r id sink name app_vol app_mute; do
    sname="${sink_map[$sink]:-$sink}"
    ids+=("$id")
    labels+=("${_A}  ${name} [${app_vol}]${app_mute:+  ${_X}} → ${sname}")
  done <<< "$app_entries"
fi

# ── Show main menu ──

[[ ${#ids[@]} -eq 0 ]] && { rofi -e "No audio streams"; exit 1; }

selected=$(for i in "${!ids[@]}"; do printf '%s\n' "${labels[$i]}"; done \
  | rofi -dmenu -p "Volume" -i -format i)
[[ -z "$selected" ]] && exit 0

stream_id="${ids[$selected]}"

case "$stream_id" in
  __sink_menu__)   sink_menu   ;;
  __source_menu__) source_menu ;;
  *[0-9]*)         app_menu "$stream_id"  ;;
esac
