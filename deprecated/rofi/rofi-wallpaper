#!/bin/sh
MOD_LABEL="${MOD_LABEL:-Alt}"
dir="${1:-$HOME/Pictures/wallpapers}"
relpath=$(echo "$dir" | sed "s|$HOME/Pictures/wallpapers/||")

result=$( {
    for f in "$dir"/*/; do
        [ -d "$f" ] || continue
        name=$(basename "$f")
        first=$(find "$f" -maxdepth 1 -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' \) 2>/dev/null | head -1)
        [ -z "$first" ] && continue
        if [ -n "$first" ]; then
            printf "%s/\0icon\x1f%s\n" "$name" "$first"
        else
            printf "%s/\0icon\x1ffolder\n" "$name"
        fi
    done
    for f in "$dir"/*; do
        [ -f "$f" ] || continue
        name=$(basename "$f")
        case "${name##*.}" in
            png|jpg|jpeg|PNG|JPG|JPEG)
                printf "%s\0icon\x1f%s\n" "$name" "$f"
                ;;
        esac
    done
} | rofi -dmenu -p "${relpath:-Wallpapers}" \
    -show-icons \
    -theme ~/.config/rofi/themes/rofi-wallpaper.rasi)

selected="$result"
if [ -z "$selected" ]; then
    [ "$dir" != "$HOME/Pictures/wallpapers" ] && "$0" "$(dirname "$dir")"
    exit 0
fi

if [ -d "$dir/$selected" ]; then
    "$0" "$dir/$selected"
else
    # Write shared path (always)
    echo "$dir/$selected" > "$HOME/.config/wallpaper"

    # Write compositor configs (dir + dependency check)
    if [ -d "$HOME/.config/sway/local" ]; then
        printf 'output * bg "%s" fill\n' "$dir/$selected" > "$HOME/.config/sway/local/wallpaper"
    fi

    if [ -d "$HOME/.config/niri/local" ] && command -v swaybg >/dev/null; then
        printf 'spawn-at-startup "swaybg" "-i" "%s" "-m" "fill"\n' "$dir/$selected" > "$HOME/.config/niri/local/wallpaper.kdl"
    fi

    # Apply at runtime (gated by socket)
    if [ -n "$SWAYSOCK" ]; then
        swaymsg output "*" bg "$dir/$selected" fill
    fi
    if [ -n "$NIRI_SOCKET" ] && command -v swaybg >/dev/null; then
        killall swaybg 2>/dev/null || true
        swaybg -i "$dir/$selected" -m fill &
    fi
fi
