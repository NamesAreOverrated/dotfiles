;; ==========================================
;; 1. 物理层 (硬件扫描码输入)
;; ==========================================
(defsrc
  esc  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  caps a    d    h    j    k    l    i    n    p
  rctl
)

;; ==========================================
;; 2. 行为别名 (触发器逻辑)
;; ==========================================
(defalias
  ;; CapsLock逻辑: 200ms内松开是Esc，按住是切到 caps_nav 层
  cap (tap-hold 200 200 esc (layer-toggle caps_nav))
  
  ;; 物理Esc逻辑: 200ms内松开是反引号(`)，按住是切到 esc_media 层
  ;; 注意：在 Kanata 里反引号叫 grv (Grave)
  esm (tap-hold 200 200 grv (layer-toggle esc_media))
)

;; ==========================================
;; 3. 默认层 (你平时的键盘状态)
;; ==========================================
(deflayer default
  @esm 1    2    3    4    5    6    7    8    9    0    -    =    bspc
  @cap a    d    h    j    k    l    i    n    p
  caps ;; 原本的右 Ctrl 现在变成了真正的 CapsLock 锁定键
)

;; ==========================================
;; 4. 导航层 (按住 CapsLock 时激活)
;; ==========================================
(deflayer caps_nav
  _    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  _
  _    end  del  left down up   rght home pgdn pgup
  _
)

;; ==========================================
;; 5. 媒体层 (按住 物理Esc 时激活)
;; ==========================================
(deflayer esc_media
  _    _    _    _    _    _    _    _    _    _    _     vold volu mute
  _    _    _    _    _    _    _    _    _    prnt
  _
)
