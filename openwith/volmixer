#!/usr/bin/env bash
set -euo pipefail

list_nodes() {
  local class_filter="$1"
  pw-cli list-objects Node | awk -v cls="$class_filter" '
    BEGIN { id=""; desc=""; name=""; class="" }
    /^\s*id / {
      if (desc == "") desc = name
      cond = (class ~ cls || (cls == "Stream" && class ~ /^Stream\//))
      if (cond && id != "" && desc !~ /Monitor/)
        print id "|" name "|" desc
      match($0, /id ([0-9]+)/, m); id = m[1]; desc=""; name=""; class=""
    }
    /node\.description = "/ { match($0, /node\.description = "(.*)"/, m); desc = m[1] }
    /node\.name = "/         { match($0, /node\.name = "(.*)"/, m);      name = m[1] }
    /media\.class = "/       { match($0, /media\.class = "(.*)"/, m);    class = m[1] }
    END {
      if (desc == "") desc = name
      cond = (class ~ cls || (cls == "Stream" && class ~ /^Stream\//))
      if (cond && id != "" && desc !~ /Monitor/) print id "|" name "|" desc
    }
  '
}

get_default_id() {
  local section="$1"
  wpctl status | awk -v sec="$section" '
    /Audio/ { a=1 }
    a && /├─ '"$section"'/ { s=1 }
    a && /├─ / && !/'"$section"'/ { s=0 }
    s && /\*/ { gsub(/\.$/, "", $3); print $3; exit }
  '
}

get_volume_status() {
  local id="$1"
  wpctl get-volume "$id" | awk '{
    pct = sprintf("%.0f", $2 * 100)
    if ($0 ~ /\[MUTED\]/) print pct " MUTED"; else print pct
  }'
}

pick_node() {
  local prompt="$1" class="$2" default_id="$3"
  local nodes
  nodes=$(list_nodes "$class")
  [[ -z "$nodes" ]] && { rofi -e "No $class found"; exit 1; }
  local marked
  marked=$(echo "$nodes" | while IFS='|' read -r id name desc; do
    if [[ "$id" == "$default_id" ]]; then
      echo "* $id $desc"
    else
      echo "  $id $desc"
    fi
  done)
  local selected
  selected=$(echo "$marked" | rofi -dmenu -p "$prompt" -i -format i)
  [[ -z "$selected" ]] && exit 0
  echo "$marked" | sed -n "$((selected+1))p" | sed 's/^..//' | awk '{print $1}'
}

shorten_name() {
  local name="$1"
  local short
  short=$(echo "$name" | grep -oP '/ \K[^/]+?(?= \()' | head -1)
  [[ -z "$short" ]] && short="$name"
  echo "$short" | sed 's/^ *//;s/ *$//'
}

declare -A sink_map
while IFS='|' read -r id name desc; do
  sink_map[$id]=$(shorten_name "$desc")
done < <(list_nodes "Audio/Sink")

default_sink_id=$(get_default_id "Sinks")
default_src_id=$(get_default_id "Sources")

declare -a ids=() labels=()

#--- Switch Output ---
default_sink_desc=$(list_nodes "Audio/Sink" | awk -F'|' -v id="$default_sink_id" '$1 == id {print $3; exit}')
status=$(get_volume_status "$default_sink_id")
vol_pct="${status% *}"
muted="${status##* }"
if [[ "$muted" == "MUTED" ]]; then
  label="$default_sink_desc [MUTED]"
else
  label="$default_sink_desc [$vol_pct%]"
fi
label=$(shorten_name "$label")
ids+=("__switch_out__"); labels+=(" ${label}  ▶")

#--- Switch Mic ---
default_src_desc=$(list_nodes "Audio/Source" | awk -F'|' -v id="$default_src_id" '$1 == id {print $3; exit}')
status=$(get_volume_status "$default_src_id")
vol_pct="${status% *}"
muted="${status##* }"
if [[ "$muted" == "MUTED" ]]; then
  label="$default_src_desc [MUTED]"
else
  label="$default_src_desc [$vol_pct%]"
fi
label=$(shorten_name "$label")
ids+=("__switch_mic__"); labels+=(" ${label}  ▶")

#--- Master Volume ---
status=$(get_volume_status "@DEFAULT_AUDIO_SINK@")
vol_pct="${status% *}"
muted="${status##* }"
if [[ "$muted" == "MUTED" ]]; then
  ids+=("__master__"); labels+=("󰕾 Master Volume [MUTED]")
else
  ids+=("__master__"); labels+=("󰕾 Master Volume [${vol_pct}%]")
fi

#--- Master Mic ---
status=$(get_volume_status "@DEFAULT_AUDIO_SOURCE@")
vol_pct="${status% *}"
muted="${status##* }"
if [[ "$muted" == "MUTED" ]]; then
  ids+=("__mic__"); labels+=("󰍬 Master Mic [MUTED]")
else
  ids+=("__mic__"); labels+=("󰍬 Master Mic [${vol_pct}%]")
fi

#--- App streams ---
declare -A stream_sink_map
while IFS='' read -r line; do
  [[ -z "$line" ]] && continue
  out_port="${line%% -> *}"
  in_port="${line##* -> }"
  stream_name="${out_port%%:*}"
  sink_name="${in_port%%:*}"
  stream_sink_map["$stream_name"]="$sink_name"
done < <(pw-link -l 2>/dev/null)

while IFS='|' read -r id name desc; do
  sname=""
  if [[ -n "${stream_sink_map[$name]:-}" ]]; then
    target_name="${stream_sink_map[$name]}"
    while IFS='|' read -r sid sn sdesc; do
      if [[ "$sn" == "$target_name" ]]; then
        sname="${sink_map[$sid]:-}"
      fi
    done < <(list_nodes "Audio/Sink")
  fi
  label="$desc"
  [[ -n "$sname" ]] && label="$label → $sname"
  status=$(get_volume_status "$id")
  vol_pct="${status% *}"
  muted="${status##* }"
  if [[ "$muted" == "MUTED" ]]; then
    ids+=("$id"); labels+=("󰘔 $label [MUTED]")
  else
    ids+=("$id"); labels+=("󰘔 $label [$vol_pct%]")
  fi
done < <(list_nodes "Stream")

#--- Main menu ---
[[ ${#ids[@]} -eq 0 ]] && { rofi -e "No audio streams"; exit 1; }

selected=$(for i in "${!ids[@]}"; do
  printf '%s\n' "${labels[$i]}"
done | rofi -dmenu -p "Volume" -i -format i)
[[ -z "$selected" ]] && exit 0

stream_id="${ids[$selected]}"

#--- Switch Output ---
if [[ "$stream_id" == "__switch_out__" ]]; then
  sid=$(pick_node "Switch output" "Audio/Sink" "$default_sink_id")
  wpctl set-default "$sid"
  exit 0
fi

#--- Switch Mic ---
if [[ "$stream_id" == "__switch_mic__" ]]; then
  sid=$(pick_node "Switch mic" "Audio/Source" "$default_src_id")
  wpctl set-default "$sid"
  exit 0
fi

#--- Action submenu ---
if [[ "$stream_id" =~ ^[0-9]+$ ]]; then
  action=$(printf "Mute\n25%%\n50%%\n75%%\n100%%\nMove output..." | rofi -dmenu -p "Volume" -i)
else
  action=$(printf "Mute\n25%%\n50%%\n75%%\n100%%" | rofi -dmenu -p "Volume" -i)
fi

[[ -z "$action" ]] && exit 0

#--- Move output ---
if [[ "$action" == "Move output..." ]]; then
  sink_id=$(pick_node "Move to" "Audio/Sink" "$default_sink_id")
  pw-cli set-param "$stream_id" Props "{ node.target = $sink_id }" &>/dev/null || true
  exit 0
fi

#--- Volume/mute actions ---
case "$action" in
  Mute)
    case "$stream_id" in
      __master__) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
      __mic__)    wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle ;;
      *)          wpctl set-mute "$stream_id" toggle ;;
    esac
    ;;
  25%|50%|75%|100%)
    vol="${action%\%}"
    case "$stream_id" in
      __master__) wpctl set-volume @DEFAULT_AUDIO_SINK@ "$vol%" ;;
      __mic__)    wpctl set-volume @DEFAULT_AUDIO_SOURCE@ "$vol%" ;;
      *)          wpctl set-volume "$stream_id" "$vol%" ;;
    esac
    ;;
esac
