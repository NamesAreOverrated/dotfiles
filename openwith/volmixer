#!/usr/bin/env bash
set -euo pipefail

list_sinks() {
  pactl list sinks 2>/dev/null | awk '
    BEGIN { RS=""; FS="\n" }
    /Sink #[0-9]+/ {
      id=""; desc=""
      for (i=1; i<=NF; i++) {
        if ($i ~ /Sink #[0-9]+/) {
          gsub(/.*#/, "", $i); gsub(/[^0-9].*/, "", $i); id=$i
        }
        if ($i ~ /^[[:space:]]*Description:[[:space:]]/) {
          gsub(/^[[:space:]]*Description:[[:space:]]*/, "", $i); desc=$i
        }
      }
      if (id != "" && desc != "")
        print id " " desc
    }
  '
}

pick_sink() {
  local prompt="${1:-Select output}"
  local sinks
  sinks=$(list_sinks)
  [[ -z "$sinks" ]] && { rofi -e "No sinks found"; exit 1; }
  local default_name
  default_name=$(pactl get-default-sink 2>/dev/null)
  local marked
  marked=$(echo "$sinks" | while IFS='' read -r line; do
    local id desc
    id=$(echo "$line" | awk '{print $1}')
    desc=$(echo "$line" | awk '{$1=""; print $0}' | sed 's/^ //')
    if pactl list sinks 2>/dev/null | grep -A20 "^Sink #$id" | grep -q "Name: $default_name"; then
      echo "* $id $desc"
    else
      echo "  $id $desc"
    fi
  done)
  selected=$(echo "$marked" | rofi -dmenu -p "$prompt" -i -format i)
  [[ -z "$selected" ]] && exit 0
  echo "$marked" | sed -n "$((selected+1))p" | sed 's/^..//' | awk '{print $1}'
}

list_sources() {
  pactl list sources 2>/dev/null | awk '
    BEGIN { RS=""; FS="\n" }
    /Source #[0-9]+/ {
      id=""; desc=""
      for (i=1; i<=NF; i++) {
        if ($i ~ /Source #[0-9]+/) {
          gsub(/.*#/, "", $i); gsub(/[^0-9].*,/, "", $i); id=$i
        }
        if ($i ~ /^[[:space:]]*Description:[[:space:]]/) {
          gsub(/^[[:space:]]*Description:[[:space:]]*/, "", $i); desc=$i
        }
      }
      if (id != "" && desc != "" && desc !~ /Monitor/)
        print id " " desc
    }
  '
}

pick_source() {
  local prompt="${1:-Select mic}"
  local sources
  sources=$(list_sources)
  [[ -z "$sources" ]] && { rofi -e "No mics found"; exit 1; }
  local default_name
  default_name=$(pactl get-default-source 2>/dev/null)
  local marked
  marked=$(echo "$sources" | while IFS='' read -r line; do
    local id desc
    id=$(echo "$line" | awk '{print $1}')
    desc=$(echo "$line" | awk '{$1=""; print $0}' | sed 's/^ //')
    if pactl list sources 2>/dev/null | grep -A20 "^Source #$id" | grep -q "Name: $default_name"; then
      echo "* $id $desc"
    else
      echo "  $id $desc"
    fi
  done)
  selected=$(echo "$marked" | rofi -dmenu -p "$prompt" -i -format i)
  [[ -z "$selected" ]] && exit 0
  echo "$marked" | sed -n "$((selected+1))p" | sed 's/^..//' | awk '{print $1}'
}

shorten_name() {
  local name="$1"
  local short
  short=$(echo "$name" | grep -oP '/ \K[^/]+?(?= \()' | head -1)
  [[ -z "$short" ]] && short="$name"
  echo "$short" | sed 's/^ *//;s/ *$//'
}

# --- Build main menu ---
declare -a ids=() labels=()

# Switch Output
default_name=$(pactl get-default-sink 2>/dev/null)
default_info=$(pactl list sinks 2>/dev/null | awk -v name="$default_name" '
  BEGIN { RS=""; FS="\n" }
  $0 ~ "Name: " name {
    desc=""; vol=""; mute="no"
    for (i=1; i<=NF; i++) {
      if ($i ~ /^[[:space:]]*Description:[[:space:]]/) {
        gsub(/^[[:space:]]*Description:[[:space:]]*/, "", $i); desc=$i
      }
      if ($i ~ /^[[:space:]]*Volume:/) {
        match($i, /[0-9]+%/); vol = substr($i, RSTART, RLENGTH - 1)
      }
      if ($i ~ /^[[:space:]]*Mute:/) {
        gsub(/^[[:space:]]*Mute:[[:space:]]*/, "", $i); mute=$i
      }
    }
    status = (mute ~ /^yes$/) ? "MUTED" : vol "%"
    print desc " [" status "]"
  }
')
label="Switch Output"
[[ -n "$default_info" ]] && label="${default_info}"
label=$(shorten_name "$label")
ids+=("__switch_out__"); labels+=(" ${label}  ▶")

# Switch Mic
default_src_name=$(pactl get-default-source 2>/dev/null)
default_src_info=$(pactl list sources 2>/dev/null | awk -v name="$default_src_name" '
  BEGIN { RS=""; FS="\n" }
  $0 ~ "Name: " name {
    desc=""; vol=""; mute="no"
    for (i=1; i<=NF; i++) {
      if ($i ~ /^[[:space:]]*Description:[[:space:]]/) {
        gsub(/^[[:space:]]*Description:[[:space:]]*/, "", $i); desc=$i
      }
      if ($i ~ /^[[:space:]]*Volume:/) {
        match($i, /[0-9]+%/); vol = substr($i, RSTART, RLENGTH - 1)
      }
      if ($i ~ /^[[:space:]]*Mute:/) {
        gsub(/^[[:space:]]*Mute:[[:space:]]*/, "", $i); mute=$i
      }
    }
    status = (mute ~ /^yes$/) ? "MUTED" : vol "%"
    if (desc !~ /Monitor/) print desc " [" status "]"
  }
')
label="Switch Mic"
[[ -n "$default_src_info" ]] && label="${default_src_info}"
label=$(shorten_name "$label")
ids+=("__switch_mic__"); labels+=(" ${label}  ▶")

# Master Volume
master_vol=$(pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | grep -oP '\d+(?=%)' | head -1)
master_mute=$(pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | grep -oP '(yes|no)')
master_status="MUTED"
[[ "$master_mute" != "yes" && -n "$master_vol" ]] && master_status="${master_vol}%"
ids+=("__master__"); labels+=("󰕾 Master Volume [${master_status}]")

# Master Mic
mic_vol=$(pactl get-source-volume @DEFAULT_SOURCE@ 2>/dev/null | grep -oP '\d+(?=%)' | head -1)
mic_mute=$(pactl get-source-mute @DEFAULT_SOURCE@ 2>/dev/null | grep -oP '(yes|no)')
mic_status="MUTED"
[[ "$mic_mute" != "yes" && -n "$mic_vol" ]] && mic_status="${mic_vol}%"
ids+=("__mic__"); labels+=("󰍬 Master Mic [${mic_status}]")

# Build sink id → short name map
declare -A sink_map
while IFS='' read -r line; do
  sid=$(echo "$line" | awk '{print $1}')
  sdesc=$(echo "$line" | awk '{$1=""; print $0}' | sed 's/^ //')
  sdesc=$(shorten_name "$sdesc")
  sink_map[$sid]="$sdesc"
done < <(list_sinks)

# App streams
app_entries=$(pactl list sink-inputs 2>/dev/null | awk '
    BEGIN { RS=""; FS="\n" }
    /Sink Input #[0-9]+/ {
      id=""; sink_id=""; name=""; vol=""; mute="no"
      for (i=1; i<=NF; i++) {
        if ($i ~ /Sink Input #/) {
          gsub(/.*#/, "", $i); gsub(/[^0-9].*/, "", $i); id=$i
        }
        if ($i ~ /^[[:space:]]*Sink:[[:space:]]/) {
          gsub(/^[[:space:]]*Sink:[[:space:]]*/, "", $i); sink_id=$i
        }
        if ($i ~ /application.name = "/) {
          gsub(/.*application.name = "|".*/, "", $i); name=$i
          gsub(/^PipeWire ALSA \[|\]$/, "", name)
        }
        if ($i ~ /^[[:space:]]*Volume:/) {
          match($i, /[0-9]+%/); vol = substr($i, RSTART, RLENGTH - 1)
        }
        if ($i ~ /^[[:space:]]*Mute:/) {
          gsub(/^[[:space:]]*Mute:[[:space:]]*/, "", $i); mute=$i
        }
      }
      if (id != "" && name != "") {
        status = (mute ~ /^yes$/) ? "MUTED" : vol "%"
        print id "|" sink_id "|" name " [" status "]"
      }
    }
  ')
if [[ -n "$app_entries" ]]; then
  while IFS='|' read -r id sink_id rest; do
    sname="${sink_map[$sink_id]:-$sink_id}"
    ids+=("$id")
    labels+=("󰘔 $rest → $sname")
  done <<< "$app_entries"
fi

# --- Main menu ---
[[ ${#ids[@]} -eq 0 ]] && { rofi -e "No audio streams"; exit 1; }

selected=$(for i in "${!ids[@]}"; do
  printf '%s\n' "${labels[$i]}"
done | rofi -dmenu -p "Volume" -i -format i)
[[ -z "$selected" ]] && exit 0

stream_id="${ids[$selected]}"

# Handle Switch Output
if [[ "$stream_id" == "__switch_out__" ]]; then
  sink_id=$(pick_sink "Switch output")
  wpctl set-default "$sink_id"
  exit 0
fi

# Handle Switch Mic
if [[ "$stream_id" == "__switch_mic__" ]]; then
  src_id=$(pick_source "Switch mic")
  wpctl set-default "$src_id"
  exit 0
fi

# --- Action menu ---
if [[ "$stream_id" =~ ^[0-9]+$ ]]; then
  action=$(printf "Mute\n25%%\n50%%\n75%%\n100%%\nMove output..." | rofi -dmenu -p "Volume" -i)
else
  action=$(printf "Mute\n25%%\n50%%\n75%%\n100%%" | rofi -dmenu -p "Volume" -i)
fi

# Handle Move output
if [[ "$action" == "Move output..." ]]; then
  sink_id=$(pick_sink "Move to")
  pactl move-sink-input "$stream_id" "$sink_id"
  exit 0
fi

# Handle volume/mute actions
case "$action" in
  Mute)
    if [[ "$stream_id" == "__master__" ]]; then
      pactl set-sink-mute @DEFAULT_SINK@ toggle
    elif [[ "$stream_id" == "__mic__" ]]; then
      pactl set-source-mute @DEFAULT_SOURCE@ toggle
    else
      pactl set-sink-input-mute "$stream_id" toggle
    fi
    ;;
  25%)
    if [[ "$stream_id" == "__master__" ]]; then
      pactl set-sink-volume @DEFAULT_SINK@ 25%
    elif [[ "$stream_id" == "__mic__" ]]; then
      pactl set-source-volume @DEFAULT_SOURCE@ 25%
    else
      pactl set-sink-input-volume "$stream_id" 25%
    fi
    ;;
  50%)
    if [[ "$stream_id" == "__master__" ]]; then
      pactl set-sink-volume @DEFAULT_SINK@ 50%
    elif [[ "$stream_id" == "__mic__" ]]; then
      pactl set-source-volume @DEFAULT_SOURCE@ 50%
    else
      pactl set-sink-input-volume "$stream_id" 50%
    fi
    ;;
  75%)
    if [[ "$stream_id" == "__master__" ]]; then
      pactl set-sink-volume @DEFAULT_SINK@ 75%
    elif [[ "$stream_id" == "__mic__" ]]; then
      pactl set-source-volume @DEFAULT_SOURCE@ 75%
    else
      pactl set-sink-input-volume "$stream_id" 75%
    fi
    ;;
  100%)
    if [[ "$stream_id" == "__master__" ]]; then
      pactl set-sink-volume @DEFAULT_SINK@ 100%
    elif [[ "$stream_id" == "__mic__" ]]; then
      pactl set-source-volume @DEFAULT_SOURCE@ 100%
    else
      pactl set-sink-input-volume "$stream_id" 100%
    fi
    ;;
esac
