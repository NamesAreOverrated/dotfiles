#!/bin/sh
case "$1" in
    lock)
        shift
        w=$(cat "$HOME/.config/wallpaper" 2>/dev/null)
        [ -n "$w" ] && set -- --background="$w" "$@"
        cd "$HOME/.config/gtklock" && command -v gtklock &>/dev/null && exec gtklock "$@"
        ;;
    reboot)
        systemctl reboot 2>/dev/null || loginctl reboot 2>/dev/null || openrc-shutdown -r now
        ;;
    poweroff)
        systemctl poweroff 2>/dev/null || loginctl poweroff 2>/dev/null || openrc-shutdown -p now
        ;;
esac
