#!/bin/sh
case "$1" in
    lock)
        pgrep -x gtklock >/dev/null && exit 0
        w=$(cat "$HOME/.config/wallpaper" 2>/dev/null)
        [ -n "$w" ] && set -- --background="$w" "$@"
        exec gtklock "$@"
        ;;
    reboot)
        systemctl reboot 2>/dev/null || loginctl reboot 2>/dev/null || openrc-shutdown -r now 2>/dev/null || sudo reboot || sudo shutdown -r now
        ;;
    poweroff)
        systemctl poweroff 2>/dev/null || loginctl poweroff 2>/dev/null || openrc-shutdown -p now 2>/dev/null || sudo poweroff || sudo shutdown -p now
        ;;
esac
