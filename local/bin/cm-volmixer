#!/usr/bin/env bash
set -u

WMENUSH="tiny-cmenush"

_V="󰕾"; _M="󰝟"; _X="󰅖"; _N="󰍬"; _A="󰘔"; _APPREC="󰍵"; _P="󰏫"; _S="󰓡"; _B="󰑐"; _C="󰦨"

list_sinks() {
  pactl list sinks 2>/dev/null | awk '
    BEGIN { RS=""; FS="\n" }
    /Sink #[0-9]+/ {
      id=""; desc=""
      for (i=1; i<=NF; i++) {
        if ($i ~ /Sink #[0-9]+/) {
          gsub(/.*#/, "", $i); gsub(/[^0-9].*/, "", $i); id=$i
        }
        if ($i ~ /^[[:space:]]*Description:[[:space:]]/) {
          gsub(/^[[:space:]]*Description:[[:space:]]*/, "", $i); desc=$i
        }
      }
      if (id != "" && desc != "")
        print id " " desc
    }
  '
}

list_sources() {
  pactl list sources 2>/dev/null | awk '
    BEGIN { RS=""; FS="\n" }
    /Source #[0-9]+/ {
      id=""; desc=""
      for (i=1; i<=NF; i++) {
        if ($i ~ /Source #[0-9]+/) {
          gsub(/.*#/, "", $i); gsub(/[^0-9].*/, "", $i); id=$i
        }
        if ($i ~ /^[[:space:]]*Description:[[:space:]]/) {
          gsub(/^[[:space:]]*Description:[[:space:]]*/, "", $i); desc=$i
        }
      }
      if (id != "" && desc != "" && desc !~ /Monitor/)
        print id " " desc
    }
  '
}

pick_sink() {
  local prompt="${1:-Select output}"
  local sinks
  sinks=$(list_sinks)
  [[ -z "$sinks" ]] && exit 1
  local default_name
  default_name=$(pactl get-default-sink 2>/dev/null)
  local items=()
  while IFS='' read -r line; do
    local id desc short
    id=$(echo "$line" | awk '{print $1}')
    desc=$(echo "$line" | awk '{$1=""; print $0}' | sed 's/^ //')
    short=$(shorten_name "$desc")
    if pactl list sinks 2>/dev/null | grep -A20 "^Sink #$id" | grep -q "Name: $default_name"; then
      items+=("* $short")
    else
      items+=("  $short")
    fi
  done <<< "$sinks"
  local selected
  selected=$(printf '%s\n' "${items[@]}" | $WMENUSH -p "$prompt" --format i) || true
  [[ -z "$selected" ]] && return 1
  local idx=0
  while IFS='' read -r line; do
    [[ "$idx" -eq "$selected" ]] && { echo "$line" | awk '{print $1}'; break; }
    ((idx++))
  done <<< "$sinks"
}

pick_source() {
  local prompt="${1:-Select mic}"
  local sources
  sources=$(list_sources)
  [[ -z "$sources" ]] && exit 1
  local default_name
  default_name=$(pactl get-default-source 2>/dev/null)
  local items=()
  while IFS='' read -r line; do
    local id desc short
    id=$(echo "$line" | awk '{print $1}')
    desc=$(echo "$line" | awk '{$1=""; print $0}' | sed 's/^ //')
    short=$(shorten_name "$desc")
    if pactl list sources 2>/dev/null | grep -A20 "^Source #$id" | grep -q "Name: $default_name"; then
      items+=("* $short")
    else
      items+=("  $short")
    fi
  done <<< "$sources"
  local selected
  selected=$(printf '%s\n' "${items[@]}" | $WMENUSH -p "$prompt" --format i) || true
  [[ -z "$selected" ]] && return 1
  local idx=0
  while IFS='' read -r line; do
    [[ "$idx" -eq "$selected" ]] && { echo "$line" | awk '{print $1}'; break; }
    ((idx++))
  done <<< "$sources"
}

shorten_name() {
  local name="$1"
  local short
  short=$(echo "$name" | grep -oP '/ \K[^/]+?(?= \()' | head -1)
  [[ -z "$short" ]] && short="$name"
  echo "$short" | sed 's/^ *//;s/ *$//'
}

get_sink_status() {
  local name="$1"
  pactl list sinks 2>/dev/null | awk -v n="$name" '
    BEGIN { RS=""; FS="\n" }
    $0 ~ "Name: " n {
      desc=""; vol=""; mute="no"
      for (i=1; i<=NF; i++) {
        if ($i ~ /^[[:space:]]*Description:[[:space:]]/) {
          gsub(/^[[:space:]]*Description:[[:space:]]*/, "", $i); desc=$i
        }
        if ($i ~ /^[[:space:]]*Volume:/) {
          match($i, /[0-9]+%/); vol = substr($i, RSTART, RLENGTH - 1)
        }
        if ($i ~ /^[[:space:]]*Mute:/) {
          gsub(/^[[:space:]]*Mute:[[:space:]]*/, "", $i); mute=$i
        }
      }
      m = (mute ~ /^yes$/) ? "MUTED" : ""
      print desc "|" vol "|" m
    }'
}

get_source_status() {
  local name="$1"
  pactl list sources 2>/dev/null | awk -v n="$name" '
    BEGIN { RS=""; FS="\n" }
    $0 ~ "Name: " n {
      desc=""; vol=""; mute="no"
      for (i=1; i<=NF; i++) {
        if ($i ~ /^[[:space:]]*Description:[[:space:]]/) {
          gsub(/^[[:space:]]*Description:[[:space:]]*/, "", $i); desc=$i
        }
        if ($i ~ /^[[:space:]]*Volume:/) {
          match($i, /[0-9]+%/); vol = substr($i, RSTART, RLENGTH - 1)
        }
        if ($i ~ /^[[:space:]]*Mute:/) {
          gsub(/^[[:space:]]*Mute:[[:space:]]*/, "", $i); mute=$i
        }
      }
      if (desc !~ /Monitor/) {
        m = (mute ~ /^yes$/) ? "MUTED" : ""
        print desc "|" vol "|" m
      }
    }'
}

list_cards() {
  pactl list cards 2>/dev/null | awk '
    BEGIN { RS=""; FS="\n" }
    /^Card #[0-9]+/ {
      id=""; name=""; desc=""
      for (i=1; i<=NF; i++) {
        if ($i ~ /^Card #[0-9]+/) {
          gsub(/.*#/, "", $i); gsub(/[^0-9].*/, "", $i); id=$i
        }
        if ($i ~ /^[[:space:]]*Name:[[:space:]]/) {
          gsub(/^[[:space:]]*Name:[[:space:]]*/, "", $i); name=$i
        }
        if ($i ~ /device.description = "/) {
          gsub(/.*device.description = "|"$/, "", $i); desc=$i
        }
      }
      if (id != "" && name != "")
        print name "\t" desc
    }'
}

get_card_status() {
  local name="$1"
  pactl list cards 2>/dev/null | awk -v n="$name" '
    BEGIN { RS=""; FS="\n" }
    ($0 ~ "Card #" n) || ($0 ~ "Name: " n) {
      desc=""; prof=""
      for (i=1; i<=NF; i++) {
        if ($i ~ /device.description = "/) {
          gsub(/.*device.description = "|"$/, "", $i); desc=$i
        }
        if ($i ~ /^[[:space:]]*Active Profile:[[:space:]]/) {
          gsub(/^[[:space:]]*Active Profile:[[:space:]]*/, "", $i); prof=$i
        }
      }
      print desc "|" prof
    }'
}

list_profiles() {
  local name="$1"
  pactl list cards 2>/dev/null | awk -v n="$name" '
    BEGIN { RS=""; FS="\n" }
    ($0 ~ "Card #" n) || ($0 ~ "Name: " n) {
      inprof=0
      for (i=1; i<=NF; i++) {
        line=$i
        if (line ~ /^[[:space:]]*Profiles:[[:space:]]*$/) { inprof=1; continue }
        if (inprof && line ~ /^[[:space:]]*Active Profile:/) { inprof=0; continue }
        if (inprof && line !~ /^[[:space:]]*$/) {
          n=split(line, parts, /: /)
          pname=parts[1]; sub(/^[[:space:]]+/, "", pname)
          rest=parts[2]; sub(/ \(sinks.*/, "", rest)
          avail=(line ~ /available: yes/) ? "yes" : "no"
          print pname "|" rest "|" avail
        }
      }
    }'
}

pick_card() {
  local prompt="${1:-Select card}"
  local cards
  cards=$(list_cards)
  [[ -z "$cards" ]] && return 1
  local items=()
  while IFS=$'\t' read -r cname cdesc; do
    items+=("$(shorten_name "$cdesc")")
  done <<< "$cards"
  local selected
  selected=$(printf '%s\n' "${items[@]}" | $WMENUSH -p "$prompt" --format i) || true
  [[ -z "$selected" ]] && return 1
  local idx=0
  while IFS=$'\t' read -r cname cdesc; do
    [[ "$idx" -eq "$selected" ]] && { echo "$cname"; break; }
    ((idx++))
  done <<< "$cards"
}

pick_profile() {
  local card="${1:-}"
  local prompt="${2:-Select profile}"
  local profs
  profs=$(list_profiles "$card")
  [[ -z "$profs" ]] && return 1
  local active
  active=$(get_card_status "$card" | cut -d'|' -f2)
  local items=()
  while IFS='|' read -r pname pdesc pavail; do
    local mark="  "
    [[ "$pname" == "$active" ]] && mark="* "
    local avtag=""
    [[ "$pavail" == "no" ]] && avtag=" (unavail)"
    items+=("$mark$pdesc$avtag")
  done <<< "$profs"
  local selected
  selected=$(printf '%s\n' "${items[@]}" | $WMENUSH -p "$prompt" --format i) || true
  [[ -z "$selected" ]] && return 1
  local idx=0
  while IFS='|' read -r pname pdesc pavail; do
    [[ "$idx" -eq "$selected" ]] && { echo "$pname"; break; }
    ((idx++))
  done <<< "$profs"
}

shorten_profile() {
  local p="$1"
  case "$p" in
    *hdmi-stereo*"input:"*)        echo "HDMI+Mic"  ;;
    *"input:"*hdmi-stereo*)        echo "Mic+HDMI"  ;;
    *hdmi-stereo*)                 echo "HDMI"      ;;
    *iec958*"input:"*|*"input:"*iec958*) echo "S/PDIF+Mic" ;;
    *iec958*)                      echo "S/PDIF"    ;;
    *analog-stereo*"input:"*|*"input:"*analog-stereo*) echo "Analog+Mic" ;;
    *analog-stereo*)               echo "Analog"    ;;
    *hdmi-surround*)               echo "HDMI 5.1/7.1" ;;
    pro-audio)                     echo "Pro Audio" ;;
    off)                           echo "Off"       ;;
    *)                             echo "$p"        ;;
  esac
}

custom_vol_prompt() {
  local cur_val="${1:-}"
  printf '\x00Current: %s\n' "$cur_val" | $WMENUSH -p "Volume % (0-100)" --input-fallback --lines 0 --pfill "$cur_val" || true
}

# ── State machine ──

page="main"
select_idx=""

while true; do

case "$page" in

  main)
    # ── Collect data ──
    declare -a ids=() labels=()

    def_card_name=$(pactl list cards short 2>/dev/null | head -1 | cut -f2)
    if [[ -n "$def_card_name" ]]; then
      cur_card="${cur_card:-$def_card_name}"
      IFS='|' read -r def_card_desc def_card_prof <<< "$(get_card_status "$cur_card")"
      short=$(shorten_name "$def_card_desc")
      ids+=("__card_menu__"); labels+=("${_C}  ${short} [$(shorten_profile "$def_card_prof")]  ▶")
    else
      ids+=("__card_menu__"); labels+=("${_C}  Audio card  ▶")
    fi

    def_sink_name=$(pactl get-default-sink 2>/dev/null)
    def_sink_desc=""; def_sink_vol=""; def_sink_mute=""
    IFS='|' read -r def_sink_desc def_sink_vol def_sink_mute <<< "$(get_sink_status "$def_sink_name")"
    short=$(shorten_name "$def_sink_desc")
    ids+=("__sink_menu__"); labels+=("${_V}  ${short} [${def_sink_vol}]${def_sink_mute:+  ${_X}}  ▶")

    def_src_name=$(pactl get-default-source 2>/dev/null)
    def_src_desc=""; def_src_vol=""; def_src_mute=""
    IFS='|' read -r def_src_desc def_src_vol def_src_mute <<< "$(get_source_status "$def_src_name")"
    short=$(shorten_name "$def_src_desc")
    ids+=("__source_menu__"); labels+=("${_N}  ${short} [${def_src_vol}]${def_src_mute:+  ${_X}}  ▶")

    declare -A sink_map
    while IFS='' read -r line; do
      sid=$(echo "$line" | awk '{print $1}')
      sdesc=$(echo "$line" | awk '{$1=""; print $0}' | sed 's/^ //')
      sink_map[$sid]=$(shorten_name "$sdesc")
    done < <(list_sinks)

    declare -A source_map
    while IFS='' read -r line; do
      sid=$(echo "$line" | awk '{print $1}')
      sdesc=$(echo "$line" | awk '{$1=""; print $0}' | sed 's/^ //')
      source_map[$sid]=$(shorten_name "$sdesc")
    done < <(list_sources)

    # ── sink-inputs ──
    app_entries=$(pactl list sink-inputs 2>/dev/null | awk '
      BEGIN { RS=""; FS="\n" }
      /Sink Input #[0-9]+/ {
        id=""; sink=""; name=""; vol=""; mute="no"
        for (i=1; i<=NF; i++) {
          if ($i ~ /Sink Input #/) {
            gsub(/.*#/, "", $i); gsub(/[^0-9].*/, "", $i); id=$i
          }
          if ($i ~ /Sink:/) { gsub(/^.*Sink: */, "", $i); sink=$i }
          if ($i ~ /application.name = ".*"/) {
            gsub(/.*application.name = "|".*/, "", $i); name=$i
            gsub(/^PipeWire ALSA \[|\]$/, "", name)
          }
          if ($i ~ /Volume:/) { match($i, /[0-9]+%/); vol=substr($i,RSTART,RLENGTH-1) }
          if ($i ~ /Mute:/) { gsub(/^.*Mute: */, "", $i); mute=$i }
        }
        if (id != "" && name != "") {
          m = (mute ~ /^yes$/) ? "MUTED" : ""
          print id "|" sink "|" name "|" vol "|" m
        }
      }')

    if [[ -n "$app_entries" ]]; then
      while IFS='|' read -r id sink name app_vol app_mute; do
        sname="${sink_map[$sink]:-$sink}"
        ids+=("play:$id")
        labels+=("${_A}  ${name} [${app_vol}]${app_mute:+  ${_X}} → ${sname}")
      done <<< "$app_entries"
    fi

    # ── source-outputs ──
    rec_entries=$(pactl list source-outputs 2>/dev/null | awk '
      BEGIN { RS=""; FS="\n" }
      /Source Output #[0-9]+/ {
        id=""; source=""; name=""; vol=""; mute="no"
        for (i=1; i<=NF; i++) {
          if ($i ~ /Source Output #/) {
            gsub(/.*#/, "", $i); gsub(/[^0-9].*/, "", $i); id=$i
          }
          if ($i ~ /Source:/) { gsub(/^.*Source: */, "", $i); source=$i }
          if ($i ~ /application.name = ".*"/) {
            gsub(/.*application.name = "|".*/, "", $i); name=$i
            gsub(/^PipeWire ALSA \[|\]$/, "", name)
          }
          if ($i ~ /Volume:/) { match($i, /[0-9]+%/); vol=substr($i,RSTART,RLENGTH-1) }
          if ($i ~ /Mute:/) { gsub(/^.*Mute: */, "", $i); mute=$i }
        }
        if (id != "" && name != "") {
          m = (mute ~ /^yes$/) ? "MUTED" : ""
          print id "|" source "|" name "|" vol "|" m
        }
      }')

    if [[ -n "$rec_entries" ]]; then
      while IFS='|' read -r id source name rec_vol rec_mute; do
        sname="${source_map[$source]:-$source}"
        ids+=("rec:$id")
        labels+=("${_APPREC}  ${name} [${rec_vol}]${rec_mute:+  ${_X}} ← ${sname}")
      done <<< "$rec_entries"
    fi

    # ── Build menu with line-to-ID mapping ──
    declare -a menu_texts=()
    declare -a menu_ids=()

    menu_texts+=('── Devices ──');   menu_ids+=('__HEADER__')
    menu_texts+=("${labels[0]}");    menu_ids+=('__card_menu__')
    menu_texts+=("${labels[1]}");    menu_ids+=('__sink_menu__')
    menu_texts+=("${labels[2]}");    menu_ids+=('__source_menu__')

    has_play=0
    for i in "${!ids[@]}"; do
      if [[ "${ids[$i]}" == play:* ]]; then
        if (( has_play == 0 )); then
          menu_texts+=('── Playing Streams ──'); menu_ids+=('__HEADER__')
          has_play=1
        fi
        menu_texts+=("${labels[$i]}"); menu_ids+=("${ids[$i]}")
      fi
    done

    has_rec=0
    for i in "${!ids[@]}"; do
      if [[ "${ids[$i]}" == rec:* ]]; then
        if (( has_rec == 0 )); then
          menu_texts+=('── Recording Streams ──'); menu_ids+=('__HEADER__')
          has_rec=1
        fi
        menu_texts+=("${labels[$i]}"); menu_ids+=("${ids[$i]}")
      fi
    done

    sel=$({
      for idx in "${!menu_texts[@]}"; do
        if [[ "${menu_ids[$idx]}" == "__HEADER__" ]]; then
          printf '\x00%s\n' "${menu_texts[$idx]}"
        else
          printf '%s\n' "${menu_texts[$idx]}"
        fi
      done
    } | $WMENUSH -p "Volume" --format i ${select_idx:+--select $select_idx}) || true
    [[ -z "$sel" ]] && exit 0
    select_idx="$sel"

    selected_id="${menu_ids[$sel]:-}"
    [[ -z "$selected_id" || "$selected_id" == "__HEADER__" ]] && continue

    case "$selected_id" in
      __card_menu__)   page="card_menu"   ;;
      __sink_menu__)   page="sink_menu"   ;;
      __source_menu__) page="source_menu" ;;
      play:*)          page="app_menu:${selected_id#play:}" ;;
      rec:*)           page="rec_app_menu:${selected_id#rec:}" ;;
    esac
    ;;

  card_menu)
    name="${cur_card:-}"
    cdesc=""; cprof=""
    [[ -n "$name" ]] && IFS='|' read -r cdesc cprof <<< "$(get_card_status "$name")"
    cshort=$(shorten_name "$cdesc")
    pshort=$(shorten_profile "$cprof")
    header="${_C}  ${cshort:-Audio card} — ${pshort:-unknown}  *"

    ncards=$(pactl list cards short 2>/dev/null | wc -l)
    if (( ncards > 1 )); then
      items=("${_C}  Switch card" "${_P}  Switch profile" "${_S}  Set default sink")
    else
      items=("${_P}  Switch profile" "${_S}  Set default sink")
    fi

    sel=$(printf '%s\n' "${items[@]}" | $WMENUSH -p "$header" --format i) || true
    [[ -z "$sel" ]] && { page="main"; continue; }

    if (( ncards > 1 )); then
      case "$sel" in
        0) newcard=$(pick_card "Select card") || true
           [[ -n "$newcard" ]] && cur_card="$newcard" ;;
        1) prof=$(pick_profile "$name" "Select profile") || true
           [[ -n "$prof" ]] && pactl set-card-profile "$name" "$prof" ;;
        2) id=$(pick_sink "Set default sink") || true
           [[ -n "$id" ]] && pactl set-default-sink "$id" ;;
      esac
    else
      case "$sel" in
        0) prof=$(pick_profile "$name" "Select profile") || true
           [[ -n "$prof" ]] && pactl set-card-profile "$name" "$prof" ;;
        1) id=$(pick_sink "Set default sink") || true
           [[ -n "$id" ]] && pactl set-default-sink "$id" ;;
      esac
    fi
    ;;

  sink_menu)
    name=$(pactl get-default-sink 2>/dev/null)
    IFS='|' read -r desc vol mute <<< "$(get_sink_status "$name")"
    short=$(shorten_name "$desc")
    header="${_V}  ${short} [${vol}]${mute:+  ${_X}}"

    sel=$(printf '%s\n' \
      "${_S}  Switch device" \
      "$( [[ -n "$mute" ]] && echo "${_V}  Unmute" || echo "${_M}  Mute" )" \
      "25%" \
      "50%" \
      "75%" \
      "100%" \
      "${_P}  [${vol}]" \
      | $WMENUSH -p "$header" --format i) || true
    [[ -z "$sel" ]] && { page="main"; continue; }

    case "$sel" in
      0) id=$(pick_sink "Switch output") || true
         [[ -n "$id" ]] && pactl set-default-sink "$id" ;;
      1) pactl set-sink-mute @DEFAULT_SINK@ toggle ;;
      2) pactl set-sink-volume @DEFAULT_SINK@ 25%   ;;
      3) pactl set-sink-volume @DEFAULT_SINK@ 50%   ;;
      4) pactl set-sink-volume @DEFAULT_SINK@ 75%   ;;
      5) pactl set-sink-volume @DEFAULT_SINK@ 100%  ;;
      6) v=$(custom_vol_prompt "$vol") || true
         [[ -n "$v" && "$v" -ge 0 && "$v" -le 100 ]] 2>/dev/null && pactl set-sink-volume @DEFAULT_SINK@ "${v}%"
         ;;
    esac
    ;;

  source_menu)
    name=$(pactl get-default-source 2>/dev/null)
    IFS='|' read -r desc vol mute <<< "$(get_source_status "$name")"
    short=$(shorten_name "$desc")
    header="${_N}  ${short} [${vol}]${mute:+  ${_X}}"

    sel=$(printf '%s\n' \
      "${_S}  Switch device" \
      "$( [[ -n "$mute" ]] && echo "${_V}  Unmute" || echo "${_M}  Mute" )" \
      "25%" \
      "50%" \
      "75%" \
      "100%" \
      "${_P}  [${vol}]" \
      | $WMENUSH -p "$header" --format i) || true
    [[ -z "$sel" ]] && { page="main"; continue; }

    case "$sel" in
      0) id=$(pick_source "Switch mic") || true
         [[ -n "$id" ]] && pactl set-default-source "$id" ;;
      1) pactl set-source-mute @DEFAULT_SOURCE@ toggle ;;
      2) pactl set-source-volume @DEFAULT_SOURCE@ 25%   ;;
      3) pactl set-source-volume @DEFAULT_SOURCE@ 50%   ;;
      4) pactl set-source-volume @DEFAULT_SOURCE@ 75%   ;;
      5) pactl set-source-volume @DEFAULT_SOURCE@ 100%  ;;
      6) v=$(custom_vol_prompt "$vol") || true
         [[ -n "$v" && "$v" -ge 0 && "$v" -le 100 ]] 2>/dev/null && pactl set-source-volume @DEFAULT_SOURCE@ "${v}%"
         ;;
    esac
    ;;

  app_menu:*)
    id="${page#*:}"
    app_info=$(pactl list sink-inputs 2>/dev/null | awk -v i="$id" '
      BEGIN { RS=""; FS="\n" }
      /Sink Input #[0-9]+/ {
        cur=""; n=""; s=""; v=""; m="no"
        for (j=1; j<=NF; j++) {
          if ($j ~ /Sink Input #/) {
            gsub(/.*#/, "", $j); gsub(/[^0-9].*/, "", $j); cur=$j
          }
          if ($j ~ /application.name = ".*"/) {
            gsub(/.*application.name = "|".*/, "", $j); n=$j
            gsub(/^PipeWire ALSA \[|\]$/, "", n)
          }
          if ($j ~ /Sink:/) { gsub(/^.*Sink: */, "", $j); s=$j }
          if ($j ~ /Volume:/) { match($j, /[0-9]+%/); v=substr($j,RSTART,RLENGTH-1) }
          if ($j ~ /Mute:/) { gsub(/^.*Mute: */, "", $j); m=$j }
        }
        if (cur == i) {
          mu = (m ~ /^yes$/) ? "MUTED" : ""
          print n "|" s "|" v "|" mu
        }
      }')
    IFS='|' read -r app_name app_sink app_vol app_mute <<< "$app_info"
    sname="${sink_map[$app_sink]:-$app_sink}"
    header="${_A}  ${app_name} [${app_vol}]${app_mute:+  ${_X}} → ${sname}"

    sel=$(printf '%s\n' \
      "${_S}  Switch device" \
      "$( [[ -n "$app_mute" ]] && echo "${_V}  Unmute" || echo "${_M}  Mute" )" \
      "25%" \
      "50%" \
      "75%" \
      "100%" \
      "${_P}  [${app_vol}]" \
      | $WMENUSH -p "$header" --format i) || true
    [[ -z "$sel" ]] && { page="main"; continue; }

    case "$sel" in
      0) target=$(pick_sink "Move to") || true
         [[ -n "$target" ]] && pactl move-sink-input "$id" "$target" ;;
      1) pactl set-sink-input-mute "$id" toggle ;;
      2) pactl set-sink-input-volume "$id" 25%   ;;
      3) pactl set-sink-input-volume "$id" 50%   ;;
      4) pactl set-sink-input-volume "$id" 75%   ;;
      5) pactl set-sink-input-volume "$id" 100%  ;;
      6) v=$(custom_vol_prompt "$app_vol") || true
         [[ -n "$v" && "$v" -ge 0 && "$v" -le 100 ]] 2>/dev/null && pactl set-sink-input-volume "$id" "${v}%"
         ;;
    esac
    ;;

  rec_app_menu:*)
    id="${page#*:}"
    app_info=$(pactl list source-outputs 2>/dev/null | awk -v i="$id" '
      BEGIN { RS=""; FS="\n" }
      /Source Output #[0-9]+/ {
        cur=""; n=""; s=""; v=""; m="no"
        for (j=1; j<=NF; j++) {
          if ($j ~ /Source Output #/) {
            gsub(/.*#/, "", $j); gsub(/[^0-9].*/, "", $j); cur=$j
          }
          if ($j ~ /application.name = ".*"/) {
            gsub(/.*application.name = "|".*/, "", $j); n=$j
            gsub(/^PipeWire ALSA \[|\]$/, "", n)
          }
          if ($j ~ /Source:/) { gsub(/^.*Source: */, "", $j); s=$j }
          if ($j ~ /Volume:/) { match($j, /[0-9]+%/); v=substr($j,RSTART,RLENGTH-1) }
          if ($j ~ /Mute:/) { gsub(/^.*Mute: */, "", $j); m=$j }
        }
        if (cur == i) {
          mu = (m ~ /^yes$/) ? "MUTED" : ""
          print n "|" s "|" v "|" mu
        }
      }')
    IFS='|' read -r app_name app_source app_vol app_mute <<< "$app_info"
    sname="${source_map[$app_source]:-$app_source}"
    header="${_APPREC}  ${app_name} [${app_vol}]${app_mute:+  ${_X}} ← ${sname}"

    sel=$(printf '%s\n' \
      "${_S}  Switch mic" \
      "$( [[ -n "$app_mute" ]] && echo "${_V}  Unmute" || echo "${_M}  Mute" )" \
      "25%" \
      "50%" \
      "75%" \
      "100%" \
      "${_P}  [${app_vol}]" \
      | $WMENUSH -p "$header" --format i) || true
    [[ -z "$sel" ]] && { page="main"; continue; }

    case "$sel" in
      0) target=$(pick_source "Move to") || true
         [[ -n "$target" ]] && pactl move-source-output "$id" "$target" ;;
      1) pactl set-source-output-mute "$id" toggle ;;
      2) pactl set-source-output-volume "$id" 25%   ;;
      3) pactl set-source-output-volume "$id" 50%   ;;
      4) pactl set-source-output-volume "$id" 75%   ;;
      5) pactl set-source-output-volume "$id" 100%  ;;
      6) v=$(custom_vol_prompt "$app_vol") || true
         [[ -n "$v" && "$v" -ge 0 && "$v" -le 100 ]] 2>/dev/null && pactl set-source-output-volume "$id" "${v}%"
         ;;
    esac
    ;;

esac

done
