#!/usr/bin/env bash
set -u
SOCKET="/run/user/$(id -u)/ncm-socket"
NCM_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/cm-media/ncm-daemon"
COVER="/tmp/cm-media-cover.jpg"
AVATAR_PATH="/tmp/ncm-daemon-avatar.jpg"
QR_IMG="/tmp/ncm-daemon-qr.png"
LOCAL_DIR="${1:-$HOME/Music}"

die() { echo "$1" >&2; exit 1; }

sock_send() {
    echo "$1" | socat -t 10 "UNIX-CONNECT:$SOCKET" -
}

MENU="tiny-cmenush -c $HOME/.config/tiny-cmenush/media.theme"
command -v tiny-cmenush >/dev/null 2>&1 || die "tiny-cmenush not found"

# ── MPRIS helpers ──

mpris_detect() {
    local names
    names=$(gdbus call --session \
        --dest org.freedesktop.DBus \
        --object-path /org/freedesktop/DBus \
        --method org.freedesktop.DBus.ListNames 2>/dev/null)
    for name in $(echo "$names" | grep -oP "org\.mpris\.MediaPlayer2\.\K[a-z0-9.]+"); do
        case $(mpris_get_prop "$name" PlaybackStatus 2>/dev/null) in *Playing*) echo "$name"; return ;; esac
    done
    echo "$names" | grep -oP "org\.mpris\.MediaPlayer2\.\K[a-z0-9.]+" | head -1
}

mpris_get_prop() {
    gdbus call --session \
        --dest "org.mpris.MediaPlayer2.$1" \
        --object-path /org/mpris/MediaPlayer2 \
        --method org.freedesktop.DBus.Properties.Get \
        org.mpris.MediaPlayer2.Player "$2" 2>/dev/null
}

mpris_call() {
    gdbus call --session \
        --dest "org.mpris.MediaPlayer2.$1" \
        --object-path /org/mpris/MediaPlayer2 \
        --method "org.mpris.MediaPlayer2.Player.$2" 2>/dev/null
}

mpris_meta_str() {
    local meta
    meta=$(mpris_get_prop "$1" "Metadata")
    echo "$meta" | sed "s/.*'$2': <'//;s/'>.*//" 2>/dev/null
}

mpris_meta_arr() {
    local meta
    meta=$(mpris_get_prop "$1" "Metadata")
    echo "$meta" | sed "s/.*'$2': <\[//;s/\].*>.*//;s/'//g" 2>/dev/null
}

mpris_get_cover() {
    local url
    url=$(mpris_meta_str "$1" "mpris:artUrl")
    case "$url" in
        file://*) echo "${url#file://}" ;;
        https://*) curl -sL --max-time 1 "$url" -o "$COVER" 2>/dev/null && echo "$COVER" ;;
    esac
}

# ── NetEase helpers ──

ncm_online() { [ -S "$SOCKET" ]; }

qr_login() {
    resp=$(sock_send '{"cmd":"exec","args":{"operation":"qr_login"}}')
    ok=$(echo "$resp" | jq -r '.ok')
    [ "$ok" = "true" ] || return

    unikey=$(echo "$resp" | jq -r '.unikey')
    url="https://music.163.com/login?codekey=$unikey"
    curl -s "https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=$url" -o "$QR_IMG"

    status_msg="Scan QR with NetEase app"
    while true; do
        sel=$(printf '\x00%s\n' "$status_msg" \
            | timeout 3 $MENU --no-input --format i -p "QR Login" \
                --bg "$QR_IMG" --bg-mode fit --bg-tint "#00000088" 2>/dev/null)
        if [ $? -ne 124 ] && [ -z "$sel" ]; then
            break
        fi

        code=$(sock_send "$(jq -n --arg uk "$unikey" \
            '{"cmd":"query","args":{"operation":"qr_status","unikey":$uk}}')" \
            | jq -r '.code // empty')

        [ -z "$code" ] && continue

        case "$code" in
            801) status_msg="Scan QR with NetEase app" ;;
            802) status_msg="Confirm on your phone..." ;;
            803) sock_send '{"cmd":"exec","args":{"operation":"refresh_useraccount"}}' >/dev/null
                 break ;;
            800) status_msg="Expired"
                 timeout 2 $MENU --no-input -p "Expired" \
                     --bg "$QR_IMG" --bg-mode fit --bg-tint "#00000088" 2>/dev/null || true
                 break ;;
        esac
    done

    rm -f "$QR_IMG"
}

search() {
    query=$(printf '\x00Type a search query\n' | $MENU --input-fallback -p "Search" 2>/dev/null)
    [ -n "$query" ] || return

    json=""
    for _ in 1 2 3; do
        json=$(sock_send "$(jq -n --arg kw "$query" '{"cmd":"query","args":{"operation":"search","keywords":$kw,"limit":20,"offset":0}}')")
        ok=$(echo "$json" | jq '.ok')
        [ "$ok" = "true" ] && break
        sleep 1
    done
    if [ "$ok" != "true" ]; then
        err=$(echo "$json" | jq -r '.error // "unknown"')
        printf '\x00%s\n' "Search: $err" | timeout 1.5 $MENU --no-input -p "Error" 2>/dev/null || true
        return
    fi

    mkdir -p "$NCM_CACHE"
    echo "$json" | jq -r '.data[] | [.trackid, "\(.title) - \(.artist | join(" / "))", .art_url] | @tsv' > "$NCM_CACHE/results.txt"
    [ -s "$NCM_CACHE/results.txt" ] || { echo "no results"; return; }

    while true; do
        sel=$(cut -f2 "$NCM_CACHE/results.txt" | $MENU -p "Results: $query" --format i)
        [ -n "$sel" ] || return

        line=$(sed -n "$((sel+1))p" "$NCM_CACHE/results.txt")
        id=$(echo "$line" | cut -f1)
        name=$(echo "$line" | cut -f2)
        resp=$(sock_send "$(jq -n --arg id "$id" '{"cmd":"exec","args":{"operation":"queue_add","trackid":$id}}')")
        idx=$(echo "$resp" | jq '.index')
        sock_send "$(jq -n --argjson i "$idx" '{"cmd":"exec","args":{"operation":"queue_play","index":$i}}')" > /dev/null
    done
}

playlists() {
    acct=$(sock_send '{"cmd":"query","args":{"operation":"user_account"}}')
    uid=$(echo "$acct" | jq -r '.userId // empty')
    [ -n "$uid" ] && [ "$uid" != "0" ] || return

    resp=$(sock_send "$(jq -n --argjson u "$uid" \
        '{"cmd":"query","args":{"operation":"user_playlists","uid":$u}}')")
    ok=$(echo "$resp" | jq -r '.ok // false')
    [ "$ok" = "true" ] || return

    mkdir -p "$NCM_CACHE"
    echo "$resp" | jq -r '.data[] | [.id, "\(.name) (\(.trackCount))"] | @tsv' > "$NCM_CACHE/playlists.txt"
    [ -s "$NCM_CACHE/playlists.txt" ] || return

    while true; do
        sel=$(cut -f2 "$NCM_CACHE/playlists.txt" | $MENU -p "Playlists" --format i)
        [ -n "$sel" ] || return

        line=$(sed -n "$((sel+1))p" "$NCM_CACHE/playlists.txt")
        pid=$(echo "$line" | cut -f1)

        action=$(printf '▶ Play\n▶ Play (Shuffle)\n➕ Add\n➕ Add (shuffle)' \
            | $MENU -p "Action" --format i)
        [ -n "$action" ] || continue

        case "$action" in
            0) sock_send "$(jq -n --argjson id "$pid" \
                '{"cmd":"exec","args":{"operation":"queue_add_playlist","id":$id,"replace":true,"shuffle":false}}')" > /dev/null
               sock_send '{"cmd":"exec","args":{"operation":"queue_play","index":0}}' > /dev/null ;;
            1) sock_send "$(jq -n --argjson id "$pid" \
                '{"cmd":"exec","args":{"operation":"queue_add_playlist","id":$id,"replace":true,"shuffle":true}}')" > /dev/null
               sock_send '{"cmd":"exec","args":{"operation":"queue_play","index":0}}' > /dev/null ;;
            2) sock_send "$(jq -n --argjson id "$pid" \
                '{"cmd":"exec","args":{"operation":"queue_add_playlist","id":$id,"replace":false,"shuffle":false}}')" > /dev/null ;;
            3) sock_send "$(jq -n --argjson id "$pid" \
                '{"cmd":"exec","args":{"operation":"queue_add_playlist","id":$id,"replace":false,"shuffle":true}}')" > /dev/null ;;
        esac
    done
}

# ── Local file browser ──

queue_add_local() {
    sock_send "$(jq -n --arg tid "local://$1" --arg t "$(basename "$1")" \
        '{"cmd":"exec","args":{"operation":"queue_add","trackid":$tid,"title":$t}}')" >/dev/null
}

local_play_file() {
    local resp idx
    resp=$(sock_send "$(jq -n --arg tid "local://$1" --arg t "$(basename "$1")" \
        '{"cmd":"exec","args":{"operation":"queue_add","trackid":$tid,"title":$t}}')")
    idx=$(echo "$resp" | jq '.index')
    [ -n "$idx" ] && [ "$idx" != "null" ] && \
        sock_send "$(jq -n --argjson i "$idx" '{"cmd":"exec","args":{"operation":"queue_play","index":$i}}')" >/dev/null
}

local_browser() {
    local dir="$1" start_dir="$dir"

    while true; do
        local ids=() labels=() files=()

        for f in "$dir"/*/; do
            [ -d "$f" ] || continue
            ids+=("$f")
            labels+=(" 󰉋 $(basename "$f") 󰅂")
        done

        for f in "$dir"/*; do
            [ -f "$f" ] || continue
            case "${f,,}" in *.mp3|*.flac|*.wav|*.aac)
                ids+=("$f")
                labels+=(" 󰎈 $(basename "$f")")
                files+=("$f") ;;
            esac
        done

        if [[ ${#ids[@]} -eq 0 ]]; then
            [[ "$dir" == "$start_dir" ]] && return
            dir="$(dirname "$dir")"; continue
        fi

        sel=$({
            if [[ ${#files[@]} -gt 0 ]]; then
                printf '󰐚 Add all\n'
            fi
            for label in "${labels[@]}"; do printf '%s\n' "$label"; done
        } | $MENU -p "$(basename "$dir")")

        [[ -z "$sel" ]] && { [[ "$dir" == "$start_dir" ]] && return; dir="$(dirname "$dir")"; continue; }

        [[ "$sel" == '󰐚 Add all' ]] && { for f in "${files[@]}"; do queue_add_local "$f"; done; continue; }

        local action=""
        for i in "${!labels[@]}"; do
            [[ "${labels[$i]}" == "$sel" ]] && { action="${ids[$i]}"; break; }
        done
        [[ -z "$action" ]] && continue

        [[ -d "$action" ]] && { dir="$action"; continue; }
        [[ -f "$action" ]] && { local_play_file "$action"; }
    done
}

# ── Main loop ──

[[ -n "${1:-}" ]] && { ncm_online || die "ncm-daemon not running"; local_browser "$LOCAL_DIR"; exit 0; }

while true; do
    MPRIS_PLAYER=$(mpris_detect)

    state=""
    title=""
    artist=""
    bg=""
    if [ -n "$MPRIS_PLAYER" ]; then
        raw_status=$(mpris_get_prop "$MPRIS_PLAYER" "PlaybackStatus")
        case "$raw_status" in *Playing*) state="playing" ;; *Paused*) state="paused" ;; *) state="stopped" ;; esac
        title=$(mpris_meta_str "$MPRIS_PLAYER" "xesam:title")
        artist=$(mpris_meta_arr "$MPRIS_PLAYER" "xesam:artist")
        cover_path=$(mpris_get_cover "$MPRIS_PLAYER")
        [ -n "$cover_path" ] && [ -f "$cover_path" ] && bg="--bg $cover_path --bg-mode cover --bg-tint #00000088"
    fi

    # Query current ncm song for Like/Trash and mode
    ncm_trackid=""
    ncm_liked=""
    playlist_mode="normal"
    fm_enabled="false"
    nickname=""
    if ncm_online; then
        cur=$(sock_send '{"cmd":"query","args":{"operation":"current_song"}}')
        ncm_trackid=$(echo "$cur" | jq -r '.data[0].trackid // empty')
        if [[ "$ncm_trackid" == ncm/* ]]; then
            ncm_liked=$(sock_send "$(jq -n --arg tid "$ncm_trackid" '{"cmd":"query","args":{"operation":"liked","trackid":$tid}}')" | jq -r '.liked // false')
        fi
        meta=$(sock_send '{"cmd":"query","args":{"operation":"playlist_meta"}}')
        playlist_mode=$(echo "$meta" | jq -r '.mode // "normal"')
        fm_enabled=$(echo "$meta" | jq -r '.fm // false')
        acct=$(sock_send '{"cmd":"query","args":{"operation":"user_account"}}')
        nickname=$(echo "$acct" | jq -r '.nickname // empty')
    fi

    # Build menu items (stable indices: 0=title, 1=artist, 2=PlayPause, 3=Next, 4=Prev, 5=Queue, 6=separator, 7=Login, 8=Search, 9=Playlists, 10=Local, 11=FM, 12=Mode, 13=Like, 14=Trash)
    sel=$({
        if [ -n "$title" ]; then
            printf '\x00\uf001 %s\x1c#b4befe\n' "$title"
            if [ -n "$artist" ]; then
                printf '\x00╰ %s\x1c#9399b2\n' "$artist"
            else
                printf '\x00\n'
            fi
        else
            printf '\x00\uf001\n'
            printf '\x00\n'
        fi

        if [ -z "$MPRIS_PLAYER" ]; then
            printf '\x00\uf04c\uf04b\x1d\n'
        elif [ "$state" = "playing" ]; then
            printf '\uf04c Pause\n'
        elif [ "$state" = "paused" ] || [ "$state" = "stopped" ]; then
            printf '\uf04b Play\n'
        else
            printf '\x00\uf04c\uf04b\x1d\n'
        fi

        if [ -z "$MPRIS_PLAYER" ]; then
            printf '\x00\uf04e Next\x1d\n'
        else
            printf '\uf04e Next\n'
        fi

        if [ -z "$MPRIS_PLAYER" ]; then
            printf '\x00\uf04a Prev\x1d\n'
        else
            printf '\uf04a Prev\n'
        fi

        if ncm_online; then
            qcount=$(sock_send '{"cmd":"query","args":{"operation":"playlist_medias","start":0,"end":0}}' | jq '.count // 0')
            if [ "$qcount" -gt 0 ] 2>/dev/null; then
                printf "\uf0ca Queue ($qcount)\n"
            else
                printf '\uf0ca Queue\n'
            fi
        else
            printf '\x00\uf0ca Queue\x1d\n'
        fi

        printf '\x00─── ncm ───\x1c#eba0ac\n'

        if ncm_online; then
            if [ -n "$nickname" ]; then
                if [ -s "$AVATAR_PATH" ]; then
                    printf '%s\x1f%s\x1c#a6e3a1\n' "$nickname" "$AVATAR_PATH"
                else
                    printf '%s\x1c#a6e3a1\n' "$nickname"
                fi
            else
                printf '\uf090 Login\x1c#a6e3a1\n'
            fi
            printf '\uf002 Search\n'
            printf '\uf00b Playlists\n'
            printf '\uf07c Local\n'
        else
            printf '\x00\uf090 Login\x1d\n'
            printf '\x00\uf002 Search\x1d\n'
            printf '\x00\uf00b Playlists\x1d\n'
            printf '\x00\uf07c Local\x1d\n'
        fi

        if [ "$fm_enabled" = "true" ]; then
            printf '\uf1eb FM On\n'
        else
            printf '\uf1eb FM Off\n'
        fi

        case "$playlist_mode" in
            loop)    printf '\uf01e Loop\n' ;;
            shuffle) printf '\uf074 Shuffle\n' ;;
            repeat)  printf '\uf2f9 Repeat\n' ;;
            *)       printf 'Normal\n' ;;
        esac

        if [ -n "$ncm_liked" ]; then
            if [ "$ncm_liked" = "true" ]; then
                printf '\uf004 Unlike\n'
            else
                printf '\uf08a Like\n'
            fi
            printf '\uf1f8 Trash\n'
        else
            printf '\x00\uf08a Like\x1d\n'
            printf '\x00\uf1f8 Trash\x1d\n'
        fi
    } | $MENU --no-input --format i -p "cm-media" $bg --thumb-width 32)

    [ -z "$sel" ] && exit 0

    case "$sel" in
        0|1) ;;
        2) [ -n "$MPRIS_PLAYER" ] || continue
            if [ "$state" = "playing" ]; then
                mpris_call "$MPRIS_PLAYER" Pause
            else
                mpris_call "$MPRIS_PLAYER" Play
            fi ;;
        3) ncm_online || continue
            sock_send '{"cmd":"exec","args":{"operation":"next_song"}}' > /dev/null ;;
        4) ncm_online || continue
            sock_send '{"cmd":"exec","args":{"operation":"prev_song"}}' > /dev/null ;;
        5) ncm_online || continue
            json=$(sock_send '{"cmd":"query","args":{"operation":"playlist_medias","start":0,"end":9999}}')
            total=$(echo "$json" | jq '.count // 0')
            echo "$json" | jq -r '.data | to_entries[] | [.key, .value.trackid, "\(.value.title) - \(.value.artist // ["?"] | join("/"))"] | @tsv' > "$NCM_CACHE/queue.txt"
            [ -s "$NCM_CACHE/queue.txt" ] || continue
            qsel=$(cut -f3 "$NCM_CACHE/queue.txt" | $MENU -p "Queue" --format i)
            [ -z "$qsel" ] && continue
            sock_send "$(jq -n --argjson i "$qsel" '{"cmd":"exec","args":{"operation":"queue_play","index":$i}}')" > /dev/null ;;
        6) ;; # separator
        7) ncm_online || continue
            if [ -z "$nickname" ]; then
                qr_login
            fi ;;
        8) ncm_online || continue; search ;;
        9) ncm_online || continue; playlists ;;
        10) ncm_online || continue; local_browser "$HOME/Music" ;;
        11) ncm_online || continue
            sock_send '{"cmd":"exec","args":{"operation":"set_fm"}}' > /dev/null ;;
        12) ncm_online || continue
            case "$playlist_mode" in
                normal)  next="loop" ;;
                loop)    next="shuffle" ;;
                shuffle) next="repeat" ;;
                repeat)  next="normal" ;;
            esac
            sock_send "$(jq -n --arg m "$next" '{"cmd":"exec","args":{"operation":"set_mode","mode":$m}}')" > /dev/null ;;
        13) ncm_online || continue
            [ -z "$ncm_trackid" ] && continue
            if [ "$ncm_liked" = "true" ]; then
                sock_send "$(jq -n --arg tid "$ncm_trackid" '{"cmd":"exec","args":{"operation":"like","trackid":$tid,"liked":false}}')" > /dev/null
            else
                sock_send "$(jq -n --arg tid "$ncm_trackid" '{"cmd":"exec","args":{"operation":"like","trackid":$tid,"liked":true}}')" > /dev/null
            fi ;;
        14) ncm_online || continue
            sock_send '{"cmd":"exec","args":{"operation":"fm_trash"}}' > /dev/null ;;
    esac
done
