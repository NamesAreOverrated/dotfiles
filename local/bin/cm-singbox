#!/usr/bin/env bash
set -u

CONFIG_DIR="$HOME/.config/cm-singbox"
SUBS_FILE="$CONFIG_DIR/subs"
CACHE_DIR="$CONFIG_DIR/cache"
PIDFILE="$CONFIG_DIR/pid"
API_BASE="${API_BASE:-http://127.0.0.1:9090}"
SELECTOR_TAG="${SELECTOR_TAG:-Proxy}"
SB_CONFIG="${SB_CONFIG:-$HOME/.config/sing-box/config.json}"

mkdir -p "$CONFIG_DIR" "$CACHE_DIR"

_WM="tiny-cmenush"

e() { echo "$@"; }

sb_pid() {
  local p
  [[ -f "$PIDFILE" ]] && { p=$(cat "$PIDFILE" 2>/dev/null); [[ -n "$p" ]] && kill -0 "$p" 2>/dev/null && { e "$p"; return; }; rm -f "$PIDFILE"; }
  p=$(pgrep -x sing-box 2>/dev/null | tail -1)
  [[ -n "$p" ]] && e "$p"
}

api_get() { curl -sf "$API_BASE$1" 2>/dev/null; }

current_node() {
  sb_pid >/dev/null || { e "stopped"; return; }
  local data
  data=$(api_get "/proxies/$SELECTOR_TAG" 2>/dev/null) || { e "API error"; return; }
  e "$data" | grep -oP '"now":[[:space:]]*"[^"]*"' | cut -d'"' -f4
}

b64d() {
  local s="$1"
  s=$(echo "$s" | tr -- '-_' '+/')
  local pad=$(( (4 - ${#s} % 4) % 4 ))
  while (( pad-- > 0 )); do s+="="; done
  base64 -d <<< "$s" 2>/dev/null
}

parse_vmess() {
  local raw tag pb64 json ps addr port aid
  raw="${1#vmess://}"
  tag="$2"

  if echo "$raw" | grep -qE '^[A-Za-z0-9+/=]+$'; then
    pb64=1
  else
    pb64=0
  fi

  if (( pb64 )); then
    json=$(b64d "$raw") || return 1
  else
    json="$raw"
  fi

  ps=$(echo "$json" | jq -r '.ps // empty' 2>/dev/null)
  addr=$(echo "$json" | jq -r '.add // .server // empty' 2>/dev/null)
  port=$(echo "$json" | jq -r '.port // empty' 2>/dev/null)
  aid=$(echo "$json" | jq -r '.aid // 0' 2>/dev/null)

  [[ -z "$ps" ]] && ps="vmess-${addr}"
  [[ -z "$addr" ]] && return 1
  [[ -z "$port" ]] && port="443"

  local name="${ps%%@*}"
  local tag_out="${name}-${tag}@${addr}:${port}"
  jq -n --arg tag "$tag_out" --arg server "$addr" --argjson port "$((port))" \
    --arg uuid "$(echo "$json" | jq -r '.id // empty')" \
    --arg aid "$(echo "$json" | jq -r '.aid // "0"')" \
    '{type: "vmess", tag: $tag, server: $server, server_port: $port, uuid: $uuid, alter_id: ($aid | tonumber)}'
}

parse_ss() {
  local raw b64_info fragment info tag
  raw="${1#ss://}"
  tag="$2"

  b64_info="${raw%%#*}"
  fragment="${raw#*#}"

  info=$(b64d "$b64_info") || return 1

  local auth_part addr_part method password host port name_number
  auth_part="${info%%@*}"
  addr_part="${info#*@}"

  method="${auth_part%%:*}"
  password="${auth_part#*:}"

  host="${addr_part%%:*}"
  port="${addr_part##*:}"

  name_number="${fragment%%@*}"

  [[ -z "$host" || -z "$port" || -z "$name_number" ]] && return 1

  local tag_out="${fragment}"
  jq -n --arg tag "$tag_out" --arg server "$host" --argjson port "$((port))" \
    --arg method "$method" --arg password "$password" \
    '{type: "shadowsocks", tag: $tag, server: $server, server_port: $port, method: $method, password: $password}'
}

parse_trojan() {
  local raw rest info host_port password host port name_number tag
  raw="${1#trojan://}"
  tag="$2"

  rest="${raw#*@}"
  info="${raw%%@*}"

  password="${info%%#*}"
  host_port="${rest%%#*}"
  name_number="${rest#*#}"
  host="${host_port%%:*}"
  port="${host_port##*:}"

  [[ -z "$host" || -z "$port" ]] && return 1

  local tag_out="${name_number}@${host}:${port}"
  jq -n --arg tag "$tag_out" --arg server "$host" --argjson port "$((port))" \
    --arg password "$password" \
    '{type: "trojan", tag: $tag, server: $server, server_port: $port, password: $password}'
}

parse_hy2() {
  local raw rest host_port password host port name_number tag
  raw="${1#hysteria2://}"
  tag="$2"

  rest="${raw#*@}"
  info="${raw%%@*}"

  password="${info%%#*}"
  host_port="${rest%%#*}"
  name_number="${rest#*#}"
  host="${host_port%%:*}"
  port="${host_port##*:}"

  [[ -z "$host" || -z "$port" ]] && return 1

  local tag_out="${name_number}@${host}:${port}"
  jq -n --arg tag "$tag_out" --arg server "$host" --argjson port "$((port))" \
    --arg password "$password" \
    '{type: "hysteria2", tag: $tag, server: $server, server_port: $port, password: $password}'
}

build_outbounds() {
  local nodes
  nodes=$(cat) || return 1
  [[ -z "$nodes" || "$nodes" == "null" ]] && return 1

  local selector
  selector=$(jq -n --arg tag "$SELECTOR_TAG" '[{type: "selector", tag: $tag, outbounds: []}]')

  local result="$selector"
  while IFS= read -r node; do
    [[ -z "$node" ]] && continue
    result=$(echo "$result" | jq --argjson node "$node" '
      .[0].outbounds += [$node.tag] | . += [$node]
    ')
  done < <(echo "$nodes" | jq -c '.[]')

  local direct
  direct=$(jq -n '[{type: "direct", tag: "direct"}, {type: "block", tag: "block"}]')
  echo "$result" | jq --argjson dir "$direct" '. + $dir'
}

apply_outbounds() {
  local obs="$1"
  [[ -f "$SB_CONFIG" ]] || { e "Config not found: $SB_CONFIG"; return 1; }
  local tmp; tmp=$(mktemp)
  jq --argjson obs "$obs" '.outbounds = $obs' "$SB_CONFIG" > "$tmp" && mv "$tmp" "$SB_CONFIG"
}

list_nodes() {
  local sel
  sel=$(api_get "/proxies/$SELECTOR_TAG" 2>/dev/null) || return 1
  e "$sel" | jq -r '.all[]' 2>/dev/null
}

fetch_sub() {
  local idx="$1" name="$2" url="$3"
  local raw
  raw=$(curl -sf "$url" 2>/dev/null) || { e "Failed to fetch $name"; return 1; }
  echo "$raw" > "$CACHE_DIR/$idx.raw"

  if ! grep -qE '^(vmess|ss|trojan|hysteria2)://' "$CACHE_DIR/$idx.raw" 2>/dev/null; then
    local decoded
    decoded=$(b64d "$raw" 2>/dev/null) && {
      echo "$decoded" > "$CACHE_DIR/$idx.raw"
    }
  fi

  local nodes_json=""
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    local parsed=""
    case "$line" in
      vmess://*) parsed=$(parse_vmess "$line" "$idx") ;;
      ss://*)    parsed=$(parse_ss "$line" "$idx") ;;
      trojan://*) parsed=$(parse_trojan "$line" "$idx") ;;
      hysteria2://*) parsed=$(parse_hy2 "$line" "$idx") ;;
    esac
    [[ -n "$parsed" ]] && nodes_json="${nodes_json}${nodes_json:+,}${parsed}"
  done < "$CACHE_DIR/$idx.raw"

  if [[ -z "$nodes_json" ]]; then
    rm -f "$CACHE_DIR/$idx.raw"
    return 1
  fi

  echo "[$nodes_json]" > "$CACHE_DIR/$idx.nodes"
  local node_count; node_count=$(echo "[$nodes_json]" | jq length)
  e "OK: $node_count nodes from $name"
}

apply_sub() {
  local idx="$1" name="$2"
  local node_file="$CACHE_DIR/$idx.nodes"
  [[ -f "$node_file" ]] || { e "No cached nodes for $name"; return 1; }

  local obs
  obs=$(cat "$node_file" | build_outbounds) || return 1
  apply_outbounds "$obs" || return 1

  local count; count=$(jq length "$CACHE_DIR/$idx.nodes" 2>/dev/null || echo 0)
  e "Applied $count nodes from $name"
}

node_count() {
  sb_pid >/dev/null || { echo 0; return; }
  api_get "/proxies/$SELECTOR_TAG" | jq '.all | length' 2>/dev/null || echo 0
}

refetch_all() {
  [[ -f "$SUBS_FILE" ]] || { e "No subscriptions"; return; }
  local c=0
  while IFS='|' read -r name format url; do
    [[ -z "$name" ]] && continue
    local idx
    idx=$(echo "$name" | md5sum 2>/dev/null | cut -c1-8)
    [[ -z "$idx" ]] && idx=$(echo "$name" | cksum | cut -d' ' -f1)
    fetch_sub "$idx" "$name" "$url" && apply_sub "$idx" "$name" && c=$((c + 1))
  done < "$SUBS_FILE"
  (( c > 0 )) && sb_pid >/dev/null && sb_restart
  e "Refetched $c subscriptions"
}

sb_start() {
  sb_pid >/dev/null && { e "Already running"; return; }
  sudo -v || return 1
  sudo sing-box run -c "$SB_CONFIG" -D "$(dirname "$SB_CONFIG")" >/dev/null 2>&1 &
  local i=0
  while (( i < 30 )); do
    sleep 0.2; i=$((i + 1))
    sb_pid >/dev/null && { e "$(sb_pid)" > "$PIDFILE"; e "Started"; return; }
  done
  e "Failed to start"; return 1
}

sb_stop() {
  sb_pid >/dev/null || { e "Not running"; return; }
  sudo -v || return 1
  sudo pkill -x sing-box 2>/dev/null; rm -f "$PIDFILE"
  local i=0
  while sb_pid >/dev/null && (( i < 30 )); do
    sleep 0.2; i=$((i + 1))
  done
  sb_pid >/dev/null && { e "Failed to stop"; return 1; }
  e "Stopped"
}

sb_restart() { sb_stop; sleep 0.5; sb_start; }

sub_menu() {
  local idx="$1" name="$2" url="$3"
  while true; do
    local ids=() labels=()
    ids+=("__apply__");    labels+=("󰓦  Fetch & apply nodes")
    ids+=("__edit_url__"); labels+=("󰏫  Edit URL")
    ids+=("__edit_name__"); labels+=("󰏫  Edit name")

    local sel
    sel=$(for i in "${!labels[@]}"; do printf '%s\n' "${labels[$i]}"; done \
      | $_WM -p "$name" --format i)
    [[ -z "$sel" ]] && return

    local act="${ids[$sel]:-}"
    [[ -z "$act" ]] && continue

    case "$act" in
      __apply__)
        fetch_sub "$idx" "$name" "$url" && {
          apply_sub "$idx" "$name"
          sb_pid >/dev/null && sb_restart
        }
        local count; count=$(node_count)
        e "Total nodes: $count"
        ;;
      __edit_url__)
        local new
        new=$(printf '\x00%s\n' "$url" | $_WM -p "URL" --pfill "$url" --input-fallback --lines 0)
        [[ -z "$new" ]] && continue
        awk -F'|' -v n="$name" -v u="$new" 'BEGIN{OFS="|"} $1==n {$3=u}1' "$SUBS_FILE" > "${SUBS_FILE}.tmp" && mv "${SUBS_FILE}.tmp" "$SUBS_FILE"
        url="$new"
        ;;
      __edit_name__)
        local new
        new=$(printf '\x00%s\n' "$name" | $_WM -p "Name" --pfill "$name" --input-fallback --lines 0)
        [[ -z "$new" ]] && continue
        local new_idx
        new_idx=$(echo "$new" | md5sum 2>/dev/null | cut -c1-8)
        [[ -z "$new_idx" ]] && new_idx=$(echo "$new" | cksum | cut -d' ' -f1)
        for f in "$CACHE_DIR/$idx".*; do
          [[ -f "$f" ]] && mv "$f" "$CACHE_DIR/$new_idx.${f##*.}"
        done
        awk -F'|' -v o="$name" -v n="$new" 'BEGIN{OFS="|"} $1==o {$1=n}1' "$SUBS_FILE" > "${SUBS_FILE}.tmp" && mv "${SUBS_FILE}.tmp" "$SUBS_FILE"
        idx="$new_idx"
        name="$new"
        ;;
    esac
  done
}

lan_config() {
  local f="$CONFIG_DIR/lan"
  local state=0 port=1080
  [[ -f "$f" ]] && { source "$f"; }
  e "state=$state"
  e "port=$port"
}

lan_on() {
  local state port
  while IFS='=' read -r k v; do
    case "$k" in
      state) state="$v" ;;
      port)  port="$v" ;;
    esac
  done < <(lan_config)
  [[ "$state" == "1" ]] && return 0 || return 1
}

lan_apply() {
  local port
  port=$(lan_config | grep ^port= | cut -d= -f2)
  [[ -z "$port" ]] && port=1080

  local listen="127.0.0.1"
  lan_on && listen="0.0.0.0"

  local tmp; tmp=$(mktemp)
  jq --arg tag "mixed" --arg listen "$listen" --argjson port "$port" '
    .inbounds = ([.inbounds[] | select(.tag != "mixed")] + [{type: "mixed", tag: $tag, listen: $listen, listen_port: $port}])
  ' "$SB_CONFIG" > "$tmp" && mv "$tmp" "$SB_CONFIG"
}

lan_submenu() {
  while true; do
    local ids=() labels=()
    local state_str="OFF"; lan_on && state_str="ON"
    local port; port=$(lan_config | grep ^port= | cut -d= -f2)
    [[ -z "$port" ]] && port=1080

    ids+=("__toggle__"); labels+=("🌐  LAN proxy: $state_str")
    ids+=("__port__");   labels+=("🔧  Port: $port")

    local sel
    sel=$(for i in "${!labels[@]}"; do printf '%s\n' "${labels[$i]}"; done \
      | $_WM -p "LAN" --format i)
    [[ -z "$sel" ]] && return

    local act="${ids[$sel]:-}"
    [[ -z "$act" ]] && continue

    case "$act" in
      __toggle__)
        local state port
        while IFS='=' read -r k v; do
          case "$k" in
            state) state="$v" ;;
            port)  port="$v" ;;
          esac
        done < <(lan_config)
        [[ "$state" == "1" ]] && state=0 || state=1
        printf 'state=%s\nport=%s\n' "$state" "$port" > "$CONFIG_DIR/lan"
        lan_apply
        sb_pid >/dev/null && sb_restart
        ;;
      __port__)
        local new
        new=$(printf '\x00Port\n' | $_WM -p "Port" --pfill "$port" --input-fallback --lines 0)
        [[ -z "$new" ]] && continue
        local state
        state=$(lan_config | grep ^state= | cut -d= -f2)
        printf 'state=%s\nport=%s\n' "${state:-0}" "$new" > "$CONFIG_DIR/lan"
        lan_apply
        sb_pid >/dev/null && sb_restart
        ;;
    esac
  done
}

nodes_submenu() {
  while true; do
    local ids=() labels=()
    local current=""
    sb_pid >/dev/null && current=$(current_node)
    for f in "$CACHE_DIR"/*.nodes; do
      [[ -f "$f" ]] || continue
      while IFS= read -r node; do
        [[ -z "$node" ]] && continue
        local tag type
        tag=$(echo "$node" | jq -r '.tag // empty' 2>/dev/null)
        type=$(echo "$node" | jq -r '.type // empty' 2>/dev/null)
        [[ -z "$tag" ]] && continue
        local mark="  "
        [[ "$tag" == "$current" ]] && mark="󰗠 "
        ids+=("node:$tag"); labels+=("${mark}${type}  $tag")
      done < <(jq -c '.[]' "$f" 2>/dev/null)
    done

    local sel
    sel=$(for i in "${!labels[@]}"; do printf '%s\n' "${labels[$i]}"; done \
      | $_WM -p "Nodes" --format i)
    [[ -z "$sel" ]] && return

    local act="${ids[$sel]:-}"
    [[ -z "$act" ]] && continue

    case "$act" in
      node:*)
        local tag="${act#node:}"
        [[ -z "$tag" ]] && continue
        sb_pid >/dev/null || { e "Start sing-box first"; continue; }
        local data
        data=$(api_get "/proxies/$SELECTOR_TAG" 2>/dev/null) || { e "API error"; continue; }
        local groups
        groups=$(jq -r --arg tag "$tag" '.all[] as $g | select(.type == "Selector") | select(.now == $tag) | $g' <<< "$data" 2>/dev/null)
        if [[ -n "$groups" ]]; then
          while IFS= read -r group; do
            curl -s -X PUT "$API_BASE/proxies/$group" -H "Content-Type: application/json" -d "{\"name\":\"$tag\"}" >/dev/null 2>&1
          done <<< "$groups"
          e "Switched to $tag"
        else
          local url_encoded; url_encoded=$(jq -rn --arg x "$tag" '$x | @uri')
          curl -s -X PUT "$API_BASE/proxies/$SELECTOR_TAG" -H "Content-Type: application/json" -d "{\"name\":\"$tag\"}" >/dev/null 2>&1
          e "Switched to $tag"
        fi
        ;;
    esac
  done
}

subs_submenu() {
  while true; do
    local ids=() labels=()
    ids+=("__import__"); labels+=("󰐚  Import subscription")

    if [[ -f "$SUBS_FILE" ]]; then
      while IFS='|' read -r name format url; do
        [[ -z "$name" ]] && continue
        local idx; idx=$(echo "$name" | md5sum 2>/dev/null | cut -c1-8)
        [[ -z "$idx" ]] && idx=$(echo "$name" | cksum | cut -d' ' -f1)
        local count=0
        [[ -f "$CACHE_DIR/$idx.nodes" ]] && count=$(jq length "$CACHE_DIR/$idx.nodes" 2>/dev/null || echo 0)
        ids+=("sub:$idx:$name"); labels+=("$name  ($count nodes)")
      done < "$SUBS_FILE"
    fi

    local sel
    sel=$(for i in "${!labels[@]}"; do printf '%s\n' "${labels[$i]}"; done \
      | $_WM -p "Subscriptions" --format i)
    [[ -z "$sel" ]] && return

    local act="${ids[$sel]:-}"
    [[ -z "$act" ]] && continue

    case "$act" in
      __import__)
        local name url
        name=$(printf '\x00\n' | $_WM -p "Sub name" --input-fallback --lines 0)
        [[ -z "$name" ]] && continue
        url=$(printf '\x00https://\n' | $_WM -p "Sub URL" --pfill "https://" --input-fallback --lines 0)
        [[ -z "$url" ]] && continue
        echo "$name|auto|$url" >> "$SUBS_FILE"
        chmod 600 "$SUBS_FILE"
        e "Imported $name"
        ;;
      sub:*:*)
        local rest="${act#sub:}"
        local idx="${rest%%:*}"
        local name="${rest#*:}"
        local sub_url
        sub_url=$(grep "^${name}|" "$SUBS_FILE" 2>/dev/null | cut -d'|' -f3)
        [[ -z "$sub_url" ]] && continue
        sub_menu "$idx" "$name" "$sub_url"
        ;;
    esac
  done
}

select_idx=""
while true; do
  ids=() labels=()

  running=""; sb_pid >/dev/null && running=1
  count=$(node_count 2>/dev/null || echo 0)
  sub_count=0
  [[ -f "$SUBS_FILE" ]] && sub_count=$(wc -l < "$SUBS_FILE")
  current=""
  [[ -n "$running" ]] && current=$(current_node)
  [[ -z "$current" ]] && current="Stopped"

  if [[ -n "$running" ]]; then
    ids+=("__toggle__"); labels+=("⏹  Stop")
  else
    ids+=("__toggle__"); labels+=("󰐚  Start")
  fi

  ids+=("__nodes__"); labels+=("󰖩  $current  [$count]")
  ids+=("__lan__");   labels+=("󰒑  LAN [$(lan_on && echo ON || echo OFF)]")

  ids+=("__sep1__"); labels+=("")

  ids+=("__refetch__"); labels+=("󰑐  Refetch all")
  ids+=("__subs__");   labels+=("󰓦  Subscriptions [${sub_count}]")

  ids+=("__sep2__"); labels+=("")

  ids+=("__purge__"); labels+=("󰅖  Purge all")

  sel=$(for i in "${!labels[@]}"; do
    case "${ids[$i]}" in
      __sep1__|__sep2__) printf '\x00───\n' ;;
      *) printf '%s\n' "${labels[$i]}" ;;
    esac
  done | $_WM -p "Sing-box" --format i ${select_idx:+--select $select_idx})
  [[ -z "$sel" ]] && exit 0
  select_idx="$sel"

  action="${ids[$sel]:-}"
  [[ -z "$action" ]] && continue

  case "$action" in
    __sep1__|__sep2__) continue ;;

    __toggle__)
      if [[ -n "$running" ]]; then sb_stop; else sb_start; fi
      ;;

    __nodes__)
      nodes_submenu
      ;;

    __lan__)
      lan_submenu
      ;;

    __refetch__)
      refetch_all
      ;;

    __subs__)
      subs_submenu
      ;;

    __purge__)
      resp=$(printf 'Yes\nNo' | $_WM -p "Purge all?" --format i)
      [[ -z "$resp" || "$resp" != "0" ]] && continue
      rm -f "$SUBS_FILE"; rm -rf "$CACHE_DIR"/*
      mkdir -p "$CACHE_DIR"
      obs=$(jq -n '[{type: "direct", tag: "direct"}, {type: "block", tag: "block"}]')
      apply_outbounds "$obs"
      e "Purged"
      ;;
  esac
done
