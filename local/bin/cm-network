#!/usr/bin/env bash
set -u

_WM="tiny-cmenush"

signal_bars() {
  local s=$1
  if   (( s >= 80 )); then echo "󰤨"
  elif (( s >= 60 )); then echo "󰤥"
  elif (( s >= 40 )); then echo "󰤢"
  elif (( s >= 20 )); then echo "󰤟"
  else                     echo "󰤯"
  fi
}

wifi_connect() {
  local ssid="$1" pw="$2" err rc
  if [[ -n "$pw" ]]; then
    err=$(nmcli device wifi connect "$ssid" password "$pw" 2>&1)
  else
    err=$(nmcli device wifi connect "$ssid" 2>&1)
  fi
  rc=$?
  if [[ $rc -ne 0 ]]; then
    printf '\x00Connection failed\n%s\nDismiss\n' "$err" \
      | $_WM -p "Error" --no-input --format i --lines 3 || true
  fi
}

proxy_host() {
  local a; a=$(sed -n '1p' "$HOME/.config/cm-network" 2>/dev/null)
  echo "${a%:*}" ; }
proxy_port() {
  local a; a=$(sed -n '1p' "$HOME/.config/cm-network" 2>/dev/null)
  local p="${a#*:}"
  [[ "$p" != "$a" ]] && echo "$p" || echo "10808"
}
proxy_addr() { echo "$(proxy_host):$(proxy_port)"; }
proxy_on()   { [[ $(sed -n '2p' "$HOME/.config/cm-network" 2>/dev/null) == "1" ]]; }
proxy_write() {
  local host="$1" port="$2"
  local state no_proxy_val
  mkdir -p "$HOME/.config"
  state=$(sed -n '2p' "$HOME/.config/cm-network" 2>/dev/null)
  no_proxy_val=$(sed -n '3p' "$HOME/.config/cm-network" 2>/dev/null)
  [[ -z "$state" ]] && state="0"
   [[ -z "$no_proxy_val" ]] && no_proxy_val="localhost,127.0.0.1,::1,.163.com,.music.126.net"
  printf '%s\n%s\n%s\n' "$host:$port" "$state" "$no_proxy_val" > "$HOME/.config/cm-network"
}
proxy_toggle() {
  mkdir -p "$HOME/.config"
  local addr state no_proxy_val
  addr=$(sed -n '1p' "$HOME/.config/cm-network" 2>/dev/null)
  state=$(sed -n '2p' "$HOME/.config/cm-network" 2>/dev/null)
  no_proxy_val=$(sed -n '3p' "$HOME/.config/cm-network" 2>/dev/null)
  [[ -z "$addr" ]] && addr="localhost:10808"
   [[ -z "$no_proxy_val" ]] && no_proxy_val="localhost,127.0.0.1,::1,.163.com,.music.126.net"
  if [[ "$state" == "1" ]]; then
    printf '%s\n0\n%s\n' "$addr" "$no_proxy_val" > "$HOME/.config/cm-network"
  else
    printf '%s\n1\n%s\n' "$addr" "$no_proxy_val" > "$HOME/.config/cm-network"
  fi
}

proxy_noproxy_menu() {
  while true; do
    local np
    np=$(sed -n '3p' "$HOME/.config/cm-network" 2>/dev/null)
    [[ -z "$np" ]] && np="localhost,127.0.0.1,::1"

    local -a sub_ids=() sub_labels=()
    sub_ids+=("__noproxy_add__"); sub_labels+=("󰐚  Add entry")
    IFS=',' read -ra entries <<< "$np"
    if [[ ${#entries[@]} -gt 0 ]]; then
      for entry in "${entries[@]}"; do
        sub_ids+=("__noproxy_del__:${entry}"); sub_labels+=("󰅖  ${entry}")
      done
    fi

    local sel
    sel=$(for i in "${!sub_ids[@]}"; do printf '%s\n' "${sub_labels[$i]}"; done \
      | $_WM -p "No proxy" --format i)
    [[ -z "$sel" ]] && return

    local act="${sub_ids[$sel]:-}"
    [[ -z "$act" ]] && continue

    case "$act" in
      __noproxy_add__)
        local new
        new=$(printf '\x00hostname\n' | $_WM -p "Add no proxy entry" --input-fallback --lines 0)
        [[ -z "$new" ]] && continue
        local host port state
        host="$(proxy_host)"; port="$(proxy_port)"
        state="$(sed -n '2p' "$HOME/.config/cm-network" 2>/dev/null)"
        local new_np="${np:+"${np},"}${new}"
        printf '%s:%s\n%s\n%s\n' "$host" "$port" "${state:-0}" "$new_np" > "$HOME/.config/cm-network"
        ;;
      __noproxy_del__:*)
        local entry="${act#__noproxy_del__:}"
        local host port state
        host="$(proxy_host)"; port="$(proxy_port)"
        state="$(sed -n '2p' "$HOME/.config/cm-network" 2>/dev/null)"
        local new_np
        new_np=$(echo "$np" | tr ',' '\n' | grep -vFx "$entry" | paste -sd, -)
        printf '%s:%s\n%s\n%s\n' "$host" "$port" "${state:-0}" "$new_np" > "$HOME/.config/cm-network"
        ;;
    esac
  done
}

wifi_submenu() {
  local wifi_device connected_ssid
  wifi_device=$(nmcli -t -f DEVICE,TYPE device status 2>/dev/null | grep ':wifi$' | cut -d: -f1 | head -1)
  [[ -z "$wifi_device" ]] && return

  while true; do
    local -a sub_ids=() sub_labels=()
    local sel act wifi_list
    wifi_list=$(nmcli -t -f IN-USE,SSID,SIGNAL,SECURITY dev wifi 2>/dev/null | sort -t: -k3 -rn)
    connected_ssid=$(printf '%s\n' "$wifi_list" | grep '^\*' | cut -d: -f2 | head -1)

    while IFS=$'\n' read -r line; do
      [[ -z "$line" || "$line" == *"SSID"* ]] && continue
      inuse=$(echo "$line" | cut -d: -f1)
      ssid=$(echo "$line" | cut -d: -f2)
      signal=$(echo "$line" | cut -d: -f3)
      sec=$(echo "$line" | cut -d: -f4-)
      [[ -z "$ssid" ]] && continue
      bars=$(signal_bars "$signal")
      mark="  "; [[ "$inuse" == "*" ]] && mark="󰗠 "
      lock=""; [[ -n "$sec" && "$sec" != "--" ]] && lock="󰌾 "
      sub_ids+=("net:$ssid"); sub_labels+=("${mark}${bars}  ${lock}${ssid}  (${signal}%)")
    done <<< "$wifi_list"
    sub_ids+=("__rescan__"); sub_labels+=("󰑐  Rescan")

    sel=$(for i in "${!sub_ids[@]}"; do printf '%s\n' "${sub_labels[$i]}"; done \
      | $_WM -p "WiFi" --format i)
    [[ -z "$sel" ]] && return

    act="${sub_ids[$sel]:-}"
    [[ -z "$act" ]] && continue

    case "$act" in
      __rescan__)
        nmcli device wifi rescan 2>/dev/null || true
        sleep 2
        ;;
      net:*)
        ssid="${act#net:}"
        if [[ "$ssid" == "$connected_ssid" ]]; then
          local -a disc_ids=() disc_labels=()
          local dsel
          disc_ids+=("__disconnect__"); disc_labels+=("󰅖  Disconnect")
          disc_ids+=("__cancel__"); disc_labels+=("󰌺  Cancel")
          dsel=$(for i in "${!disc_ids[@]}"; do printf '%s\n' "${disc_labels[$i]}"; done \
            | $_WM -p "${ssid}" --format i)
          [[ -z "$dsel" ]] && continue
          if [[ "${disc_ids[$dsel]:-}" == "__disconnect__" ]]; then
            local derr drc
            derr=$(nmcli device disconnect "$wifi_device" 2>&1)
            drc=$?
            if [[ $drc -ne 0 ]]; then
              printf '\x00Disconnect failed\n%s\nDismiss\n' "$derr" \
                | $_WM -p "Error" --no-input --format i --lines 3 || true
            fi
          fi
          continue
        fi
        sec=$(printf '%s\n' "$wifi_list" | grep -F ":${ssid}:" | head -1 | cut -d: -f4-)
        sec="${sec#:}"
        if [[ -z "$sec" || "$sec" == "--" ]]; then
          wifi_connect "$ssid" ""
        else
          pw=$(printf '\x00Enter password\n' | $_WM -p "Password for ${ssid}" -P --input-fallback --lines 0)
          [[ -z "$pw" ]] && continue
          wifi_connect "$ssid" "$pw"
        fi
        ;;
    esac
  done
}

select_idx=""
while true; do
  ids=() labels=()

  # ── Networking info ──
  wifi_device=$(nmcli -t -f DEVICE,TYPE device status 2>/dev/null | grep ':wifi$' | cut -d: -f1 | head -1)

  net_on=$(nmcli networking 2>/dev/null)

  # ── Connection info ──
  current_line=$(nmcli -t -f DEVICE,STATE,CONNECTION device status 2>/dev/null | grep ':connected:' | head -1)
  current_device=$(echo "$current_line" | cut -d: -f1)
  current_conn=$(echo "$current_line" | cut -d: -f3)
  ip_addr=$(ip -4 -br addr show 2>/dev/null | grep -v '^lo ' | awk '{print $3}' | cut -d/ -f1 | head -1)
  [[ -z "$ip_addr" ]] && ip_addr="—"
  device_icon="󰈀"; [[ "$current_device" =~ wl ]] && device_icon="󰖩"
  ids+=("__info__"); labels+=("${device_icon}  ${current_conn:-Not connected}  —  ${ip_addr}")

  # ── Airplane mode ──
  ids+=("__airplane__"); labels+=("$([[ "$net_on" == "enabled" ]] && echo "󰀝  Airplane mode" || echo "󰖩  Turn networking on")")

  # ── WiFi ──
  if [[ -n "$wifi_device" ]]; then
    wifi_list=$(nmcli -t -f IN-USE,SSID dev wifi 2>/dev/null)
    wifi_count=$(printf '%s\n' "$wifi_list" | grep -cv '^$' || echo 0)
    wifi_ssid=$(printf '%s\n' "$wifi_list" | grep '^\*' | cut -d: -f2 | head -1)
    if [[ -n "$wifi_ssid" ]]; then
      ids+=("__wifi__"); labels+=("󰖩  ${wifi_ssid} [${wifi_count}]")
    else
      ids+=("__wifi__"); labels+=("󰖩  WiFi [${wifi_count}]")
    fi
  fi

  # ── Proxy ──
  ph=$(proxy_host); pp=$(proxy_port); np=$(sed -n '3p' "$HOME/.config/cm-network" 2>/dev/null)
  ids+=("__proxy_header__"); labels+=("")
  ids+=("__proxy_toggle__"); labels+=("$(proxy_on && echo '󰔡  Proxy ON' || echo '󰔢  Proxy OFF')")
  ids+=("__proxy_edit_host__"); labels+=("󰏫  Edit address   (${ph})")
  ids+=("__proxy_edit_port__"); labels+=("󰏫  Edit port       (${pp})")
  ids+=("__proxy_noproxy__"); labels+=("󰩠  No proxy       (${np:-localhost,127.0.0.1,::1})")

  # ── Menu ──
  sel=$(for i in "${!labels[@]}"; do
    if [[ "${ids[$i]}" == "__proxy_header__" ]]; then printf '\x00── Proxy ──\n'
    else printf '%s\n' "${labels[$i]}"; fi
  done | $_WM -p "Network" --format i ${select_idx:+--select $select_idx})
  [[ -z "$sel" ]] && exit 0
  select_idx="$sel"

  action="${ids[$sel]:-}"
  [[ -z "$action" ]] && continue

  case "$action" in
    __info__|__proxy_header__) continue ;;

    __airplane__)
      if [[ "$net_on" == "enabled" ]]; then nmcli networking off; else nmcli networking on; fi
      ;;

    __wifi__)
      wifi_submenu
      ;;

    __proxy_edit_host__)
      new=$(printf '\x00Current: %s\n' "$ph" | $_WM -p "Proxy address" --pfill "$ph" --input-fallback --lines 0)
      [[ -z "$new" ]] && continue
      proxy_write "$new" "$pp"
      ;;

    __proxy_edit_port__)
      new=$(printf '\x00Current: %s\n' "$pp" | $_WM -p "Proxy port" --pfill "$pp" --input-fallback --lines 0)
      [[ -z "$new" ]] && continue
      proxy_write "$ph" "$new"
      ;;

    __proxy_noproxy__)
      proxy_noproxy_menu
      ;;

    __proxy_toggle__)
      proxy_toggle
      ;;


  esac
done
