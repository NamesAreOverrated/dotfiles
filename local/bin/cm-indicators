#!/usr/bin/env bash
set -u

data=$(swaymsg -t get_workspaces) || exit 0

focused=$(printf '%s' "$data" | jq -r '.[] | select(.focused == true) | .name' | head -n1)
[[ -n "$focused" ]] || exit 0

df=$(printf '%s' "$data" | jq -r --arg w "$focused" '.[] | select(.name == $w) | .default_float')
cur=$(printf '%s' "$data" | jq -r --arg w "$focused" '.[] | select(.name == $w) | (.minimized_count // 0)')
global=$(printf '%s' "$data" | jq '[.[] | (.minimized_count // 0)] | add')

parts=()
[[ "$df" == "true" ]] && parts+=("F")
parts+=("min[$cur:$global]")

printf '%s\n' "${parts[*]}"
