#!/usr/bin/env bash
set -u

data=$(swaymsg -t get_workspaces) || exit 0

focused=$(printf '%s' "$data" | jq -r '.[] | select(.focused == true) | .name' | head -n1)
[[ -n "$focused" ]] || exit 0

df=$(printf '%s' "$data" | jq -r --arg w "$focused" '.[] | select(.name == $w) | .default_float')

if [[ "$df" == "true" ]]; then
  printf '{"text":"󰖲"}\n'
else
  printf '{}\n'
fi
