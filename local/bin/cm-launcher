#!/usr/bin/env bash
set -uo pipefail

command -v tiny-query >/dev/null 2>&1 || { echo "cm-launcher: tiny-query not found in PATH" >&2; exit 1; }

WMENUSH="tiny-cmenush"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}"
XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"

eval "$(~/.local/bin/config-env 2>/dev/null || true)"

# ── Launch with terminal ──
launch_terminal() {
  local term
  term="${TERMINAL:-}"
  [[ -z "$term" ]] && term=$(command -v foot 2>/dev/null || command -v alacritty 2>/dev/null || command -v kitty 2>/dev/null || command -v wezterm 2>/dev/null || command -v gnome-terminal 2>/dev/null || true)
  if [[ -z "$term" ]]; then
    return 1
  fi
  "$term" "$@"
}

# ── Tokenize Exec into argv ──
# Expands %i/%c/%k in place, resolves backslash escapes, handles "…" and '…' quoting.
exec_to_argv() {
  local exec="$1" icon_name="$2" app_name="$3" desktop_path="$4"
  local args=() arg="" mode="plain" i ch n
  for ((i=0; i<${#exec}; i++)); do
    ch="${exec:$i:1}"
    if [[ "$ch" == '%' && $((i+1)) -lt ${#exec} ]]; then
      n="${exec:$((i+1)):1}"
      case "$n" in
        %) arg+="%"; i=$((i+1)) ;;
        i)
          if [[ -n "$icon_name" ]]; then
            [[ -n "$arg" ]] && { args+=("$arg"); arg=""; }
            args+=("--icon")
            arg="$icon_name"
          fi
          i=$((i+1)) ;;
        c) arg+="$app_name"; i=$((i+1)) ;;
        k) arg+="$desktop_path"; i=$((i+1)) ;;
        [fFuUdDnNvVm]) i=$((i+1)) ;;
        *) arg+="$ch$n"; i=$((i+1)) ;;
      esac
      continue
    fi
    case "$mode" in
      squote)
        if [[ "$ch" == "'" ]]; then mode="plain"
        else arg+="$ch"; fi
        ;;
      dquote)
        if [[ "$ch" == '"' ]]; then
          mode="plain"
        elif [[ "$ch" == '\' && $((i+1)) -lt ${#exec} ]]; then
          n="${exec:$((i+1)):1}"
          case "$n" in
            '"'|'\') arg+="$n"; i=$((i+1)) ;;
            *) arg+="$ch" ;;
          esac
        else
          arg+="$ch"
        fi
        ;;
      plain)
        if [[ "$ch" == '\' && $((i+1)) -lt ${#exec} ]]; then
          n="${exec:$((i+1)):1}"
          case "$n" in
            s|' ') arg+=" "; i=$((i+1)) ;;
            n) arg+=$'\n'; i=$((i+1)) ;;
            t) arg+=$'\t'; i=$((i+1)) ;;
            '\') arg+='\'; i=$((i+1)) ;;
            '"') arg+='"'; i=$((i+1)) ;;
            *) arg+="$ch$n"; i=$((i+1)) ;;
          esac
        elif [[ "$ch" == '"' ]]; then
          mode="dquote"
        elif [[ "$ch" == "'" ]]; then
          if [[ -z "$arg" ]]; then mode="squote"
          else arg+="$ch"; fi
        elif [[ "$ch" == ' ' ]]; then
          [[ -n "$arg" ]] && args+=("$arg")
          arg=""
        else
          arg+="$ch"
        fi
        ;;
    esac
  done
  [[ -n "$arg" ]] && args+=("$arg")
  [[ ${#args[@]} -gt 0 ]] && printf '%s\0' "${args[@]}"
}

# ── Add mode: symlink system apps ──
do_add() {
  local local_dir="${XDG_DATA_HOME}/applications"
  mkdir -p "$local_dir"

  local xdg_data_dirs="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  IFS=':' read -ra parts <<< "$xdg_data_dirs"
  local items=() paths=()

  for part in "${parts[@]}"; do
    [[ -d "$part/applications" ]] || continue
    while IFS=$'\x1f' read -r id path name icon icon_path categories; do
      [[ -z "$id" ]] && continue
      local bn
      bn=$(basename "$path")
      [[ -f "$local_dir/$bn" ]] && continue
      local seen=0
      for p in "${paths[@]}"; do [[ "$(basename "$p")" == "$bn" ]] && seen=1 && break; done
      (( seen )) && continue
      local thumb=""
      if [[ -n "$icon_path" ]]; then
        thumb="$name"$'\x1f'"$icon_path"
      elif [[ -n "$icon" ]]; then
        local ico_path
        ico_path=$(tiny-query icon "$icon" 2>/dev/null || true)
        [[ -n "$ico_path" ]] && thumb="$name"$'\x1f'"$ico_path"
      fi
      [[ -z "$thumb" ]] && thumb="$name"
      items+=("$thumb")
      paths+=("$path")
    done < <(tiny-query scan 'id|path|name|icon|icon_path|categories' --dir "$part/applications" --sep $'\x1f' 2>/dev/null || true)
  done

  [[ ${#items[@]} -eq 0 ]] && return
  local selected
  selected=$(printf '%s\n' "${items[@]}" | $WMENUSH -p "Add app" --format i -c "$CONFIG_DIR/tiny-cmenush/launcher.theme") || true
  [[ -z "$selected" ]] && return
  [[ "$selected" -ge 0 && "$selected" -lt ${#paths[@]} ]] || return
  ln -s "${paths[$selected]}" "$local_dir/"
}

# ── Remove mode: unlink symlinked apps ──
do_remove() {
  local local_dir="${XDG_DATA_HOME}/applications"
    [[ -d "$local_dir" ]] || { return; }

  local items=() paths=()
  while IFS=$'\x1f' read -r path name icon icon_path; do
    [[ -z "$path" ]] && continue
    [[ -L "$path" ]] || continue
    local label="$name"
    if [[ -n "$icon_path" ]]; then
      label="$label"$'\x1f'"$icon_path"
    elif [[ -n "$icon" ]]; then
      local ico_path
      ico_path=$(tiny-query icon "$icon" 2>/dev/null || true)
      [[ -n "$ico_path" ]] && label="$label"$'\x1f'"$ico_path"
    fi
    items+=("$label")
    paths+=("$path")
  done < <(tiny-query scan 'path|name|icon|icon_path' --dir "$local_dir" --all --sep $'\x1f' 2>/dev/null || true)

  if [[ ${#items[@]} -eq 0 ]]; then
    return
  fi

  local selected
  selected=$(printf '%s\n' "${items[@]}" | $WMENUSH -p "Remove app" --format i -c "$CONFIG_DIR/tiny-cmenush/launcher.theme") || true
  [[ -z "$selected" ]] && return
  [[ "$selected" -ge 0 && "$selected" -lt ${#paths[@]} ]] || return

  rm "${paths[$selected]}"
}

# ── Show actions submenu (cm-image-style submenu) ──
# Returns 0 if launched, 1 if user pressed Escape (back to main)
show_actions_submenu() {
  local desktop_path="$1" parent_name="$2" parent_icon="$3" parent_exec="$4" parent_terminal="$5"
  local actions action_ids=()

  actions=$(tiny-query desktop "$desktop_path" 'actions' 2>/dev/null || true)
  actions="${actions%;}"
  [[ -z "$actions" ]] && return 1
  IFS=';' read -ra action_ids <<< "$actions"

  local items=() names=() execs=() icons=() terminals=()

  local launch_thumb=""
  if [[ -n "$parent_icon" ]]; then
    local launch_ico
    launch_ico=$(tiny-query icon "$parent_icon" 2>/dev/null || true)
    [[ -n "$launch_ico" ]] && launch_thumb="Launch $parent_name"$'\x1f'"$launch_ico"
  fi
  items+=("${launch_thumb:-Launch $parent_name}")
  names+=("$parent_name")
  execs+=("$parent_exec")
  icons+=("$parent_icon")
  terminals+=("$parent_terminal")

  while IFS=$'\x1f' read -r a_id a_name a_exec a_icon a_terminal a_icon_path; do
    [[ -z "$a_exec" ]] && continue
    [[ -z "$a_name" ]] && a_name="$a_id"
    # icon_path already resolved via tiny-query; fallback to parent icon if needed
    if [[ -z "$a_icon" ]]; then
      a_icon="$parent_icon"
      [[ -z "$a_icon_path" && -n "$a_icon" ]] && a_icon_path=$(tiny-query icon "$a_icon" 2>/dev/null || true)
    fi
    [[ -z "$a_terminal" || "$a_terminal" == "0" ]] && a_terminal="$parent_terminal"
    local thumb=""
    if [[ -n "$a_icon_path" ]]; then
      thumb="$a_name"$'\x1f'"$a_icon_path"
    elif [[ -n "$a_icon" ]]; then
      local ico_path
      ico_path=$(tiny-query icon "$a_icon" 2>/dev/null || true)
      [[ -n "$ico_path" ]] && thumb="$a_name"$'\x1f'"$ico_path"
    fi
    items+=("${thumb:-$a_name}")
    names+=("$a_name")
    execs+=("$a_exec")
    icons+=("$a_icon")
    terminals+=("$a_terminal")
  done < <(tiny-query action "$desktop_path" --all 'id|name|exec|icon|terminal|icon_path' --sep $'\x1f' 2>/dev/null || true)

  local selected
  selected=$(printf '%s\n' "${items[@]}" \
    | $WMENUSH -p "$parent_name" --format i \
        -c "$CONFIG_DIR/tiny-cmenush/launcher.theme") || true
  [[ -z "$selected" ]] && return 1

  local idx="$selected"
  [[ "$idx" -ge 0 && "$idx" -lt ${#execs[@]} ]] || return 1

  local args=()
  while IFS='' read -r -d '' arg; do args+=("$arg"); done < <(exec_to_argv "${execs[$idx]}" "${icons[$idx]}" "${names[$idx]}" "$desktop_path")
  [[ ${#args[@]} -eq 0 ]] && return 1

  if [[ "${terminals[$idx]}" == "1" || "${terminals[$idx],,}" == "true" ]]; then
    launch_terminal "${args[@]}" &
  else
    "${args[@]}" &
  fi
  return 0
}

# ── Main ──
main() {
  local select_idx=""

  while true; do
    local execs=() icons=() icon_paths=() terminals=() paths=() names_list=() thumbs=() action_ids_list=()
    while IFS=$'\x1f' read -r path name exec icon icon_path terminal actions; do
      [[ -z "$path" ]] && continue
      paths+=("$path")
      names_list+=("$name")
      execs+=("$exec")
      icons+=("$icon")
      icon_paths+=("$icon_path")
      terminals+=("$terminal")
      action_ids_list+=("$actions")
      local indicator=""
      [[ -n "$actions" ]] && indicator=" 󰅂"
      local label="$name$indicator"
      if [[ -n "$icon_path" ]]; then
        label="$label"$'\x1f'"$icon_path"
      elif [[ -n "$icon" ]]; then
        local ico_path
        ico_path=$(tiny-query icon "$icon" 2>/dev/null || true)
        [[ -n "$ico_path" ]] && label="$label"$'\x1f'"$ico_path"
      fi
      thumbs+=("$label")
    done < <(tiny-query scan 'path|name|exec|icon|icon_path|terminal|actions' --dir "${XDG_DATA_HOME:-$HOME/.local/share}/applications" --sep $'\x1f' 2>/dev/null || true)

    local add_svg="$HOME/.local/share/cm-launcher/icons/add.svg"
    local remove_svg="$HOME/.local/share/cm-launcher/icons/remove.svg"
    local add_thumb remove_thumb
    [[ -f "$add_svg" ]] && add_thumb="Add App"$'\x1f'"$add_svg"
    [[ -f "$remove_svg" ]] && remove_thumb="Remove App"$'\x1f'"$remove_svg"

    local selected
    selected=$({
      printf '%s\n' "${add_thumb:-Add App}" "${remove_thumb:-Remove App}"
      printf '\x00%s\n' '──── Apps ────'
      printf '%s\n' "${thumbs[@]}"
    } | $WMENUSH -p "Launch" --format i -c "$CONFIG_DIR/tiny-cmenush/launcher.theme" --input-fallback ${select_idx:+--select $select_idx}) || true
    [[ -z "$selected" ]] && exit 0

    # input-fallback → math evaluation loop
    if ! [[ "$selected" =~ ^-?[0-9]+$ ]]; then
      local calc_input="$selected"
      select_idx=""
      while true; do
        local calc_result=""
        [ -n "$calc_input" ] && command -v qalc &>/dev/null && \
          calc_result=$(qalc -t "$calc_input" 2>/dev/null) && \
          [ "$calc_result" != "$calc_input" ] || calc_result=""

        local choice
        if [ -n "$calc_result" ]; then
          choice=$(printf ' %s = %s\n' "$calc_input" "$calc_result" \
            | $WMENUSH -p "Result" --format i --lines 1 --input-fallback \
                -c "$CONFIG_DIR/tiny-cmenush/launcher.theme") || true
        else
          choice=$(printf '\x00Type expression...\n' \
            | $WMENUSH -p "Calc" --format i --lines 1 --input-fallback \
                -c "$CONFIG_DIR/tiny-cmenush/launcher.theme") || true
        fi

        [ -z "$choice" ] && break

        if [ -n "$calc_result" ] && [ "$choice" = "0" ]; then
          echo -n "$calc_result" | wl-copy 2>/dev/null || \
          echo -n "$calc_result" | xclip -sel c 2>/dev/null || \
          echo "$calc_result"
          exit 0
        fi

        calc_input="$choice"
      done
      continue
    fi

    select_idx="$selected"

    if [[ "$selected" -eq 0 ]]; then
      do_add
      continue
    elif [[ "$selected" -eq 1 ]]; then
      do_remove
      continue
    fi

    local idx=$((selected - 3))
    [[ "$idx" -ge 0 && "$idx" -lt ${#execs[@]} ]] || continue
    local exec="${execs[$idx]}"
    local icon_name="${icons[$idx]}"
    local name="${names_list[$idx]}"
    local path="${paths[$idx]}"
    local terminal="${terminals[$idx]}"
    local actions="${action_ids_list[$idx]}"

    if [[ -n "$actions" ]]; then
      show_actions_submenu "$path" "$name" "$icon_name" "$exec" "$terminal" && exit 0
      continue
    fi

    local args=()
    while IFS='' read -r -d '' arg; do args+=("$arg"); done < <(exec_to_argv "$exec" "$icon_name" "$name" "$path")
    [[ ${#args[@]} -eq 0 ]] && exit 1

    if [[ "$terminal" == "1" || "${terminal,,}" == "true" ]]; then
      launch_terminal "${args[@]}" &
    else
      "${args[@]}" &
    fi
    exit 0
  done
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
