#!/usr/bin/env bash
set -u

WMENUSH="tiny-cmenush"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}"
XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
LAUNCHER_CACHE="$HOME/.cache/cm-launcher.txt"

eval "$(~/.local/bin/config-env)"

# ── App dirs ──
get_local_app_dirs() {
  echo "$XDG_DATA_HOME/applications"
}

get_system_app_dirs() {
  local xdg_data_dirs="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  IFS=':' read -ra parts <<< "$xdg_data_dirs"
  for part in "${parts[@]}"; do
    echo "$part/applications"
  done
}

# ── Icon theme ──
get_icon_theme() {
  [[ -n "${GTK_ICON_THEME:-}" ]] && { echo "$GTK_ICON_THEME"; return; }
  for f in "$CONFIG_DIR/gtk-3.0/settings.ini" "$CONFIG_DIR/gtk-4.0/settings.ini"; do
    [[ -f "$f" ]] || continue
    local t
    t=$(sed -n 's/^gtk-icon-theme-name=\s*//p' "$f" 2>/dev/null | head -1)
    [[ -n "$t" ]] && { echo "$t"; return; }
  done
  for theme in Pop Cosmic Adwaita hicolor; do
    for base in "$HOME/.icons" /usr/share/icons /usr/local/share/icons; do
      [[ -d "$base/$theme" ]] && { echo "$theme"; return; }
    done
  done
  echo "hicolor"
}

# ── Icon theme search chain ──
get_theme_dirs() {
  local theme="$1" depth="${2:-0}"
  (( depth > 8 )) && return
  local base first_match="" matched=0
  for base in "$HOME/.icons" "${XDG_DATA_HOME:-$HOME/.local/share}/icons" /usr/share/icons /usr/local/share/icons; do
    local dir="$base/$theme"
    if [[ -d "$dir" ]]; then
      echo "$dir"
      matched=1
      [[ -z "$first_match" ]] && first_match="$dir"
    fi
  done
  if (( matched )); then
    local inherit
    inherit=$(sed -n 's/^Inherits=\s*//p' "$first_match/index.theme" 2>/dev/null | head -1)
    if [[ -n "$inherit" ]]; then
      local IFS=','
      for t in $inherit; do
        t="${t#"${t%%[! ]*}"}"; t="${t%"${t##*[! ]}"}"
        get_theme_dirs "$t" $((depth + 1))
      done
    fi
  else
    [[ "$theme" != "hicolor" ]] && get_theme_dirs "hicolor" $((depth + 1))
  fi
}

# ── Resolve icon path ──
# Searches largest PNG first, then SVG, then pixmaps
resolve_icon() {
  local name="$1"
  # Absolute path icon → use as-is
  [[ "$name" == /* && -f "$name" ]] && { echo "$name"; return; }
  # Strip file extension if icon name includes one (e.g. "godot-mono.svg")
  [[ "$name" == *.* ]] && name="${name%.*}"
  local theme_dirs=()
  while IFS='' read -r dir; do theme_dirs+=("$dir"); done < <(get_theme_dirs "$(get_icon_theme)" | sort -u)
  local sizes=(256 128 64 48 32 24 22 16)
  for td in "${theme_dirs[@]}"; do
    for sz in "${sizes[@]}"; do
      local p="$td/${sz}x${sz}/apps/${name}.png"
      [[ -f "$p" ]] && { echo "$p"; return; }
    done
  done
  for td in "${theme_dirs[@]}"; do
    for sz in "${sizes[@]}"; do
      local p="$td/${sz}x${sz}/apps/${name}.svg"
      [[ -f "$p" ]] && { echo "$p"; return; }
    done
    local p="$td/scalable/apps/${name}.svg"
    [[ -f "$p" ]] && { echo "$p"; return; }
  done
  # Fallback: icon directly in icon base dir (e.g. ~/.local/share/icons/something.png)
  for base in "$HOME/.icons" "${XDG_DATA_HOME:-$HOME/.local/share}/icons" /usr/share/icons /usr/local/share/icons; do
    [[ -d "$base" ]] || continue
    p="$base/${name}.png"
    [[ -f "$p" ]] && { echo "$p"; return; }
    p="$base/${name}.svg"
    [[ -f "$p" ]] && { echo "$p"; return; }
  done
    local p="/usr/share/pixmaps/${name}.png"
    [[ -f "$p" ]] && { echo "$p"; return; }
    p="/usr/share/pixmaps/${name}.svg"
    [[ -f "$p" ]] && { echo "$p"; return; }
    p="/usr/share/pixmaps/${name}.xpm"
    [[ -f "$p" ]] && { echo "$p"; return; }
}
# ── Parse a .desktop file ──
# Returns: path|name|exec|icon|terminal|action_ids
parse_desktop() {
  local file="$1" name exec icon terminal nodisplay actions
  name=$(sed -n '/^Name=/{s/^Name=//p;q}' "$file" 2>/dev/null)
  exec=$(sed -n '/^Exec=/{s/^Exec=//p;q}' "$file" 2>/dev/null)
  icon=$(sed -n '/^Icon=/{s/^Icon=//p;q}' "$file" 2>/dev/null)
  terminal=$(sed -n '/^Terminal=/{s/^Terminal=//p;q}' "$file" 2>/dev/null)
  nodisplay=$(sed -n '/^NoDisplay=/{s/^NoDisplay=//p;q}' "$file" 2>/dev/null)
  actions=$(sed -n '/^Actions=/{s/^Actions=//p;q}' "$file" 2>/dev/null)
  actions="${actions%;}"
  [[ -z "$name" || "$nodisplay" == "true" || -z "$exec" ]] && return 1
  echo "$file|$name|$exec|$icon|$terminal|$actions"
}

# ── Process Exec field ──
# Strips field codes, expands %i/%c/%k, resolves backslash escapes
process_exec() {
  local exec="$1" icon_name="$2" app_name="$3" desktop_path="$4"
  local result="" i ch
  for ((i=0; i<${#exec}; i++)); do
    ch="${exec:$i:1}"
    if [[ "$ch" == "\\" && $((i+1)) -lt ${#exec} ]]; then
      local next="${exec:$((i+1)):1}"
      case "$next" in
        s) result+=" "; i=$((i+1)) ;;
        n) result+=$'\n'; i=$((i+1)) ;;
        t) result+=$'\t'; i=$((i+1)) ;;
        \\) result+="\\"; i=$((i+1)) ;;
        \") result+="\""; i=$((i+1)) ;;
        *) result+="$ch$next"; i=$((i+1)) ;;
      esac
    elif [[ "$ch" == "%" && $((i+1)) -lt ${#exec} ]]; then
      local next="${exec:$((i+1)):1}"
      case "$next" in
        %) result+="%"; i=$((i+1)) ;;
        i) result+=" --icon ${icon_name} "; i=$((i+1)) ;;
        c) result+="$app_name"; i=$((i+1)) ;;
        k) result+="$desktop_path"; i=$((i+1)) ;;
        [fFuUdDnNvVm]) i=$((i+1)) ;;
        *) result+="$ch$next"; i=$((i+1)) ;;
      esac
    else
      result+="$ch"
    fi
  done
  echo "$result" | tr -s ' ' | sed 's/^ //;s/ $//'
}

# ── Split processed Exec into argv ──
exec_to_argv() {
  local exec="$1"
  local args=() arg="" in_quotes=false i ch
  for ((i=0; i<${#exec}; i++)); do
    ch="${exec:$i:1}"
    if $in_quotes; then
      if [[ "$ch" == '"' ]]; then
        in_quotes=false
      else
        arg+="$ch"
      fi
    else
      if [[ "$ch" == '"' ]]; then
        in_quotes=true
      elif [[ "$ch" == ' ' ]]; then
        [[ -n "$arg" ]] && args+=("$arg")
        arg=""
      else
        arg+="$ch"
      fi
    fi
  done
  [[ -n "$arg" ]] && args+=("$arg")
  printf '%s\0' "${args[@]}"
}

# ── Build cache ──
build_cache() {
  local tmpf
  tmpf=$(mktemp)
  for dir in $(get_local_app_dirs); do
    [[ -d "$dir" ]] || continue
    for file in "$dir"/*.desktop; do
      [[ -f "$file" ]] || continue
      local parsed
      parsed=$(parse_desktop "$file") || continue
      local mtime
      mtime=$(stat -c '%Y' "$file" 2>/dev/null) || continue
      echo "$mtime|$parsed" >> "$tmpf"
    done
  done
  mv "$tmpf" "$LAUNCHER_CACHE"
  sed 's/^[^|]*|//' "$LAUNCHER_CACHE"
}

# ── Read cache ──
read_cache() {
  [[ -f "$LAUNCHER_CACHE" ]] || return 1
  local cache_count=0
  while IFS='' read -r line; do
    [[ -z "$line" ]] && continue
    cache_count=$((cache_count + 1))
    local mtime file rest
    mtime="${line%%|*}"; rest="${line#*|}"
    file="${rest%%|*}"; rest="${rest#*|}"
    local curr_mtime
    curr_mtime=$(stat -c '%Y' "$file" 2>/dev/null) || return 1
    [[ "$curr_mtime" != "$mtime" ]] && return 1
    echo "$file|$rest"
  done < "$LAUNCHER_CACHE"
  # Invalidate if .desktop file count differs (additions/deletions)
  local dir_count=0
  for dir in $(get_local_app_dirs); do
    [[ -d "$dir" ]] || continue
    for f in "$dir"/*.desktop; do
      [[ -f "$f" ]] && dir_count=$((dir_count + 1))
    done
  done
  [[ "$dir_count" -ne "$cache_count" ]] && return 1
}

# ── Launch with terminal ──
launch_terminal() {
  local term
  term="${TERMINAL:-}"
  [[ -z "$term" ]] && term=$(command -v foot 2>/dev/null || command -v alacritty 2>/dev/null || command -v kitty 2>/dev/null || command -v wezterm 2>/dev/null || command -v gnome-terminal 2>/dev/null || true)
  if [[ -z "$term" ]]; then
    return 1
  fi
  "$term" "$@"
}

# ── Add mode: symlink system apps ──
do_add() {
  local local_dir items=() paths=()
  local_dir=$(get_local_app_dirs | head -1)
  mkdir -p "$local_dir"

  for dir in $(get_system_app_dirs); do
    [[ -d "$dir" ]] || continue
    for file in "$dir"/*.desktop; do
      [[ -f "$file" ]] || continue
      local bn name exec icon terminal _path rest thumb ico_path
      bn=$(basename "$file")
      [[ -f "$local_dir/$bn" ]] && continue
      local seen=0
      for p in "${paths[@]}"; do
        [[ "$(basename "$p")" == "$bn" ]] && seen=1 && break
      done
      (( seen )) && continue

      parsed=$(parse_desktop "$file") || continue
      _path="${parsed%%|*}"; rest="${parsed#*|}"
      name="${rest%%|*}"; rest="${rest#*|}"
      exec="${rest%%|*}"; rest="${rest#*|}"
      icon="${rest%%|*}"; rest="${rest#*|}"
      terminal="${rest%%|*}"

      thumb=""
      if [[ -n "$icon" ]]; then
        ico_path=$(resolve_icon "$icon")
        [[ -n "$ico_path" ]] && thumb="$name"$'\x1f'"$ico_path"
      fi
      items+=("${thumb:-$name}")
      paths+=("$file")
    done
  done

  if [[ ${#items[@]} -eq 0 ]]; then
    return
  fi

  local selected
  selected=$(printf '%s\n' "${items[@]}" | $WMENUSH -p "Add app" --format i -c "$CONFIG_DIR/tiny-cmenush/launcher.theme") || true
  [[ -z "$selected" ]] && return

  ln -s "${paths[$selected]}" "$local_dir/"
  build_cache > /dev/null 2>&1 || true
}

# ── Remove mode: unlink symlinked apps ──
do_remove() {
  local local_dir items=() paths=()
  local_dir=$(get_local_app_dirs | head -1)
    [[ -d "$local_dir" ]] || { return; }

  for file in "$local_dir"/*.desktop; do
    [[ -f "$file" ]] || continue
    [[ -L "$file" ]] || continue
    local parsed name exec icon terminal _path rest ico_path
    parsed=$(parse_desktop "$file") || continue
    _path="${parsed%%|*}"; rest="${parsed#*|}"
    name="${rest%%|*}"; rest="${rest#*|}"
    exec="${rest%%|*}"; rest="${rest#*|}"
    icon="${rest%%|*}"; rest="${rest#*|}"
    terminal="${rest%%|*}"

    local indicator=""
    local label="$name$indicator"
    if [[ -n "$icon" ]]; then
      ico_path=$(resolve_icon "$icon")
      [[ -n "$ico_path" ]] && label="$label"$'\x1f'"$ico_path"
    fi
    items+=("$label")
    paths+=("$file")
  done

  if [[ ${#items[@]} -eq 0 ]]; then
    return
  fi

  local selected
  selected=$(printf '%s\n' "${items[@]}" | $WMENUSH -p "Remove app" --format i -c "$CONFIG_DIR/tiny-cmenush/launcher.theme") || true
  [[ -z "$selected" ]] && return

  rm "${paths[$selected]}"
  build_cache > /dev/null 2>&1 || true
}

# ── Show actions submenu (cm-image-style submenu) ──
# Returns 0 if launched, 1 if user pressed Escape (back to main)
show_actions_submenu() {
  local desktop_path="$1" parent_name="$2" parent_icon="$3" parent_exec="$4" parent_terminal="$5"
  local actions action_ids=()

  actions=$(sed -n '/^Actions=/{s/^Actions=//p;q}' "$desktop_path" 2>/dev/null)
  actions="${actions%;}"
  [[ -z "$actions" ]] && return 1
  IFS=';' read -ra action_ids <<< "$actions"

  local items=() names=() execs=() icons=() terminals=()

  local launch_thumb=""
  if [[ -n "$parent_icon" ]]; then
    local launch_ico
    launch_ico=$(resolve_icon "$parent_icon")
    [[ -n "$launch_ico" ]] && launch_thumb="Launch $parent_name"$'\x1f'"$launch_ico"
  fi
  items+=("${launch_thumb:-Launch $parent_name}")
  names+=("$parent_name")
  execs+=("$parent_exec")
  icons+=("$parent_icon")
  terminals+=("$parent_terminal")

  for action_id in "${action_ids[@]}"; do
    [[ -z "$action_id" ]] && continue
    local a_name a_exec a_icon a_terminal ico_path thumb
    a_name=$(sed -n "/^\\[Desktop Action $action_id\\]/,/^\\[/{/^Name=/{s/^Name=//p;q}}" "$desktop_path" 2>/dev/null)
    a_exec=$(sed -n "/^\\[Desktop Action $action_id\\]/,/^\\[/{/^Exec=/{s/^Exec=//p;q}}" "$desktop_path" 2>/dev/null)
    a_icon=$(sed -n "/^\\[Desktop Action $action_id\\]/,/^\\[/{/^Icon=/{s/^Icon=//p;q}}" "$desktop_path" 2>/dev/null)
    a_terminal=$(sed -n "/^\\[Desktop Action $action_id\\]/,/^\\[/{/^Terminal=/{s/^Terminal=//p;q}}" "$desktop_path" 2>/dev/null)

    [[ -z "$a_name" ]] && a_name="$action_id"
    [[ -z "$a_icon" ]] && a_icon="$parent_icon"
    [[ -z "$a_terminal" ]] && a_terminal="$parent_terminal"
    [[ -z "$a_exec" ]] && continue

    thumb=""
    if [[ -n "$a_icon" ]]; then
      ico_path=$(resolve_icon "$a_icon")
      [[ -n "$ico_path" ]] && thumb="$a_name"$'\x1f'"$ico_path"
    fi
    items+=("${thumb:-$a_name}")
    names+=("$a_name")
    execs+=("$a_exec")
    icons+=("$a_icon")
    terminals+=("$a_terminal")
  done

  local selected
  selected=$(printf '%s\n' "${items[@]}" \
    | $WMENUSH -p "$parent_name" --format i \
        -c "$CONFIG_DIR/tiny-cmenush/launcher.theme") || true
  [[ -z "$selected" ]] && return 1

  local idx="$selected"
  local processed
  processed=$(process_exec "${execs[$idx]}" "${icons[$idx]}" "${names[$idx]}" "$desktop_path")
  [[ -z "$processed" ]] && return 1

  local args=()
  while IFS='' read -r -d '' arg; do args+=("$arg"); done < <(exec_to_argv "$processed")
  [[ ${#args[@]} -eq 0 ]] && return 1

  if [[ "${terminals[$idx]}" == "true" ]]; then
    launch_terminal "${args[@]}" || exit 1
  else
    exec "${args[@]}" || exit 1
  fi
}

# ── Main ──
main() {
  # One-time migration: invalidate old cache format
  if [[ -f "$LAUNCHER_CACHE" ]]; then
    if grep -q '/usr/' "$LAUNCHER_CACHE" 2>/dev/null; then
      rm -f "$LAUNCHER_CACHE"
    elif [[ $(head -1 "$LAUNCHER_CACHE" | tr -cd '|' | wc -c) -eq 5 ]]; then
      rm -f "$LAUNCHER_CACHE"
    fi
  fi

  local select_idx=""

  while true; do
    local entries
    entries=$(read_cache) || entries=$(build_cache)
    local execs=() icons=() terminals=() paths=() names_list=() thumbs=() action_ids_list=()
    while IFS='' read -r line; do
      [[ -z "$line" ]] && continue
      local path name exec icon terminal actions tail ico_path thumb
      path="${line%%|*}"; tail="${line#*|}"
      name="${tail%%|*}"; tail="${tail#*|}"
      exec="${tail%%|*}"; tail="${tail#*|}"
      icon="${tail%%|*}"; tail="${tail#*|}"
      terminal="${tail%%|*}"; tail="${tail#*|}"
      actions="${tail%%|*}"
      paths+=("$path")
      names_list+=("$name")
      execs+=("$exec")
      icons+=("$icon")
      terminals+=("$terminal")
      action_ids_list+=("$actions")
      local indicator=""
      [[ -n "$actions" ]] && indicator=" 󰅂"
      local label="$name$indicator"
      if [[ -n "$icon" ]]; then
        ico_path=$(resolve_icon "$icon")
        [[ -n "$ico_path" ]] && label="$label"$'\x1f'"$ico_path"
      fi
      thumbs+=("$label")
    done <<< "$entries"

    local add_svg="$HOME/.local/share/cm-launcher/icons/add.svg"
    local remove_svg="$HOME/.local/share/cm-launcher/icons/remove.svg"
    local add_thumb remove_thumb
    [[ -f "$add_svg" ]] && add_thumb="Add App"$'\x1f'"$add_svg"
    [[ -f "$remove_svg" ]] && remove_thumb="Remove App"$'\x1f'"$remove_svg"

    local selected
    selected=$({
      printf '%s\n' "${add_thumb:-Add App}" "${remove_thumb:-Remove App}"
      printf '\x00%s\n' '──── Apps ────'
      printf '%s\n' "${thumbs[@]}"
    } | $WMENUSH -p "Launch" --format i -c "$CONFIG_DIR/tiny-cmenush/launcher.theme" --input-fallback ${select_idx:+--select $select_idx}) || true
    [[ -z "$selected" ]] && exit 0

    # input-fallback → math evaluation loop
    if ! [[ "$selected" =~ ^-?[0-9]+$ ]]; then
      local calc_input="$selected"
      select_idx=""
      while true; do
        local calc_result=""
        [ -n "$calc_input" ] && command -v qalc &>/dev/null && \
          calc_result=$(qalc -t "$calc_input" 2>/dev/null) && \
          [ "$calc_result" != "$calc_input" ] || calc_result=""

        local choice
        if [ -n "$calc_result" ]; then
          choice=$(printf ' %s = %s\n' "$calc_input" "$calc_result" \
            | $WMENUSH -p "Result" --format i --lines 1 --input-fallback \
                -c "$CONFIG_DIR/tiny-cmenush/launcher.theme") || true
        else
          choice=$(printf '\x00Type expression...\n' \
            | $WMENUSH -p "Calc" --format i --lines 1 --input-fallback \
                -c "$CONFIG_DIR/tiny-cmenush/launcher.theme") || true
        fi

        [ -z "$choice" ] && break

        if [ -n "$calc_result" ] && [ "$choice" = "0" ]; then
          echo -n "$calc_result" | wl-copy 2>/dev/null || \
          echo -n "$calc_result" | xclip -sel c 2>/dev/null || \
          echo "$calc_result"
          exit 0
        fi

        calc_input="$choice"
      done
      continue
    fi

    select_idx="$selected"

    if [[ "$selected" -eq 0 ]]; then
      do_add
      continue
    elif [[ "$selected" -eq 1 ]]; then
      do_remove
      continue
    fi

    local idx=$((selected - 3))
    [[ "$idx" -ge 0 && "$idx" -lt ${#execs[@]} ]] || continue
    local exec="${execs[$idx]}"
    local icon_name="${icons[$idx]}"
    local name="${names_list[$idx]}"
    local path="${paths[$idx]}"
    local terminal="${terminals[$idx]}"
    local actions="${action_ids_list[$idx]}"

    if [[ -n "$actions" ]]; then
      show_actions_submenu "$path" "$name" "$icon_name" "$exec" "$terminal"
      continue
    fi

    local processed
    processed=$(process_exec "$exec" "$icon_name" "$name" "$path")
    [[ -z "$processed" ]] && exit 1

    local args=()
    while IFS='' read -r -d '' arg; do args+=("$arg"); done < <(exec_to_argv "$processed")
    [[ ${#args[@]} -eq 0 ]] && exit 1

    if [[ "$terminal" == "true" ]]; then
      launch_terminal "${args[@]}" &
    else
      "${args[@]}" &
    fi
    exit 0
  done
}

main "$@"
