#!/usr/bin/env bash
set -u

source "$HOME/.local/libexec/cm-common.sh"

dir="$HOME/Pictures/wallpapers"
theme="$HOME/.config/tiny-cmenush/wallpaper.theme"
mode="fit"

while getopts "d:c:m:" opt; do
  case $opt in
    d) dir="$OPTARG" ;;
    c) theme="$OPTARG" ;;
    m) mode="$OPTARG" ;;
  esac
done
shift $((OPTIND - 1))
[[ $# -gt 0 ]] && dir="$1"

browse_ext_filter="png jpg jpeg PNG JPG JPEG"
browse_label_dir=' 󰉋 %s 󰅂'
browse_label_file=' 󰋩 %s'
browse_use_thumbs=true

browse_on_file() {
  local path="$1"
  shift
  local all_files=("$@")
  result=$(cm-preview -m "$mode" -c "$theme" -i "$path" "${all_files[@]}")
  rc=$?
  if [ $rc -eq 0 ] && [ -n "$result" ]; then
    echo "$result"
    exit 0
  fi
  if [ $rc -eq 2 ] && [ -n "$result" ]; then
    browse_select_path="$result"
    return 2
  fi
  return 0
}

browse_nav "$dir" "$theme" || exit 0
