#!/bin/sh
dir="${1:-$HOME/Pictures/wallpapers}"
relpath=$(echo "$dir" | sed "s|$HOME/Pictures/wallpapers/||")

result=$( {
    for f in "$dir"/*/; do
        [ -d "$f" ] || continue
        name=$(basename "$f")
        first=$(find "$f" -maxdepth 1 -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' \) 2>/dev/null | head -1)
        if [ -n "$first" ]; then
            printf "%s/\0icon\x1f%s\n" "$name" "$first"
        else
            printf "%s/\0icon\x1ffolder\n" "$name"
        fi
    done
    for f in "$dir"/*; do
        [ -f "$f" ] || continue
        name=$(basename "$f")
        case "${name##*.}" in
            png|jpg|jpeg|PNG|JPG|JPEG)
                printf "%s\0icon\x1f%s\n" "$name" "$f"
                ;;
        esac
    done
} | rofi -dmenu -p "${relpath:-Wallpapers}" \
    -show-icons -kb-custom-1 "Alt+BackSpace" \
    -theme ~/.config/rofi/themes/wallpaper.rasi)

ret=$?
selected="$result"
[ -z "$selected" ] && [ "$ret" -ne 10 ] && exit 0

if [ "$ret" -eq 10 ]; then
    parent="$(dirname "$dir")"
    [ "$parent" != "$HOME/Pictures/wallpapers" ] && "$0" "$parent" || "$0"
elif [ -d "$dir/$selected" ]; then
    "$0" "$dir/$selected"
else
    mkdir -p "$HOME/.config/sway"
    echo "output * bg \"$dir/$selected\" fill" > "$HOME/.config/sway/wallpaper"
    swaymsg output "*" bg "$dir/$selected" fill
fi
