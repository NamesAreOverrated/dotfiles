#!/usr/bin/env bash
# ts-dock — auto-categorized dock helper for tiny-strip.
#
# Sources apps from ~/.local/share/applications, groups them by their
# Categories= key according to DICT below (first match in an app's list
# wins; unmatched apps land in an auto "Other" group), renders the root
# dock as [custom pins][category folders...][Other] with item counts in the
# tooltips, and swaps to a per-category subdock (return cell on top) when
# a folder is clicked. App picks launch via tiny-query + exec_to_argv.
# Custom pins are defined in CUSTOM below as cmd|name|icon|toggle.
set -uo pipefail

command -v tiny-query >/dev/null 2>&1 || { echo "ts-dock: tiny-query not found in PATH" >&2; exit 1; }
command -v tiny-strip >/dev/null 2>&1 || STRIP="tiny-strip"
STRIP="${TINY_STRIP_BIN:-tiny-strip}"
command -v "$STRIP" >/dev/null 2>&1 || { echo "ts-dock: $STRIP not found in PATH" >&2; exit 1; }

resolve_focused_output() {
  swaymsg -t get_outputs 2>/dev/null | jq -r '.[] | select(.focused==true) | .name' 2>/dev/null | head -1
}

# Waybar wlr/taskbar parity: all-outputs vs per-output via output_enter only.
# No workspace filter — Sway's output_leave for unfocused workspaces gives "focused workspace per output" implicitly.
OUTPUT=""
ALL_OUTPUTS=""
if [[ "${1:-}" == "--output" && -n "${2:-}" ]]; then
  OUTPUT="$2"
  shift 2
elif [[ "${1:-}" == "--all-outputs" ]]; then
  ALL_OUTPUTS=1
  shift
fi
if [[ -z "$OUTPUT" && -z "$ALL_OUTPUTS" && "${1:-}" != "--kill" ]]; then
  OUTPUT=$(resolve_focused_output 2>/dev/null || true)
fi
STRIP_OUTPUT_ARGS=()
if [[ -n "$ALL_OUTPUTS" ]]; then
  STRIP_OUTPUT_ARGS=(--all-outputs)
elif [[ -n "$OUTPUT" ]]; then
  STRIP_OUTPUT_ARGS=(--output "$OUTPUT")
fi
STRIP_ACTIVE_ARGS=(--active-only=false)

PIDFILE="${XDG_RUNTIME_DIR:-/tmp}/ts-dock.pid"
case "${1:-}" in
  --kill)
    if [[ -f "$PIDFILE" ]]; then
      oldpid=$(cat "$PIDFILE" 2>/dev/null || true)
      if [[ -n "$oldpid" ]] && kill -0 "$oldpid" 2>/dev/null; then
        oldpgid=$(ps -o pgid= -p "$oldpid" 2>/dev/null | tr -d ' ' || true)
        if [[ -n "$oldpgid" ]]; then
          kill -- "-$oldpgid" 2>/dev/null || true
        else
          pkill -P "$oldpid" 2>/dev/null || true
          kill "$oldpid" 2>/dev/null || true
        fi
        for _ in {1..20}; do kill -0 "$oldpid" 2>/dev/null || break; sleep 0.05; done
      fi
      rm -f "$PIDFILE"
    else
      pkill -f "[t]s-dock --dock" 2>/dev/null || true
    fi
    exit 0
    ;;
  --keep-alive)
    if [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE" 2>/dev/null || true)" 2>/dev/null; then
      exit 0
    fi
    ;;
esac

MYPID=$$
if [[ -f "$PIDFILE" ]]; then
  oldpid=$(cat "$PIDFILE" 2>/dev/null || true)
  if [[ -n "$oldpid" && "$oldpid" != "$MYPID" ]] && kill -0 "$oldpid" 2>/dev/null; then
    # kill process group of old instance (covers main bash + its tiny-strip child)
    oldpgid=$(ps -o pgid= -p "$oldpid" 2>/dev/null | tr -d ' ' || true)
    if [[ -n "$oldpgid" ]]; then
      kill -- "-$oldpgid" 2>/dev/null || true
    else
      pkill -P "$oldpid" 2>/dev/null || true
      kill "$oldpid" 2>/dev/null || true
    fi
    for _ in {1..20}; do kill -0 "$oldpid" 2>/dev/null || break; sleep 0.05; done
  fi
  [[ "$(cat "$PIDFILE" 2>/dev/null || true)" == "$oldpid" ]] && rm -f "$PIDFILE"
fi
echo "$MYPID" > "$PIDFILE"

eval "$(~/.local/bin/config-env 2>/dev/null || true)"

OTHER_ICON="applications-other"
BACK_ICON="go-previous"
OTHER_LABEL="Other"

# ── Category dictionary — RawCategory:Label:ThemeIconName ──
# Edit to add/remove recognizers; first match in an app's Categories= wins.
DICT='Network:Internet:web-browser
AudioVideo:Media:applications-multimedia
Game:Games:applications-games
Development:Development:applications-development
Graphics:Graphics:applications-graphics
Office:Office:applications-office
Utility:Utilities:applications-accessories
System:System:applications-system
Distrobox:Distrobox:podman-desktop'

# ── Parse dict ──
dict_cate=(); dict_label=(); dict_icon=()
declare -A dict_idx=()
while IFS= read -r line; do
    line="${line%$'\r'}"
    [[ -z "$line" || "$line" == \#* || "$line" != *:*:* ]] && continue
    cate="${line%%:*}"; rest="${line#*:}"
    label="${rest%%:*}"; icon="${rest#*:}"
    [[ -n "$cate" && -n "$label" && -z "${dict_idx[$cate]:-}" ]] || continue
    dict_idx["$cate"]=${#dict_cate[@]}
    dict_cate+=("$cate"); dict_label+=("$label"); dict_icon+=("$icon")
done <<< "$DICT"

trim() { local s="$1"; s="${s#"${s%%[![:space:]]*}"}"; s="${s%"${s##*[![:space:]]}"}"; printf '%s' "$s"; }

# ── Custom pins — cmd|name|theme-icon|toggle (toggle 1 = pkill behaviour) ──
CUSTOM="cm-launcher|Apps|void-wizard|1
$TERMINAL|Terminal|$TERMINAL|0
cm-media|Media|musicbrainz|1
cm-container|Container|kdepim-dropbox|1"
custom_cmd=(); custom_name=(); custom_icon=(); custom_toggle=()
while IFS= read -r line; do
    line="${line%$'\r'}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    IFS='|' read -r c_cmd c_name c_icon c_toggle <<< "$line"
    c_cmd=$(trim "$c_cmd"); c_name=$(trim "$c_name"); c_icon=$(trim "$c_icon"); c_toggle=$(trim "$c_toggle")
    [[ -z "$c_cmd" || -z "$c_name" ]] && continue
    custom_cmd+=("$c_cmd"); custom_name+=("$c_name"); custom_icon+=("$c_icon"); custom_toggle+=("${c_toggle:-0}")
done <<< "$CUSTOM"

# First recognized category key for a "a;b;c" list ("" when none).
first_cat() {
    local IFS=';' tok i
    for tok in $1; do
        tok=$(trim "$tok")
        [[ -z "$tok" ]] && continue
        for i in "${!dict_idx[@]}"; do
            [[ "$tok" == "$i" ]] && { printf '%s' "$i"; return; }
        done
    done
}

# ── Exec tokenization (from cm-launcher) ──
exec_to_argv() {
  local exec="$1" icon_name="$2" app_name="$3" desktop_path="$4"
  local args=() arg="" mode="plain" i ch n
  for ((i=0; i<${#exec}; i++)); do
    ch="${exec:$i:1}"
    if [[ "$ch" == '%' && $((i+1)) -lt ${#exec} ]]; then
      n="${exec:$((i+1)):1}"
      case "$n" in
        %) arg+="%"; i=$((i+1)) ;;
        i)
          if [[ -n "$icon_name" ]]; then
            [[ -n "$arg" ]] && { args+=("$arg"); arg=""; }
            args+=("--icon")
            arg="$icon_name"
          fi
          i=$((i+1)) ;;
        c) arg+="$app_name"; i=$((i+1)) ;;
        k) arg+="$desktop_path"; i=$((i+1)) ;;
        [fFuUdDnNvVm]) i=$((i+1)) ;;
        *) arg+="$ch$n"; i=$((i+1)) ;;
      esac
      continue
    fi
    case "$mode" in
      squote)
        if [[ "$ch" == "'" ]]; then mode="plain"
        else arg+="$ch"; fi
        ;;
      dquote)
        if [[ "$ch" == '"' ]]; then
          mode="plain"
        elif [[ "$ch" == '\' && $((i+1)) -lt ${#exec} ]]; then
          n="${exec:$((i+1)):1}"
          case "$n" in
            '"'|'\') arg+="$n"; i=$((i+1)) ;;
            *) arg+="$ch" ;;
          esac
        else
          arg+="$ch"
        fi
        ;;
      plain)
        if [[ "$ch" == '\' && $((i+1)) -lt ${#exec} ]]; then
          n="${exec:$((i+1)):1}"
          case "$n" in
            s|' ') arg+=" "; i=$((i+1)) ;;
            n) arg+=$'\n'; i=$((i+1)) ;;
            t) arg+=$'\t'; i=$((i+1)) ;;
            '\') arg+='\'; i=$((i+1)) ;;
            '"') arg+='"'; i=$((i+1)) ;;
            *) arg+="$ch$n"; i=$((i+1)) ;;
          esac
        elif [[ "$ch" == '"' ]]; then
          mode="dquote"
        elif [[ "$ch" == "'" ]]; then
          if [[ -z "$arg" ]]; then mode="squote"
          else arg+="$ch"; fi
        elif [[ "$ch" == ' ' ]]; then
          [[ -n "$arg" ]] && args+=("$arg")
          arg=""
        else
          arg+="$ch"
        fi
        ;;
    esac
  done
  [[ -n "$arg" ]] && args+=("$arg")
  [[ ${#args[@]} -gt 0 ]] && printf '%s\0' "${args[@]}"
}

launch_terminal() {
  local term
  term="${TERMINAL:-}"
  [[ -z "$term" ]] && term=$(command -v foot 2>/dev/null || command -v alacritty 2>/dev/null || command -v kitty 2>/dev/null || command -v wezterm 2>/dev/null || command -v gnome-terminal 2>/dev/null || true)
  if [[ -z "$term" ]]; then
    return 1
  fi
  # re-eval env for sway-launched dock (WAYLAND_DISPLAY etc.)
  eval "$(~/.local/bin/config-env 2>/dev/null || true)" || true
  local base
  base=$(basename "$term")
  case "$base" in
    alacritty) setsid "$term" -e "$@" >/dev/null 2>&1 & ;;
    gnome-terminal) setsid "$term" -- "$@" >/dev/null 2>&1 & ;;
    *) setsid "$term" "$@" >/dev/null 2>&1 & ;;
  esac
  disown 2>/dev/null || true
}

tq_icon() {
    tiny-query icon "$1" 2>/dev/null || true
}

# ── Scan apps into category buckets ──
declare -A CAT_PATHS   # key -> newline-separated records path\x1fname\x1ficon\x1fappid
declare -A CAT_COUNT   # key -> number of records

scan_apps() {
    CAT_PATHS=()
    CAT_COUNT=()
    local sep=$'\x1f'
    while IFS="$sep" read -r id path name icon icon_path categories actions; do
        [[ -z "$id" ]] && continue
        local key
        key=$(first_cat "$categories")
        [[ -n "$key" ]] || key="___other___"
        # fallback: if tiny-query didn't resolve icon_path, try raw Icon=
        if [[ -z "$icon_path" && -n "$icon" ]]; then
            icon_path=$(tiny-query icon "$icon" 2>/dev/null || true)
        fi
        # sidecar icon override: foo.desktop.png next to foo.desktop
        [[ -f "$path.png" ]] && icon_path="$path.png"
        local rec="$path"$'\x1f'"$name"$'\x1f'"$icon_path"$'\x1f'"$id"$'\x1f'"$actions"
        CAT_PATHS[$key]+="$rec"$'\n'
        CAT_COUNT[$key]=$(( ${CAT_COUNT[$key]:-0} + 1 ))
    done < <(tiny-query scan 'id|path|name|icon|icon_path|categories|actions' --dir "$PINS_DIR" --sep $'\x1f' 2>/dev/null || true)
}

json_escape() { sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

build_view() {
    kinds=(); paths=(); APP_ACTIONS=()
    : > "$pin_file"
    local i key n icon_path count

    if [[ "$state" == root ]]; then
        for ((i = 0; i < ${#custom_cmd[@]}; i++)); do
            icon_path=$(tq_icon "${custom_icon[i]}")
            if [[ -n "$icon_path" ]]; then
                printf '%s\x1f%s\n' "${custom_name[i]}" "$icon_path" >> "$pin_file"
            else
                printf '%s\n' "${custom_name[i]}" >> "$pin_file"
            fi
            kinds+=("custom:$i"); paths+=("${custom_cmd[i]}"); APP_ACTIONS+=("")
        done

        for ((i = 0; i < ${#dict_cate[@]}; i++)); do
            key="${dict_cate[i]}"
            [[ -n "${CAT_PATHS[$key]:-}" ]] || continue
            count=${CAT_COUNT[$key]}
            icon_path=$(tq_icon "${dict_icon[i]}")
            if [[ -n "$icon_path" ]]; then
                printf '%s (%d)\x1f%s\n' "${dict_label[i]}" "$count" "$icon_path" >> "$pin_file"
            else
                printf '%s (%d)\n' "${dict_label[i]}" "$count" >> "$pin_file"
            fi
            kinds+=("cat:$key"); paths+=(""); APP_ACTIONS+=("")
        done

        if [[ -n "${CAT_PATHS[___other___]:-}" ]]; then
            count=${CAT_COUNT[___other___]}
            icon_path=$(tq_icon "$OTHER_ICON")
            if [[ -n "$icon_path" ]]; then
                printf '%s (%d)\x1f%s\n' "$OTHER_LABEL" "$count" "$icon_path" >> "$pin_file"
            else
                printf '%s (%d)\n' "$OTHER_LABEL" "$count" >> "$pin_file"
            fi
            kinds+=("cat:___other___"); paths+=(""); APP_ACTIONS+=("")
        fi
    elif [[ "$state" == cat:* ]]; then
        key="${state#cat:}"
        icon_path=$(tq_icon "$BACK_ICON")
        if [[ -n "$icon_path" ]]; then
            printf 'Back\x1f%s\n' "$icon_path" >> "$pin_file"
        else
            printf 'Back\n' >> "$pin_file"
        fi
        kinds+=("back"); paths+=(""); APP_ACTIONS+=("")

        while IFS= read -r rec; do
            [[ -z "$rec" ]] && continue
            IFS=$'\x1f' read -r path name ricon rapppid actions <<< "$rec"
            if [[ -n "$ricon" ]]; then
                printf '%s\x1f%s\x1e%s\n' "$name" "$ricon" "$rapppid" >> "$pin_file"
            else
                printf '%s\x1e%s\n' "$name" "$rapppid" >> "$pin_file"
            fi
            APP_ACTIONS+=("$actions")
            kinds+=("app")
            paths+=("$path")
        done <<< "${CAT_PATHS[$key]}"
    elif [[ "$state" == act:* ]]; then
        local parent_path="${state#act:}"
        icon_path=$(tq_icon "$BACK_ICON")
        if [[ -n "$icon_path" ]]; then
            printf 'Back\x1f%s\n' "$icon_path" >> "$pin_file"
        else
            printf 'Back\n' >> "$pin_file"
        fi
        kinds+=("back"); paths+=(""); APP_ACTIONS+=("")
        local p_info p_name p_icon
        p_info=$(tiny-query desktop "$parent_path" 'name|icon' --sep $'\x1f' 2>/dev/null || echo -e "|\x1f")
        IFS=$'\x1f' read -r p_name p_icon <<< "$p_info"
        [[ -z "$p_name" ]] && p_name=$(basename "$parent_path" .desktop)
        local p_icon_path=""
        [[ -n "$p_icon" ]] && p_icon_path=$(tq_icon "$p_icon")
        if [[ -n "$p_icon_path" ]]; then
            printf 'Launch %s\x1f%s\n' "$p_name" "$p_icon_path" >> "$pin_file"
        else
            printf 'Launch %s\n' "$p_name" >> "$pin_file"
        fi
        kinds+=("launch-act"); paths+=("$parent_path"); APP_ACTIONS+=("")
        
        while IFS=$'\x1f' read -r a_id a_name a_exec a_icon a_terminal a_icon_path; do
            [[ -z "$a_exec" ]] && continue
            [[ -z "$a_name" ]] && a_name="$a_id"
            [[ -z "$a_icon" ]] && a_icon="$p_icon"
            if [[ -z "$a_icon_path" && -n "$a_icon" ]]; then
                a_icon_path=$(tq_icon "$a_icon")
            fi
            local thumb=""
            if [[ -n "$a_icon_path" ]]; then
                thumb="$a_name"$'\x1f'"$a_icon_path"
            elif [[ -n "$a_icon" ]]; then
                local ico2
                ico2=$(tq_icon "$a_icon")
                [[ -n "$ico2" ]] && thumb="$a_name"$'\x1f'"$ico2"
            fi
            printf '%s\n' "${thumb:-$a_name}" >> "$pin_file"
            kinds+=("action:$a_id")
            paths+=("$parent_path")
            APP_ACTIONS+=("")
        done < <(tiny-query action "$parent_path" --all 'id|name|exec|icon|terminal|icon_path' --sep $'\x1f' 2>/dev/null || true)
    fi  
}

handle_sel() {
    [[ "$1" =~ ^[0-9]+$ ]] || return 0
    local idx=$1 kind
    kind="${kinds[$idx]:-}"
    case "$kind" in
        back)
            if [[ "$state" == act:* ]]; then
                state="$PREV_STATE"
            else
                state="root"
            fi
            TRANSITION=1
            ;;
        cat:*)     PREV_STATE="$state"; state="$kind"; TRANSITION=1 ;;
        custom:*)
            local c_idx="${kind#custom:}"
            local c_cmd="${custom_cmd[$c_idx]:-}"
            if [[ -z "$c_cmd" ]]; then
                :
            elif [[ "${custom_toggle[$c_idx]:-0}" == "1" ]]; then
                if pgrep -f -- "$c_cmd" >/dev/null 2>&1; then
                    pkill -f -- "$c_cmd" 2>/dev/null || true
                else
                    setsid bash -c "exec $c_cmd" >/dev/null 2>&1 &
                fi
            else
                setsid bash -c "exec $c_cmd" >/dev/null 2>&1 &
            fi
            ;;
        app)
            local actions="${APP_ACTIONS[$idx]:-}"
            if [[ -n "$actions" ]]; then
                PREV_STATE="$state"
                state="act:${paths[$idx]}"
                TRANSITION=1
            else
                launch "${paths[$idx]}"
            fi
            ;;
        launch-act)
            launch "${paths[$idx]}"
            ;;
        action:*)
            local action_id="${kind#action:}"
            launch_action "${paths[$idx]}" "$action_id"
            ;;
    esac
}

launch_action() {
    local desktop_path="$1" action_id="$2"
    local out
    out=$(tiny-query action "$desktop_path" "$action_id" 'name|exec|icon|terminal|path' --sep $'\x1f' 2>/dev/null) || return 1
    local name exec icon terminal path
    IFS=$'\x1f' read -r name exec icon terminal path <<< "$out"
    [[ -z "$exec" ]] && return 1
    [[ -z "$name" ]] && name="$action_id"
    local args=()
    while IFS='' read -r -d '' arg; do args+=("$arg"); done < <(exec_to_argv "$exec" "$icon" "$name" "$desktop_path")
    [[ ${#args[@]} -gt 0 ]] || return 1
    eval "$(~/.local/bin/config-env 2>/dev/null || true)" || true
    if [[ "$terminal" == "1" || "${terminal,,}" == "true" ]]; then
        launch_terminal "${args[@]}"
    else
        setsid "${args[@]}" >/dev/null 2>&1 & disown 2>/dev/null || true
    fi
    # always exit dock after launching (like cm-launcher)
    kill "$spid" 2>/dev/null || true
    wait "$spid" 2>/dev/null || true
    rm -rf "$work" 2>/dev/null || true
    exit 0
}

launch() {
    local target="$1"
    local out
    out=$(tiny-query desktop "$target" 'name|exec|icon|terminal|path' --sep $'\x1f' 2>/dev/null) || {
        notify-send "ts-dock" "No .desktop file for $target" 2>/dev/null
        return 1
    }
    local name exec icon terminal path
    IFS=$'\x1f' read -r name exec icon terminal path <<< "$out"

    local args=()
    while IFS='' read -r -d '' arg; do args+=("$arg"); done \
        < <(exec_to_argv "$exec" "$icon" "$name" "$path")
    [[ ${#args[@]} -gt 0 ]] || return 1

    eval "$(~/.local/bin/config-env 2>/dev/null || true)" || true
    if [[ "$terminal" == "1" || "${terminal,,}" == "true" ]]; then
        launch_terminal "${args[@]}"
    else
        setsid "${args[@]}" >/dev/null 2>&1 & disown 2>/dev/null || true
    fi
    kill "$spid" 2>/dev/null || true
    wait "$spid" 2>/dev/null || true
    rm -rf "$work" 2>/dev/null || true
    exit 0
}

# ── main state machine ──
PINS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
[[ -d "$PINS_DIR" ]] || exit 0

work=$(mktemp -d)
trap '[[ -f "$PIDFILE" && "$(cat "$PIDFILE" 2>/dev/null || true)" == "$MYPID" ]] && rm -f "$PIDFILE"; rm -rf "$work"' EXIT

state="root"
TRANSITION=0
while :; do
    scan_apps
    pin_file="$work/pins"
    build_view
    if (( ${#kinds[@]} == 0 )); then
        exit 0          # nothing to show at all: quiet exit, no retrying
    fi

    rm -f "$work/cmd"
    fifo="$work/sel"
    mkfifo "$fifo"
    if [[ "$state" == root ]]; then
        exec -a ts-dock "$STRIP" --dock "${STRIP_OUTPUT_ARGS[@]}" "${STRIP_ACTIVE_ARGS[@]}" --oneshot --format i < "$pin_file" > "$fifo" &
    else
        exec -a ts-dock "$STRIP" --oneshot --format i < "$pin_file" > "$fifo" &
    fi
    spid=$!

    TRANSITION=0
    while IFS= read -r sel; do
        handle_sel "$sel"
        (( TRANSITION )) && break
    done < "$fifo"
    kill "$spid" 2>/dev/null || true
    wait "$spid" 2>/dev/null || true
    rm -f "$fifo"

    (( TRANSITION )) || break    # dock died externally: follow it out
done
