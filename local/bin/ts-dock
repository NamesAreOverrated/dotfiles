#!/usr/bin/env bash
# ts-dock — auto-categorized dock helper for tiny-strip.
#
# Sources apps from ~/.local/share/applications, groups them by their
# Categories= key according to DICT below (first match in an app's list
# wins; unmatched apps land in an auto "Other" group), renders the root
# dock as [launcher][category folders...][Other] with item counts in the
# tooltips, and swaps to a per-category subdock (return cell on top) when
# a folder is clicked. App picks launch via cm-launcher semantics.
set -uo pipefail

source "${HOME}/.local/bin/cm-launcher"

STRIP="${TINY_STRIP_BIN:-tiny-strip}"
LAUNCHER_ICON="start-here"
OTHER_ICON="applications-other"
BACK_ICON="go-previous"
OTHER_LABEL="Other"

# ── Category dictionary — RawCategory:Label:ThemeIconName ──
# Edit to add/remove recognizers; first match in an app's Categories= wins.
DICT='Network:Internet:web-browser
AudioVideo:Media:applications-multimedia
Game:Games:applications-games
Development:Development:applications-development
Graphics:Graphics:applications-graphics
Office:Office:applications-office
Utility:Utilities:applications-accessories
System:System:applications-system
Distrobox:Distrobox:distrobox'

# ── Parse dict ──
dict_cate=(); dict_label=(); dict_icon=()
declare -A dict_idx=()
while IFS= read -r line; do
    line="${line%$'\r'}"
    [[ -z "$line" || "$line" == \#* || "$line" != *:*:* ]] && continue
    cate="${line%%:*}"; rest="${line#*:}"
    label="${rest%%:*}"; icon="${rest#*:}"
    [[ -n "$cate" && -n "$label" && -z "${dict_idx[$cate]:-}" ]] || continue
    dict_idx["$cate"]=${#dict_cate[@]}
    dict_cate+=("$cate"); dict_label+=("$label"); dict_icon+=("$icon")
done <<< "$DICT"

trim() { local s="$1"; s="${s#"${s%%[![:space:]]*}"}"; s="${s%"${s##*[![:space:]]}"}"; printf '%s' "$s"; }

# First recognized category key for a "a;b;c" list ("" when none).
first_cat() {
    local IFS=';' tok i
    for tok in $1; do
        tok=$(trim "$tok")
        [[ -z "$tok" ]] && continue
        for i in "${!dict_idx[@]}"; do
            [[ "$tok" == "$i" ]] && { printf '%s' "$i"; return; }
        done
    done
}

# resolve_icon only searches apps/; extend to actions/, panel/, etc.
# Runs its own theme-dir walk: resolve_icon builds its cache in a
# command-substitution subshell, and cm-launcher's get_theme_dirs has a
# one-shot _PROCESSED_THEMES guard — so we reset it and walk fresh.
any_icon() {
    local p
    p=$(resolve_icon "$1" 2>/dev/null || true)
    [[ -n "$p" ]] && { printf '%s' "$p"; return; }

    local dirs=() td sub ext s
    local sizes="512 256 128 96 64 48 32 24 22 16"
    _PROCESSED_THEMES=""
    while IFS= read -r td; do
        [[ -n "$td" ]] && dirs+=("$td")
    done < <(get_theme_dirs "$(get_icon_theme)" | sort -u)

    for td in ${dirs[@]+"${dirs[@]}"}; do
        for sub in apps actions panel categories status devices places emblems legacy/apps; do
            for ext in svg png; do
                p="$td/scalable/$sub/$1.$ext"
                [[ -f "$p" ]] && { printf '%s' "$p"; return; }
                for s in $sizes; do
                    p="$td/${s}x${s}/$sub/$1.$ext"
                    [[ -f "$p" ]] && { printf '%s' "$p"; return; }
                done
            done
        done
    done
}

# ── Scan apps into category buckets ──
declare -A CAT_PATHS   # key -> newline-separated records path\x1fname\x1ficon\x1fappid
declare -A CAT_COUNT   # key -> number of records

scan_apps() {
    CAT_PATHS=()
    CAT_COUNT=()
    shopt -s nullglob
    for file in "$PINS_DIR"/*.desktop; do
        local parsed path tail name exec_ icon categories key rec appid ipath
        parsed=$(parse_desktop "$file") || continue
        path="${parsed%%|*}"; tail="${parsed#*|}"
        name="${tail%%|*}"; tail="${tail#*|}"
        _="${tail%%|*}"; tail="${tail#*|}"          # exec (unused)
        icon="${tail%%|*}"

        categories=$(sed -n '/^Categories=/{s/^Categories=//p;q}' "$file")
        key=$(first_cat "$categories")
        [[ -n "$key" ]] || key="@other@"

        # sidecar icon override: foo.desktop.png next to foo.desktop
        ipath=""
        [[ -f "$file.png" ]] && ipath="$file.png"
        if [[ -z "$ipath" && -n "$icon" ]]; then
            ipath=$(resolve_icon "$icon" 2>/dev/null || true)
        fi

        appid=$(basename "$file" .desktop)
        rec="$path"$'\x1f'"$name"$'\x1f'"$ipath"$'\x1f'"$appid"
        CAT_PATHS[$key]+="$rec"$'\n'
        CAT_COUNT[$key]=$(( ${CAT_COUNT[$key]:-0} + 1 ))
    done
}

json_escape() { sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

emit_app_line() {  # $1=name $2=resolved-icon-path $3=appid
    if [[ -n "$2" ]]; then
        printf '%s\x1f%s\x1e%s\n' "$(printf '%s' "$1" | json_escape)" \
            "$(printf '%s' "$2" | json_escape)" "$(printf '%s' "$3" | json_escape)"
    else
        printf '%s\x1e%s\n' "$(printf '%s' "$1" | json_escape)" "$(printf '%s' "$3" | json_escape)"
    fi
}

build_view() {
    kinds=(); paths=()
    : > "$pin_file"
    local i key n icon_path count

    if [[ "$state" == root ]]; then
        icon_path=$(any_icon "$LAUNCHER_ICON")
        if [[ -n "$icon_path" ]]; then
            printf 'Apps\x1f%s\n' "$icon_path" >> "$pin_file"
        else
            printf 'Apps\n' >> "$pin_file"
        fi
        kinds+=("launcher")

        for ((i = 0; i < ${#dict_cate[@]}; i++)); do
            key="${dict_cate[i]}"
            [[ -n "${CAT_PATHS[$key]:-}" ]] || continue
            count=${CAT_COUNT[$key]}
            icon_path=$(any_icon "${dict_icon[i]}")
            if [[ -n "$icon_path" ]]; then
                printf '%s (%d)\x1f%s\n' "${dict_label[i]}" "$count" "$icon_path" >> "$pin_file"
            else
                printf '%s (%d)\n' "${dict_label[i]}" "$count" >> "$pin_file"
            fi
            kinds+=("cat:$key")
        done

        if [[ -n "${CAT_PATHS[@other@]:-}" ]]; then
            count=${CAT_COUNT[@other@]}
            icon_path=$(any_icon "$OTHER_ICON")
            if [[ -n "$icon_path" ]]; then
                printf '%s (%d)\x1f%s\n' "$OTHER_LABEL" "$count" "$icon_path" >> "$pin_file"
            else
                printf '%s (%d)\n' "$OTHER_LABEL" "$count" >> "$pin_file"
            fi
            kinds+=("cat:@other@")
        fi
    else
        key="${state#cat:}"
        icon_path=$(any_icon "$BACK_ICON")
        if [[ -n "$icon_path" ]]; then
            printf 'Back\x1f%s\n' "$icon_path" >> "$pin_file"
        else
            printf 'Back\n' >> "$pin_file"
        fi
        kinds+=("back")

        while IFS= read -r rec; do
            [[ -z "$rec" ]] && continue
            path="${rec%%$'\x1f'*}"; rec="${rec#*$'\x1f'}"
            name="${rec%%$'\x1f'*}"; rec="${rec#*$'\x1f'}"
            ricon="${rec%%$'\x1f'*}"; rapppid="${rec#*$'\x1f'}"

            if [[ -n "$ricon" ]]; then
                printf '%s\x1f%s\x1e%s\n' "$name" "$ricon" "$rapppid" >> "$pin_file"
            else
                printf '%s\x1e%s\n' "$name" "$rapppid" >> "$pin_file"
            fi
            kinds+=("app")
            paths+=("$path")
        done <<< "${CAT_PATHS[$key]}"
    fi
}

handle_sel() {
    [[ "$1" =~ ^[0-9]+$ ]] || return 0
    local idx=$1 kind
    kind="${kinds[$idx]:-}"
    case "$kind" in
        back)      state="root";      TRANSITION=1 ;;
        cat:*)     state="$kind";     TRANSITION=1 ;;
        launcher)  setsid cm-launcher >/dev/null 2>&1 & ;;
        app)       launch "${paths[$idx]}" ;;
    esac
}

launch() {
    local target="$1"
    local desktop="$target"
    if [[ "$target" != */* ]]; then
        desktop=""
        while IFS='' read -r dir; do
            if [[ -f "$dir/$target.desktop" ]]; then desktop="$dir/$target.desktop"; break; fi
        done < <(get_local_app_dirs; get_system_app_dirs)
    fi
    [[ -n "$desktop" ]] || {
        notify-send "ts-dock" "No .desktop file for $target" 2>/dev/null
        return 1
    }

    local parsed path tail name exec_ icon_name terminal args=()
    parsed=$(parse_desktop "$desktop") || return 1
    path="${parsed%%|*}"; tail="${parsed#*|}"
    name="${tail%%|*}"; tail="${tail#*|}"
    exec_="${tail%%|*}"; tail="${tail#*|}"
    icon_name="${tail%%|*}"; tail="${tail#*|}"
    terminal="${tail%%|*}"

    while IFS='' read -r -d '' arg; do args+=("$arg"); done \
        < <(exec_to_argv "$exec_" "$icon_name" "$name" "$path")
    [[ ${#args[@]} -gt 0 ]] || return 1

    if [[ "${terminal,,}" == "true" ]]; then
        launch_terminal "${args[@]}" &
    else
        "${args[@]}" &
    fi
}

# ── main state machine ──
command -v "$STRIP" >/dev/null 2>&1 || {
    echo "ts-dock: $STRIP not found in PATH" >&2
    exit 1
}

PINS_DIR="$(get_local_app_dirs | head -1)"
[[ -d "$PINS_DIR" ]] || exit 0

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

state="root"
TRANSITION=0
while :; do
    scan_apps
    pin_file="$work/pins"
    build_view
    if (( ${#kinds[@]} == 0 )); then
        exit 0          # nothing to show at all: quiet exit, no retrying
    fi

    rm -f "$work/cmd"
    fifo="$work/sel"
    mkfifo "$fifo"
    "$STRIP" --dock --format i < "$pin_file" > "$fifo" &
    spid=$!

    TRANSITION=0
    while IFS= read -r sel; do
        handle_sel "$sel"
        (( TRANSITION )) && break
    done < "$fifo"
    kill "$spid" 2>/dev/null || true
    wait "$spid" 2>/dev/null || true
    rm -f "$fifo"

    (( TRANSITION )) || break    # dock died externally: follow it out
done
