#!/usr/bin/env bash
# env — emit environment vars for bash or fish
set -u

MODE="bash"
[ "${1:-}" = "--fish" ] && MODE="fish"

# ── Persistent overrides ──
[ -f "$HOME/.config/env" ] && . "$HOME/.config/env"

# ── Defaults ──
TERMINAL="${TERMINAL:-foot}"
EDITOR="${EDITOR:-nvim}"
SUDO_EDITOR="${SUDO_EDITOR:-nvim}"

# ── Path guard ──
path_line() {
  if [ "$MODE" = "fish" ]; then
    echo 'if not contains "$HOME/.local/bin" $PATH; set -gx PATH "$HOME/.local/bin" $PATH; end'
  else
    echo 'case ":$PATH:" in *:"$HOME/.local/bin":*) ;; *) export PATH="$HOME/.local/bin:$PATH" ;; esac'
  fi
}

# ── Proxy ──
proxy_lines() {
  local cfg="$HOME/.config/cm-network"
  # Always unset proxy vars first, even if config is missing
  if [ "$MODE" = "fish" ]; then
    cat << FISH
set -e http_proxy; set -e https_proxy; set -e HTTP_PROXY; set -e HTTPS_PROXY
set -e all_proxy; set -e ALL_PROXY
FISH
  else
    cat << UNSET
unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY all_proxy ALL_PROXY
UNSET
  fi
  # no_proxy is always exported: inert without proxy vars, and it keeps
  # localhost/intranet traffic off the proxy as soon as the proxy turns on
  local no_proxy="localhost,127.0.0.1,::1,.163.com,.music.126.net"
  if [ -f "$cfg" ]; then
    local no_proxy_val
    no_proxy_val=$(sed -n '3p' "$cfg")
    [ -n "$no_proxy_val" ] && no_proxy="$no_proxy_val"
  fi
  if [ "$MODE" = "fish" ]; then
    cat << FISH
set -gx no_proxy "$no_proxy"
set -gx NO_PROXY "$no_proxy"
FISH
  else
    cat << BASH
export no_proxy="$no_proxy"
export NO_PROXY="$no_proxy"
BASH
  fi
  [ -f "$cfg" ] || return
  local host
  host=$(sed -n '1p' "$cfg")
  [ -z "$host" ] && return
  # Only export proxy vars if state is 1
  [ "$(sed -n '2p' "$cfg")" = "1" ] || return
  if [ "$MODE" = "fish" ]; then
    cat << FISH
set -gx http_proxy "http://$host"
set -gx https_proxy "http://$host"
set -gx HTTP_PROXY "http://$host"
set -gx HTTPS_PROXY "http://$host"
set -gx all_proxy "socks5://$host"
set -gx ALL_PROXY "socks5://$host"
FISH
  else
    cat << BASH
export http_proxy="http://$host"
export https_proxy="http://$host"
export HTTP_PROXY="http://$host"
export HTTPS_PROXY="http://$host"
export all_proxy="socks5://$host"
export ALL_PROXY="socks5://$host"
BASH
  fi
}

# ── Main ──
if [ "$MODE" = "fish" ]; then
  echo "set -gx TERMINAL \"$TERMINAL\""
  echo "set -gx EDITOR \"$EDITOR\""
  echo "set -gx SUDO_EDITOR \"$SUDO_EDITOR\""

  echo "set -gx QT_QPA_PLATFORMTHEME qt5ct"
  echo "set -gx QT_STYLE_OVERRIDE Fusion"
else
  echo "export TERMINAL=\"$TERMINAL\""
  echo "export EDITOR=\"$EDITOR\""
  echo "export SUDO_EDITOR=\"$SUDO_EDITOR\""

  echo "export QT_QPA_PLATFORMTHEME=qt5ct"
  echo "export QT_STYLE_OVERRIDE=Fusion"
fi
path_line
proxy_lines
